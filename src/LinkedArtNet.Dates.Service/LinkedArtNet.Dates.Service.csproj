<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>LinkedArtNet.Dates.Service</RootNamespace>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UserSecretsId>linked-art-net-dates-service</UserSecretsId>
    <Description>HTTP service wrapping LinkedArtNet.Dates: free-text date strings to Linked Art TimeSpans.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.18.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LinkedArtNet.Dates\LinkedArtNet.Dates.csproj" />
    <ProjectReference Include="..\LinkedArtNet.Agents\LinkedArtNet.Agents.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LinkedArtNet.Dates.Service.Tests" />
  </ItemGroup>

</Project>
