@page "/p/{dataset}/checks"
@model ChecksModel
@{
    ViewData["Title"] = "Checks";
    var likely = Model.Away.Where(a => a.Likely).ToList();
    var look = Model.Away.Where(a => !a.Likely && a.Row.ItemDescription is not null).ToList();
    var unknown = Model.Away.Where(a => !a.Likely && a.Row.ItemDescription is null).ToList(); // one a string speaks for is among the likely, not here too
    // the place by its own name and then where it is (the owner, 2026-11-15, at "Glencoe": "why does this not say Glencoe?"; only the
    // chain of its parents was shown). A place in a district of its own name ("Cardiff" in Cardiff, Wales) is not named twice
    string Chain(string label, string chain)
    {
        var parts = chain.Split(',').Select(x => x.Trim()).Where(x => x is not ("Europe" or "World") && x.Length > 0).ToList();
        return string.Join(", ", parts.Count > 0 && string.Equals(parts[0], label, StringComparison.OrdinalIgnoreCase) ? parts : parts.Prepend(label));
    }
}
<h1>Checks</h1>
<p class="muted">Lists of the project's own entities that a test finds doubtful. "Decide…" on a row shows the records its strings are in and what can be done: keep it as the <strong>right place</strong> (with a clearer label if you give one; a confirmed entity leaves the list), mend it as the <strong>wrong place</strong>, or move only <strong>some of its strings</strong>. Nothing is changed until you choose there. The entity's name opens its page, for anything else.</p>

@if (Model.Message is not null) { <p class="notice">@Model.Message @if (Model.MessageEntity is { } done) { <a href="/p/@Model.Dataset/entity?id=@Uri.EscapeDataString(done.Id)">Open @done.Label</a> }</p> }
@if (Model.Plan is { } plan)
{
    var pe = plan.Entity;
    <div class="card">
        <h2 style="margin-top:0">Decide "@pe.Label"</h2>
        <p class="small muted">Nothing is changed until you press one of the buttons below: Confirm, Mend or Move. <a href="/p/@Model.Dataset/entity?id=@Uri.EscapeDataString(pe.Id)" target="_blank" rel="noopener">Open the entity's page</a> to see its strings and records first. It stands for @plan.Homes[0].Strings string@(plan.Homes[0].Strings == 1 ? "" : "s").</p>
        @if (Model.Pulled is not null) { <p class="notice small">@Model.Pulled</p> }
        @* what the item says, set beside the place at home for the person (seen as a user, 2026-11-17: "town in Bedfordshire" and "Biggleswade, Bedfordshire, England" had to be compared by eye) *@
        @if (plan.Meant is not null && plan.Homes.FirstOrDefault(h => h.HomeUri == plan.Meant) is { } meant && plan.Homes.FirstOrDefault(h => h.HomeUri == plan.Agreeing) is { } itemIs)
        {
            @* two places of the name (seen as a user at "Bridgend": the import's item a hamlet in Aberdeenshire, the entity's TGN identifier and its records Welsh) *@
            <p class="notice small"><strong>Two different places.</strong> The import's Wikidata item says it is: <strong>@itemIs.ItemDescription</strong>, which is @Chain(itemIs.Label, itemIs.HomeChain). But @(meant.Holds ? "this entity also holds the TGN identifier of" : "its strings say") <strong>@Chain(meant.Label, meant.HomeChain)</strong>. One of them is wrong, and the records below say which. If they are of @Chain(meant.Label, meant.HomeChain), mend it: the import's identifiers are ticked for removal@(meant.Holds ? ", and nothing need be added" : "").</p>
        }
        else if (plan.Homes.FirstOrDefault(h => h.HomeUri == plan.Agreeing) is { } same)
        {
            <p class="notice small"><strong>Probably right.</strong> What the Wikidata item says of itself (@(same.ItemDescription ?? "it is the same item as the place at home's")) agrees with <strong>@Chain(same.Label, same.HomeChain)</strong>, the place of this name at home. If the records below agree too, keep it.</p>
        }
        else if (plan.Homes[0].ItemDescription is { } says)
        {
            <p class="notice small">The Wikidata item says it is: <strong>@says</strong>. That names none of the places called "@pe.Label" at home; the records below say which is meant.</p>
        }
        <h3>What the records say</h3>
        @if (Model.PlanStrings.Count == 0) { <p class="small muted">No string stands on this entity.</p> }
        @foreach (var (ps, recs, count) in Model.PlanStrings)
        {
            @if (Model.PlanStrings.Count > 1) { <p class="small" style="margin-bottom:0"><label style="margin:0; color:inherit; font-size:inherit"><input type="checkbox" name="strings" value="@ps.Id" form="mend-form" /> move this string (for "Move only the ticked strings" at the foot)</label></p> }
            else { <input type="hidden" name="strings" value="@ps.Id" form="mend-form" /> }
            <details class="rec-group" open><summary class="small"><strong>"@ps.Raw"</strong> <span class="muted">as @Model.Project.Manifest.FieldName(ps.Context) · in @count.ToString("N0") record@(count == 1 ? "" : "s")</span> <a href="/p/@Model.Dataset/review?id=@ps.Id" target="_blank" rel="noopener">at the desk</a></summary>
                @foreach (var x in recs)
                {
                    <p class="small"><strong>@(x.Title ?? "(no title)")</strong>@(x.Date is null ? "" : $" ({x.Date})") <span class="muted">· @x.RecordId</span>
                    @foreach (var (name, values) in x.NamingFields()) { <br /><span class="muted">@name:</span> @string.Join(" · ", values) }
                    </p>
                }
                @if (count > recs.Count) { <p class="small muted">and @((count - recs.Count).ToString("N0")) more</p> }
            </details>
        }
        <h2>It is the right place: keep it</h2>
        @{
            var holdsTgn = pe.Equivalents.Any(q => q.Source == "tgn");
            var agreed = plan.Meant is null ? plan.Homes.FirstOrDefault(h => h.HomeUri == plan.Agreeing) : null;
            var qualify = plan.Rival is not null;
            var loc = Model.SuggestedLabel;
        }
        <form method="post" asp-page-handler="Relabel">
            <input type="hidden" name="id" value="@pe.Id" />
            @* which label (the owner, 2026-11-17): a place at home usually needs no qualifier, and does when a better-known place
               elsewhere has the name ("Boston" is taken for Massachusetts, not Lincolnshire). The choices are there to pick, not to type *@
            <p class="small" style="margin-bottom:.3rem"><strong>Its label</strong> <span class="muted">· @(qualify
                ? $"a qualifier is suggested: the name alone would be taken for a better-known \u201c{pe.Label}\u201d ({plan.Rival!.Value.Description ?? "no description"}; written about in {plan.Rival.Value.Sitelinks})"
                : "the name as it is is suggested: the index knows no better-known place called this, so it needs no qualifier")</span></p>
            <p class="small" style="margin:.2rem 0"><label style="margin:0; color:inherit; font-size:inherit"><input type="radio" name="label" value="@pe.Label" @(!qualify || loc is null ? "checked" : "") /> <strong>@pe.Label</strong> <span class="muted">· as it is</span></label></p>
            @if (loc is not null)
            {
                <p class="small" style="margin:.2rem 0"><label style="margin:0; color:inherit; font-size:inherit"><input type="radio" name="label" value="@loc" @(qualify ? "checked" : "") /> <strong>@loc</strong> <span class="muted">· the Library of Congress heading this entity holds</span></label></p>
            }
            <p class="small" style="margin:.2rem 0"><label style="margin:0; color:inherit; font-size:inherit"><input type="radio" name="label" value="" /> another:</label> <input type="text" name="other" placeholder="@pe.Label (…)" style="width:18rem; display:inline-block" /></p>
            @if (!holdsTgn)
            {
                @* right, and without the identifier of the place it is (seen as a user at "Blickling") *@
                var offer = agreed ?? (plan.Homes.Count == 1 ? plan.Homes[0] : null);
                if (offer is not null)
                {
                    <p class="small" style="margin:.6rem 0 .2rem"><label style="margin:0; color:inherit; font-size:inherit"><input type="checkbox" name="addUri" value="@offer.HomeUri" @(agreed is not null ? "checked" : "") /> also add the identifier of <strong>@Chain(offer.Label, offer.HomeChain)</strong> (<a href="@offer.HomeUri" target="_blank" rel="noopener">TGN @offer.HomeUri.Split('/')[^1]</a>): this entity has no TGN identifier@(agreed is null ? "; tick it if the records say this is the place" : "")</label></p>
                }
            }
            <div class="actions"><button type="submit">Confirm</button></div>
        </form>
        <p class="small muted">The entity is confirmed with the label chosen and leaves the list. Nothing is removed from it; its strings are as they were.</p>
        <h2>It is the wrong place, or wrong for some of its strings: mend it</h2>
        <form method="post" asp-page-handler="Mend" id="mend-form">
            <input type="hidden" name="id" value="@pe.Id" />
            <h3>1. Remove these identifiers</h3>
            <p class="small muted">The import's identifiers are ticked: they usually describe the same wrong place. One a rule or a person added since is left unticked, as it may be right for the place meant. Change either as you judge.</p>
            @foreach (var q in pe.Equivalents)
            {
                <p class="small"><label style="margin:0; color:inherit; font-size:inherit"><input type="checkbox" name="remove" value="@q.Uri" @(q.Method.StartsWith("imported", StringComparison.Ordinal) || q.Method.StartsWith("through", StringComparison.Ordinal) ? "checked" : "") /> <span class="tag">@q.Source</span> <a href="@q.Uri" target="_blank" rel="noopener">@q.Uri</a> <span class="muted">· @q.Method@(q.Uri == plan.Homes[0].Item ? " · " + (plan.Homes[0].ItemDescription ?? "not in the local index") : "")</span></label></p>
            }
            <h3>2. The place meant</h3>
            @if (plan.Homes.Count > 1 || plan.Others.Count > 0) { <p class="small muted">Choose one: with several to choose among, none is chosen for you. The records above say which.</p> }
            @foreach (var h in plan.Homes)
            {
                var holder = plan.Holders.GetValueOrDefault(h.HomeUri);
                <p class="small"><label style="margin:0; color:inherit; font-size:inherit"><input type="radio" name="home" value="@h.HomeUri" @((plan.Homes.Count == 1 && plan.Others.Count == 0 && Model.Found.Count == 0) || h.HomeUri == plan.Meant ? "checked" : "") /> <strong>@Chain(h.Label, h.HomeChain)</strong> <a href="@h.HomeUri" target="_blank" rel="noopener">TGN @h.HomeUri.Split('/')[^1]</a> <span class="muted">· @(h.HomeItem is null ? "no count known" : $"written about in {h.HomeSitelinks}")</span></label><br />
                @if (pe.Equivalents.Any(q => q.Uri == h.HomeUri)) { <span>This entity holds this identifier already: nothing is added for it.</span> }
                else if (holder is not null) { <span>The project already has an entity for this place, <a href="/p/@Model.Dataset/entity?id=@Uri.EscapeDataString(holder.Id)" target="_blank" rel="noopener">@holder.Label</a>: "@pe.Label" is <strong>merged into it</strong>, and its strings follow.</span> }
                else { <span>No entity of the project holds this place: the identifier is <strong>added to "@pe.Label"</strong>.</span> }</p>
            }
            @* the place meant may not be at home (the owner, 2026-11-15, at "Raleigh", meant for North Carolina): the project's other entities of the name, and any other place *@
            @foreach (var other in plan.Others)
            {
                var clue = Model.Clues.GetValueOrDefault(other.Id);
                <p class="small"><label style="margin:0; color:inherit; font-size:inherit"><input type="radio" name="home" value="entity:@other.Id" /> <strong>@other.Label</strong>@if (clue.Placement is not null) { <span> (@clue.Placement)</span> } <span class="muted">· the project's entity · @string.Join(" ", other.Equivalents.Select(q => q.Source)) · stands for @clue.Strings string@(clue.Strings == 1 ? "" : "s")</span></label> <a href="/p/@Model.Dataset/entity?id=@Uri.EscapeDataString(other.Id)" target="_blank" rel="noopener">open</a><br />
                <span>"@pe.Label" is <strong>merged into it</strong>, and its strings follow.</span></p>
            }
            @* a place the project knows by another name ("Bâle" is its "Basel"): searched for, and its results offered like the others. The
               search's fields belong to a form of their own below (the form attribute): a form inside a form is dropped by the browser *@
            <p class="small"><strong>A place the project has under another name:</strong> <input type="search" name="find" form="mend-find" value="@Model.Find" placeholder="Basel" style="width:16rem; display:inline-block" /> <button type="submit" form="mend-find" class="secondary">Search the project's places</button> <span class="muted">(the ticks above return to how they were)</span></p>
            @if (!string.IsNullOrWhiteSpace(Model.Find) && Model.Found.Count == 0) { <p class="small muted">No other place of the project matches "@Model.Find".</p> }
            @foreach (var other in Model.Found)
            {
                var clue = Model.Clues.GetValueOrDefault(other.Id);
                <p class="small"><label style="margin:0; color:inherit; font-size:inherit"><input type="radio" name="home" value="entity:@other.Id" /> <strong>@other.Label</strong>@if (clue.Placement is not null) { <span> (@clue.Placement)</span> } <span class="muted">· the project's entity · @other.Status.ToString().ToLowerInvariant() · @string.Join(" ", other.Equivalents.Select(q => q.Source)) · stands for @clue.Strings string@(clue.Strings == 1 ? "" : "s")</span></label> <a href="/p/@Model.Dataset/entity?id=@Uri.EscapeDataString(other.Id)" target="_blank" rel="noopener">open</a><br />
                <span>"@pe.Label" is <strong>merged into it</strong>, and its strings follow.</span></p>
            }
            <p class="small"><label style="margin:0; color:inherit; font-size:inherit"><input type="radio" name="home" value="other" /> <strong>Another place</strong>, by its identifier:</label> <input type="text" name="otherUri" placeholder="http://vocab.getty.edu/tgn/..." style="width:24rem; display:inline-block" /><br />
            <span>If an entity of the project holds it, "@pe.Label" is merged into that; if none does, the identifier is added to "@pe.Label".</span></p>
            <div class="actions"><button type="submit" name="act" value="mend">Mend the whole entity</button>
                @if (Model.PlanStrings.Count > 1) { <button type="submit" name="act" value="move" class="secondary" title="The entity is right for some of its strings: the ticked strings are decided onto the place meant, and this entity and its identifiers are left as they are">Move only the ticked strings</button> }
                <a href="/p/@Model.Dataset/checks">Back to the list, nothing changed</a></div>
            @if (Model.PlanStrings.Count > 1) { <p class="small muted"><strong>Mend the whole entity</strong> when it is wrong for all its strings: the ticked identifiers go, and it is merged into or given the place meant. <strong>Move only the ticked strings</strong> when it is right for some ("Peterborough, Ontario") and wrong for others (a bare "Peterborough" of English imprints): tick those strings under "What the records say"; nothing is removed from this entity.</p> }
        </form>
        <form id="mend-find" method="get"><input type="hidden" name="mend" value="@pe.Id" /></form>
    </div>
}
else
{
<h2>Places the import aligned to a namesake <span class="muted small">@Model.Away.Count</span></h2>
@if (Model.HomePlace is null)
{
    <p class="notice">This project has no home place in its manifest, so there is no "at home" to compare with.</p>
}
else
{
    <p class="small muted">A place whose name has no qualifier ("Glasgow"), whose Wikidata identifier came from an import, where a place of exactly that name stands in @Model.HomePlace and the Wikidata item's own description names nothing of it. The strings are read too: an entity whose every string carries a qualifier the item bears ("Birmingham, Ala." on Birmingham, Alabama) is not listed, and one with a string that names the place at home ("Stowe (England)" on Stowe, Vermont) leads the likely. "Written about" is the number of Wikipedia editions with an article (sitelinks). The place at home shown is the most written-about of that name.</p>
    @foreach (var (title, rows, about) in new[] { ("Likely wrong", likely, "a string of the entity names the place at home, or the place at home is at least as written about as the one the entity is aligned to"), ("To look at", look, "the entity's place is the more written about, or the place at home has no count to compare; the least written-about first"), ("Cannot tell", unknown, "the Wikidata item is not in the local index, so there is no description to read yet: \u201cDecide\u2026\u201d fetches it from Wikidata and says what it is") })
    {
        <h3>@title <span class="muted small">@rows.Count · @about</span></h3>
        @if (rows.Count == 0) { <p class="small muted">None.</p> }
        else
        {
            <table class="checks">
                <thead><tr><th>Entity and its strings</th><th>Aligned to</th><th>At home</th><th>Decide</th></tr></thead>
                <tbody>
                @foreach (var f in rows)
                {
                    var r = f.Row;
                    <tr>
                        <td><a href="/p/@Model.Dataset/entity?id=@Uri.EscapeDataString(r.EntityId)"><strong>@r.Label</strong></a><br /><span class="small muted">@r.Status · stands for @r.Strings string@(r.Strings == 1 ? "" : "s")</span>@if (f.Strings.Count > 0) { <br /><span class="small" title="The strings that stand on this entity, as the records write them">@string.Join(" · ", f.Strings.Take(6).Select(x => $"\u201c{x}\u201d"))@(f.Strings.Count > 6 ? " …" : "")</span> }@if (f.Reason is not null) { <br /><strong class="small">@f.Reason</strong> }</td>
                        <td class="small">@(r.ItemDescription ?? "(the item is not in the index)")<br /><a href="@r.Item" target="_blank" rel="noopener">@r.Item.Split('/')[^1]</a> <span class="muted">@(r.ItemDescription is null ? "" : $"· written about in {r.ItemSitelinks}")</span></td>
                        <td class="small">@if (f.HomeDoubt is not null) { <span class="muted">@f.HomeDoubt. The nearest by name:</span><br /> }@Chain(r.Label, r.HomeChain)<br /><a href="@r.HomeUri" target="_blank" rel="noopener">TGN @r.HomeUri.Split('/')[^1]</a> <span class="muted">· @(r.HomeItem is null ? "no count known" : $"written about in {r.HomeSitelinks}")</span><br /><code class="small">@r.HomeUri</code></td>
                        @* one call to action a row (the owner, 2026-11-15: three were confusing, and "you need to see the records, which means going to the mend page. The Relabel option could be there too, or in fact only there") *@
                        <td class="small decide"><a class="button secondary small" href="/p/@Model.Dataset/checks?mend=@Uri.EscapeDataString(r.EntityId)" title="Shows the records the entity's strings are in, and what can be done: keep it as the right place (with a clearer label), mend it, or move some of its strings. Nothing is changed until you choose there">Decide…</a></td>
                    </tr>
                }
                </tbody>
            </table>
        }
    }
}
}
