{
  "$schema": "../schema/corpus-entry.schema.json",
  "source": {
    "name": "Authored: canonical expressions",
    "licence": "CC0-1.0",
    "notes": "Inputs already in canonical form (docs/canonical-expression.md), so they exercise the canonical strategy and the realiser end to end under the default profile. These are verified: they gate CI today, before the free-text grammar exists."
  },
  "defaults": { "intent": "auto", "profile": "default", "status": "verified", "tags": ["canonical"] },
  "entries": [
    { "id": "can-001", "input": "1984", "tags": ["year"],
      "expect": { "status": "parsed", "kind": "single", "canonical": "1984", "edtf": "1984",
        "timespan": { "begin_of_the_begin": "1984-01-01T00:00:00Z", "end_of_the_end": "1984-12-31T23:59:59Z" }, "minConfidence": 1 } },
    { "id": "can-002", "input": "1850~", "tags": ["circa"],
      "expect": { "status": "parsed", "canonical": "1850~", "edtf": "1850~", "flags": ["Approximate"], "notFlags": ["Uncertain", "Padded"],
        "timespan": { "begin_of_the_begin": "1850-01-01T00:00:00Z", "end_of_the_end": "1850-12-31T23:59:59Z" } } },
    { "id": "can-003", "input": "late 195X", "tags": ["decade", "band"],
      "expect": { "status": "parsed", "canonical": "late 195X", "edtf": "1957/1959", "flags": ["Band"],
        "timespan": { "begin_of_the_begin": "1957-01-01T00:00:00Z", "end_of_the_end": "1959-12-31T23:59:59Z" } } },
    { "id": "can-004", "input": "century 19", "tags": ["century"],
      "expect": { "status": "parsed", "canonical": "century 19", "edtf": "1800/1899",
        "timespan": { "begin_of_the_begin": "1800-01-01T00:00:00Z", "end_of_the_end": "1899-12-31T23:59:59Z" } } },
    { "id": "can-005", "input": "q2 century 14", "tags": ["century", "band", "quarter"],
      "expect": { "status": "parsed", "edtf": "1325/1349",
        "timespan": { "begin_of_the_begin": "1325-01-01T00:00:00Z", "end_of_the_end": "1349-12-31T23:59:59Z" } } },
    { "id": "can-006", "input": "century -5", "tags": ["century", "bce"],
      "expect": { "status": "parsed", "edtf": "-0499/-0400",
        "timespan": { "begin_of_the_begin": "-0499-01-01T00:00:00Z", "end_of_the_end": "-0400-12-31T23:59:59Z" } } },
    { "id": "can-007", "input": "-0499", "tags": ["year", "bce"],
      "expect": { "status": "parsed", "years": { "start": -499, "end": -499 } } },
    { "id": "can-008", "input": "before 1850", "tags": ["relation", "before"],
      "expect": { "status": "parsed", "canonical": "before 1850", "edtf": "../1849", "flags": ["OpenStart"],
        "timespan": { "end_of_the_end": "1849-12-31T23:59:59Z" } } },
    { "id": "can-009", "input": "1971/..", "tags": ["open-end"],
      "expect": { "status": "parsed", "edtf": "1971/..", "flags": ["OpenEnd"], "timespan": { "begin_of_the_begin": "1971-01-01T00:00:00Z" } } },
    { "id": "can-010", "input": "[1904,1905]", "tags": ["disjunction"],
      "expect": { "status": "parsed", "edtf": "[1904,1905]", "flags": ["Disjunction"], "years": { "start": 1904, "end": 1905 } } },
    { "id": "can-011", "input": "1606/1669", "intent": "pair", "tags": ["pair"],
      "expect": { "status": "parsed", "kind": "birthDeath",
        "begin": { "begin_of_the_begin": "1606-01-01T00:00:00Z", "end_of_the_end": "1606-12-31T23:59:59Z" },
        "end": { "begin_of_the_begin": "1669-01-01T00:00:00Z", "end_of_the_end": "1669-12-31T23:59:59Z" } } },
    { "id": "can-012", "input": "born 1850/died 1920", "tags": ["pair", "lifecycle"],
      "expect": { "status": "parsed", "kind": "birthDeath", "canonical": "born 1850/died 1920", "flags": ["Lifecycle"],
        "begin": { "begin_of_the_begin": "1850-01-01T00:00:00Z", "end_of_the_end": "1850-12-31T23:59:59Z" },
        "end": { "begin_of_the_begin": "1920-01-01T00:00:00Z", "end_of_the_end": "1920-12-31T23:59:59Z" } } },
    { "id": "can-013", "input": "fl 1480/1510", "tags": ["floruit"],
      "expect": { "status": "parsed", "kind": "floruit", "flags": ["Floruit"],
        "timespan": { "begin_of_the_begin": "1480-01-01T00:00:00Z", "end_of_the_end": "1510-12-31T23:59:59Z" },
        "begin": { "begin_of_the_begin": "1480-01-01T00:00:00Z", "end_of_the_end": "1480-12-31T23:59:59Z" },
        "end": { "begin_of_the_begin": "1510-01-01T00:00:00Z", "end_of_the_end": "1510-12-31T23:59:59Z" } } },
    { "id": "can-014", "input": "1945-24", "tags": ["season"],
      "expect": { "status": "parsed", "flags": ["Season"],
        "timespan": { "begin_of_the_begin": "1945-12-01T00:00:00Z", "end_of_the_end": "1946-02-28T23:59:59Z" } } },
    { "id": "can-015", "input": "4.5 Ga ago", "tags": ["deep-time"],
      "expect": { "status": "parsed", "flags": ["DeepTime"], "edtf": "Y-4549997974/Y-4449997974",
        "timespan": { "begin_of_the_begin": "-4549997974-01-01T00:00:00Z", "end_of_the_end": "-4449997974-12-31T23:59:59Z" } } },
    { "id": "can-016", "input": "undated", "tags": ["undated"],
      "expect": { "status": "undated", "kind": "none" } },
    { "id": "can-017", "input": "period:edo", "tags": ["named-period"],
      "expect": { "status": "parsed", "canonical": "period:edo", "edtf": "1603/1868", "flags": ["NamedPeriod"], "minConfidence": 1 } },
    { "id": "can-018", "input": "1850", "intent": "pair", "tags": ["partial"],
      "expect": { "status": "partial", "kind": "single", "timespan": { "begin_of_the_begin": "1850-01-01T00:00:00Z", "end_of_the_end": "1850-12-31T23:59:59Z" } } }
  ]
}
