  <ItemGroup>
    <!-- the user guide, rendered at /help from the committed text (docs/13-workbench-guide.md), never a second copy -->
    <EmbeddedResource Include="..\..\docs\13-workbench-guide.md" LogicalName="guide.md" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LinkedArtNet.Workbench.Tests" />
  </ItemGroup>

</Project>
