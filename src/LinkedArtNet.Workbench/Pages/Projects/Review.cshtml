@page "/p/{dataset}/review"
@model ReviewModel
@functions {
    // a field named to the reviewer in the manifest's plain words ("place of publication" for place), its own name on hover (the owner, 2026-11-13)
    string F(string? context) => Model.Project.Manifest.FieldName(context);
    Microsoft.AspNetCore.Html.IHtmlContent Field(string? context)
    {
        var enc = System.Text.Encodings.Web.HtmlEncoder.Default;
        var about = Model.Project.Manifest.FieldAbout(context);
        return new Microsoft.AspNetCore.Html.HtmlString($"<span title=\"{enc.Encode("the field " + context + (about is null ? "" : ": " + about))}\">{enc.Encode(F(context))}</span>");
    }
    // a project entity named with its placement when known ("Birmingham (Ala.)"), so namesakes on one page can be told apart (the owner, 2026-11-07)
    string Named(LinkedArtNet.Alignment.Entity e)
    {
        var f = Model.Item?.Entities.Values.FirstOrDefault(x => x.Entity.Id == e.Id);
        return (e.Label ?? e.Id) + (f?.Placement is { } p ? $" ({p})" : "");
    }

    // an identifier as a link to its record, with what the record is when the store holds it: "wikidata's Q3403624 (Dagenham:
    // Parliamentary constituency in the United Kingdom, 1945-2010)" (the owner, 2026-11-13, at the two Dagenhams)
    Microsoft.AspNetCore.Html.IHtmlContent Held(string uri, string? source = null)
    {
        var enc = System.Text.Encodings.Web.HtmlEncoder.Default;
        source ??= LinkedArtNet.Alignment.AuthorityUris.SourceOf(uri);
        var says = Model.Item is { } it && it.Records.TryGetValue(uri, out var r) ? LinkedArtNet.Alignment.Authorities.RecordSummary.Says(r) : null;
        // no record of it here (a VIAF number): the record on the card that gives it says what it is
        if (says is null && Model.Item is { } card && !card.Records.ContainsKey(uri) && LinkedArtNet.Alignment.Authorities.IdentifierSets.CitedBy(uri, card.Records.Values) is { } giver)
            says = $"given by {giver.Source}'s {giver.Uri.TrimEnd('/').Split('/').Last()}";
        return new Microsoft.AspNetCore.Html.HtmlString(
            $"<a href=\"{enc.Encode(uri)}\" target=\"_blank\" rel=\"noopener\">{enc.Encode(source + "'s " + uri.TrimEnd('/').Split('/').Last())}</a>"
            + (says is null ? "" : $" <span class=\"said\">({enc.Encode(says)})</span>"));
    }

    // the merge of a holder pair, on its own line at the foot of the pair's box
    Microsoft.AspNetCore.Html.IHtmlContent PairFoot(long id, IEnumerable<string> targets)
    {
        var enc = System.Text.Encodings.Web.HtmlEncoder.Default;
        var b = new Microsoft.AspNetCore.Html.HtmlContentBuilder();
        b.AppendHtml($"<form method=\"post\" action=\"/p/{enc.Encode(Model.Dataset)}/review?handler=AcceptTogether\" class=\"pair-foot\">");
        b.AppendHtml(Html.AntiForgeryToken());
        b.AppendHtml($"<input type=\"hidden\" name=\"id\" value=\"{id}\" />");
        foreach (var t in targets) b.AppendHtml($"<input type=\"hidden\" name=\"targets\" value=\"{enc.Encode(t)}\" />");
        b.AppendHtml("<button type=\"submit\" class=\"secondary\" title=\"You choose the survivor next, and see what will happen before it is done\">Merge them and accept this string onto the survivor</button>");
        b.AppendHtml(" <span class=\"small muted\">You choose the survivor next; nothing is merged until you confirm.</span></form>");
        return b;
    }

    Microsoft.AspNetCore.Html.IHtmlContent HeldAll(IEnumerable<LinkedArtNet.Alignment.Equivalent> held, string separator = ", ")
    {
        var b = new Microsoft.AspNetCore.Html.HtmlContentBuilder();
        var first = true;
        foreach (var q in held) { if (!first) b.Append(separator); b.AppendHtml(Held(q.Uri, q.Source)); first = false; }
        return b;
    }
}
@{
    ViewData["Title"] = "Review";
    var item = Model.Item;
}
<div class="row" style="justify-content:space-between">
    <h1 style="margin:0">Review desk</h1>
    <form method="get" class="row" style="gap:.5rem">
        <input type="hidden" name="method" value="@Model.Method" />
        <select name="context" onchange="this.form.submit()" aria-label="Context">
            <option value="">all contexts (@Model.Queue.Sum(r => r.Count))</option>
            @foreach (var row in Model.Queue)
            {
                <option value="@row.Context" selected="@(row.Context == Model.Context)">@row.Context (@row.Count)</option>
            }
        </select>
        <select name="method" onchange="this.form.submit()" aria-label="Kind">
            <option value="queued" selected="@(Model.Method == "queued")">queued for review</option>
            <option value="minted" selected="@(Model.Method == "minted")">minted (nothing found)</option>
            <option value="human" selected="@(Model.Method == "human")">decided by a person</option>
        </select>
    </form>
</div>
@if (Model.Plan is { } waiting) { <p class="notice"><strong>Confirm first:</strong> @waiting.Ours.Count of the project's own entities are ticked and would become one. <a href="#confirm-together">What will happen, and the choice, is under the candidates</a>; nothing is done until you press Merge and accept there.</p> }
@if (Model.Message is not null) { <p class="notice">@Model.Message @if (Model.Decided is { } d) { <text>· </text><a href="/p/@Model.Dataset/entity?id=@Uri.EscapeDataString(d.Id)"><strong>@d.Label</strong></a><text>, to add identifiers or notes before going on</text> }</p> }

<details class="help">
    <summary>What am I supposed to do here?</summary>
    <p>One string at a time, as the catalogue wrote it, with the records it was seen in under <strong>In the records</strong>.
    Below it, what the software found: each box is a group, one authority record or several records that say they are the
    same thing, best first; greyed rows were ruled out and the reason says why. Say what the string is with the group's own
    button: <strong>Accept</strong> (it is this record), <strong>Accept these as one</strong> (it is this group, one entity with
    all its identifiers), <strong>Same as</strong> an entity the project already has; <strong>Always, in this field</strong>
    (the same, and this spelling means this from now on); <strong>just this one</strong> on a row of a group takes that record
    alone; search for <strong>something else</strong>; or
    <strong>Keep as local authority</strong> when it is real and none of the cards is it. A card that is one of the project's own
    entities says what it stands for and holds; when two of them hold records of one group, the group says so and offers to merge them
    and accept the string onto the survivor, showing what will happen first. The other queued strings under the same name are listed
    above the records, and after an action the desk goes to them before it moves on. Not sure? <strong>Skip for now</strong>,
    or leave a <strong>note</strong> for another reviewer. Every decision can be undone. <a href="/help#the-desk">The guide</a>
    has the rest.</p>
</details>
@if (item is null)
{
    <p class="empty">Nothing @(Model.Method == "queued" ? "waiting for review" : "here")@(Model.Context is null ? "" : $" in {Model.Context}"). <a href="/p/@Model.Dataset">Back to the project</a>.</p>
}
else
{
    var ev = item.Evidence;
    var reading = ev.Reading;
    <p class="small muted">@Model.Remaining in this list · string @item.String.Id · seen @item.String.Occurrences time@(item.String.Occurrences == 1 ? "" : "s") as <strong>@Field(item.String.Context)</strong> · decided <em>@item.Decision.Method</em>@(item.Decision.Reviewer is null ? "" : $" by {item.Decision.Reviewer}") @item.Decision.DecidedAt.ToString("yyyy-MM-dd")
    <text>· </text><a href="@Url.Page("/Projects/Review", new { dataset = Model.Dataset, method = Model.Method, context = Model.Context, id = item.String.Id, pictures = !Model.Pictures })" title="Thumbnails on the cards whose records have been pulled from the sources with a picture; off by default">@(Model.Pictures ? "hide pictures" : "show pictures")</a>
    @if (item.LookedAgain is null) { <text>· </text><a href="@Url.Page("/Projects/Review", new { dataset = Model.Dataset, method = Model.Method, context = Model.Context, id = item.String.Id, look = true })" title="Show what today's rules would offer for this string, without deciding anything">Look again</a> }</p>
    @if (item.LookedAgain is { } outcome)
    {
        <p class="flash">Looked at again under today's rules: it would be <strong>@outcome</strong>. The stored decision is unchanged; the actions below act on what you see. <a href="@Url.Page("/Projects/Review", new { dataset = Model.Dataset, method = Model.Method, context = Model.Context, id = item.String.Id })">Back to the stored evidence</a></p>
    }
    <p class="string">@item.String.Raw</p>
    @if (reading is not null)
    {
        <dl class="facts">
            <dt>Read as</dt><dd><strong>@reading.Text</strong> @if (reading.Classes is { Count: > 0 }) { <span class="tag">@string.Join(" or ", reading.Classes)</span> }</dd>
            @if (reading.Lifespan is not null) { <dt>Dates</dt><dd>@reading.Lifespan</dd> }
            @if (reading.Roles is { Count: > 0 }) { <dt>Roles</dt><dd>@string.Join(", ", reading.Roles)</dd> }
            @if (reading.Nationalities is { Count: > 0 }) { <dt>Nationality</dt><dd>@string.Join(", ", reading.Nationalities)</dd> }
            @if (item.Entity is not null) { <dt>Currently</dt><dd><a href="/p/@Model.Dataset/entity?id=@Uri.EscapeDataString(item.Entity.Id)" target="_blank" rel="noopener" title="The entity's page">@item.Entity.Label</a> <span class="tag">@item.Entity.Status.ToString().ToLowerInvariant()</span> <code class="small">@item.Entity.Id</code></dd> }
        </dl>
    }
    @if (item.Siblings.Count > 0)
    {
        @* the other queued strings under this name; after an action the desk goes to these first (the owner, 2026-11-06) *@
        <p class="small"><strong>Also waiting under this name:</strong>
        @for (var i = 0; i < item.Siblings.Count; i++)
        {
            var sib = item.Siblings[i];
            if (i > 0) { <text> · </text> }
            <a href="@Url.Page("/Projects/Review", new { dataset = Model.Dataset, method = Model.Method, context = Model.Context, id = sib.String.Id })">"@sib.String.Raw" (@F(sib.String.Context))</a>
        }
        <span class="muted">· after an action the desk goes to these first</span></p>
    }
    @if (item.Examples.Count > 0)
    {
        <div class="card"><h3 style="margin-top:0">In the records</h3>
        @foreach (var x in item.Examples)
        {
            <p class="small"><strong>@(x.Title ?? "(no title)")</strong>@(x.Date is null ? "" : $" ({x.Date})") <span class="muted">· @x.RecordId · from &lt;@x.Field&gt;</span>
            @foreach (var (name, values) in x.NamingFields()) { <br /><span class="muted">@name:</span> @string.Join(" · ", values) }
            </p>
        }
        </div>
    }
    @if (item.Notes.Count > 0)
    {
        <div class="card"><h3 style="margin-top:0">Notes</h3>@foreach (var n in item.Notes) { <p class="small"><strong>@n.Author</strong> <span class="muted">@n.CreatedAt.ToString("yyyy-MM-dd HH:mm")</span><br />@n.Text</p> }</div>
    }

    <h2>Candidates</h2>
    @if (Model.Plan is { } plan)
    {
        @* two or more of the project's own entities among the ticked: what accepting them together will do, shown before it is done, since a
           merge is not undone by Undo (the owner, 2026-11-06, at "Chris Beetles Ltd": the firm's two aligned entities and two placeholders in
           one group, and a warning after the fact that sent them to the entity page) *@
        <form method="post" asp-page-handler="AcceptTogether" class="notice" id="confirm-together">
            <input type="hidden" name="id" value="@item.String.Id" /><input type="hidden" name="confirmed" value="true" />
            @if (Model.Always) { <input type="hidden" name="always" value="true" /> }
            @foreach (var t in Model.Targets ?? []) { <input type="hidden" name="targets" value="@t" /> }
            <h3 style="margin-top:0">@plan.Ours.Count of the project's own entities are ticked: they become one</h3>
            <p class="small">Choose which survives. The others merge into it, and their strings, identifiers and labels follow. A merge is permanent: <strong>Undo</strong> takes back this string's decision, not the merge.</p>
            @foreach (var e in plan.Ours)
            {
                item.Entities.TryGetValue(e.Id, out var ef);
                <label class="small inline" style="display:block; margin:.3rem 0"><input type="radio" name="survivor" value="@e.Id" checked="@(e.Id == plan.Survivor.Id)" />
                    <strong>@Named(e)</strong> <span class="tag">@e.Class.ToString().ToLowerInvariant()</span> <span class="tag">@e.Status.ToString().ToLowerInvariant()</span>
                    @if (e.Equivalents.Count > 0) { <text>holds @HeldAll(e.Equivalents);</text> } else { <text>no identifier;</text> }
                    @if (ef is not null) { <text>stands for @ef.Strings.Count string@(ef.Strings.Count == 1 ? "" : "s")@(ef.Contexts.Count > 0 ? " (" + string.Join(", ", ef.Contexts.Select(F)) + ")" : "")</text> }
                    · <a href="/p/@Model.Dataset/entity?id=@Uri.EscapeDataString(e.Id)" target="_blank" rel="noopener">its page</a></label>
            }
            @{ var classes = plan.Ours.Select(e => e.Class).Distinct().ToList(); }
            @if (classes.Count > 1)
            {
                @* a Person and a Group do not merge silently: the merged entity's class is chosen here (the owner, 2026-11-07, at "Ackermann and Son") *@
                <p class="small">They differ in class. The merged entity is a
                    <select name="cls">@foreach (var c in classes) { <option value="@c" selected="@(c == plan.Survivor.Class)">@c.ToString().ToLowerInvariant()</option> }</select>
                    (the survivor's unless you choose; the change is noted on it).</p>
            }
            <p class="small">Then @if (plan.Identifiers.Count == 0) { <text>no new identifier is added</text> } else { <text>@plan.Identifiers.Count identifier@(plan.Identifiers.Count == 1 ? "" : "s") added: </text>@for (var n = 0; n < plan.Identifiers.Count; n++) { <text>@(n == 0 ? "" : ", ")</text>@Held(plan.Identifiers[n]) } }, and "@item.String.Raw" is decided onto the survivor.</p>
            <div class="actions"><button type="submit">Merge and accept</button> <a class="button secondary" href="@Url.Page("/Projects/Review", new { dataset = Model.Dataset, method = Model.Method, context = Model.Context, id = item.String.Id })">Back</a></div>
        </form>
    }
        // the store has moved on since this evidence was written: an entity merged into another shows under the survivor's facts, and the
        // desk says so above the candidates rather than let three rows stand for one entity with the run's old reasons (the owner,
        // 2026-11-06, at the next Chris Beetles string)
        var overtaken = item.Entities.Where(kv => kv.Value.Entity.Id != kv.Key)
            .Select(kv => (Was: ev.Groups.SelectMany(g => g.Members).FirstOrDefault(m => m.Uri == kv.Key)?.Label ?? kv.Key, Now: kv.Value.Entity))
            .DistinctBy(o => (o.Was, o.Now.Id)).ToList(); // two placeholders of one label say it once
        var seenEntities = new HashSet<string>(StringComparer.Ordinal);
    @if (overtaken.Count > 0 && item.LookedAgain is null)
    {
        <p class="flash small">The store has changed since this evidence was written: @string.Join("; ", overtaken.Select(o => $"\"{o.Was}\" has merged into {o.Now.Label ?? o.Now.Id}")). The rows below say which.
        <a href="@Url.Page("/Projects/Review", new { dataset = Model.Dataset, method = Model.Method, context = Model.Context, id = item.String.Id, look = true })">Look again</a> shows the string as today's rules see it.</p>
    }
    @if (ev.Groups.Count == 0) { <p class="muted">The reconciler found nothing in the local indexes for this string.</p> }
    @if (ev.Groups.Count > 1 && Model.Method != "human")
    {
        <form method="post" asp-page-handler="AcceptTogether" id="together" class="row" style="gap:.5rem; margin:.25rem 0 .75rem">
            <input type="hidden" name="id" value="@item.String.Id" />
            <button type="submit" class="secondary" title="The ticked groups are one thing: one entity with all their identifiers">Accept the ticked together</button>
            <span class="small muted">tick "together" on two or more groups that are the same thing</span>
        </form>
    }
        // the map (the owner, 2026-11-08): namesake places side by side on one map, since seeing the St Iveses apart is how a person picks
        // the right one; a marker per placed candidate, labelled with the record's label and its placement, the best group's markers emphasised
        var points = new List<object>();
        var unplaced = new List<string>();
        var bestGroup = ev.Groups.FirstOrDefault(g => g.Members.Any(m => m.Veto != true && m.SetAside != true));
        foreach (var g in ev.Groups)
            foreach (var m in g.Members)
            {
                item.Records.TryGetValue(m.Uri, out var rec);
                item.Entities.TryGetValue(m.Uri, out var ef);
                var isPlace = ef?.Entity.Class == EntityClass.Place || rec?.Type == "Place";
                var label = ef is not null ? Named(ef.Entity) : (m.Label ?? rec?.Label ?? m.Uri);
                if (ef is null && rec?.DataJson is { } dj && System.Text.Json.JsonDocument.Parse(dj).RootElement.TryGetProperty("parentString", out var ps) && ps.GetString() is { } parents)
                    label += " (" + string.Join(", ", parents.Split(',').Select(x => x.Trim()).Where(x => x.Length > 0).Take(2)) + ")";
                if (item.Placed is null || !item.Placed.TryGetValue(m.Uri, out var at)) { if (isPlace) unplaced.Add(label); continue; }
                if (at.Near is not null) label += $", near {at.Near}";
                if (at.Via is not null) label += $" (the coordinates of {at.Via})";
                points.Add(new { lat = at.Lat, lng = at.Long, label, chosen = ReferenceEquals(g, bestGroup) && m.Veto != true && m.SetAside != true, approximate = at.Approximate, source = m.Source });
            }
    if (points.Count > 0)
    {
        <div id="map" class="map" data-points='@System.Text.Json.JsonSerializer.Serialize(points)' aria-label="The candidates on a map"></div>
        @* a place with no coordinates anywhere is named, so the map's silence about it is not read as absence (the owner, 2026-11-08, at Windsor Castle) *@
        @if (unplaced.Count > 0) { <p class="small muted" style="margin-top:-.6rem">Not on the map, no coordinates in its record: @string.Join(" · ", unplaced.Distinct().Take(6)).</p> }
        @if (points.Any(p => (bool)p.GetType().GetProperty("approximate")!.GetValue(p)!)) { <p class="small muted" style="margin-top:-.4rem">A hollow marker stands where the record itself carries no coordinates: at its TGN parent, or where TGN puts the same name in the same place.</p> }
    }
    var first = true;
    foreach (var group in ev.Groups)
    {
        var live = group.Members.Where(m => m.Veto != true && m.SetAside != true).ToList();
        var allVeto = live.Count == 0;
        // the project's own firm entities in the group, each followed through a merge and counted once
        var firm = live.Where(m => item.Entities.TryGetValue(m.Uri, out var f) && !f.IsPlaceholder).Select(m => item.Entities[m.Uri].Entity).DistinctBy(e => e.Id).ToList();
        // a holder pair's box (the owner, 2026-11-13, at Dagenham: the notice did not say which rows it meant, and its button sat in the
        // flow of the text): the rows still to box, and the merge's own line under the last of them
        var pairLeft = -1;
        Func<IEnumerable<LinkedArtNet.Alignment.Reconciliation.EvidenceMember>, Microsoft.AspNetCore.Html.IHtmlContent> pairFoot = targets => PairFoot(item.String.Id, targets.Select(t => t.Uri));
        <div class="card @(first && !allVeto ? "best" : "") @(allVeto ? "veto" : "")">
            <div class="row">
                <span class="score">@group.Score.ToString("0.00")</span>
                @foreach (var s in group.Sources) { if (group.Members.FirstOrDefault(m => m.Source == s)?.Uri is { } su) { <a class="tag src" href="@su" target="_blank" rel="noopener" title="@su">@s</a> } else { <span class="tag src">@s</span> } }
                @if (group.Members.Count > 1) { <span class="muted small">@group.Members.Count records agree they are one thing</span> }
                @* the group is the card: its tick and its action are in its header, and the rows of a group of several go quiet (the owner,
                   2026-11-06: ten actions on the rows of a box that is one thing, and "card" read as the row) *@
                @if (!allVeto && Model.Method != "human")
                {
                    <span style="margin-left:auto"></span>
                    @if (ev.Groups.Count > 1) { <label class="small inline" style="white-space:nowrap" title="This group is one of the things to accept together"><input type="checkbox" name="targets" value="@string.Join(" ", live.Select(m => m.Uri))" form="together" /> together</label> }
                    @if (live.Count > 1 && firm.Count <= 1)
                    {
                        <form method="post" asp-page-handler="AcceptTogether" class="inline">
                            <input type="hidden" name="id" value="@item.String.Id" />
                            @foreach (var m in live) { <input type="hidden" name="targets" value="@m.Uri" /> }
                            <button type="submit" title="@(firm.Count == 1 ? "The string is this entity, which gets any record of the group it does not hold yet" : "The string is this group: one entity with all its identifiers")">@(firm.Count == 1 ? $"Same as {Named(firm[0])}" : "Accept these as one")</button>
                            <button type="submit" name="always" value="true" class="secondary" title="The same, and this exact spelling means it from now on in this field; the variants page can widen a rule to every field">Always, in this field</button>
                        </form>
                    }
                }
            </div>
            @if (firm.Count >= 2 && Model.Method != "human" && Model.Plan is null)
            {
                @* two or more of the project's own firm entities in one group: the store disagrees with itself, which is why the string was
                   queued; the group says so and offers the merge as its own action (the owner, 2026-11-06, at "Chris Beetles Ltd") *@
                <div class="pair-head small">
                    <strong>@firm.Count of the project's entities hold records of this group: the @firm.Count boxed here.</strong>
                    The authorities say they are one thing, and the string was queued because the store disagrees with itself.
                    <a href="/help/scenarios#holder-pair" target="_blank" rel="noopener">How to decide this, with an example</a>.
                </div>
                pairLeft = firm.Count;
            }
            @foreach (var m in group.Members)
            {
                item.Records.TryGetValue(m.Uri, out var record);
                item.Entities.TryGetValue(m.Uri, out var facts);
                var sameAsAbove = facts is not null && !seenEntities.Add(facts.Entity.Id);
                // the box of a holder pair: the project's entities the notice speaks of, each a boxed row, and the merge under the last
                var boxed = pairLeft > 0 && facts is not null && !sameAsAbove && firm.Any(e => e.Id == facts.Entity.Id);
                if (pairLeft == 0) { pairLeft = -1; @pairFoot(live) }
                if (boxed) { pairLeft--; }
                <div class="row @(boxed ? "pair-row" : "")" style="@(boxed ? "" : "margin-top:.5rem;") @(m.Veto == true || m.SetAside == true ? "opacity:.6" : "")">
                    <div style="flex:1">
                        @* a project entity's name is the link to its page, in another tab so the desk stays where it is; the URI below it is the
                           URI's own link, as every record's (the owner, 2026-11-05: "Mr Stanley" beside placeholders of the name, which might fold
                           onto it, and nothing to tell them apart but their records) *@
                        @if (m.IsStore || m.Uri.StartsWith(Model.Project.Project.IdentifierBase, StringComparison.Ordinal)) { <strong><a href="/p/@Model.Dataset/entity?id=@Uri.EscapeDataString(m.Uri)" target="_blank" rel="noopener" title="The entity's page: its identifiers, the strings that resolve to it and the records they were seen in">@(m.Label ?? m.Uri)</a></strong> <button type="button" class="tray-add small" data-tray="@(facts?.Entity.Id ?? m.Uri)" data-tray-label="@(facts?.Entity.Label ?? m.Label ?? m.Uri)" data-tray-text="Tray">Tray</button> }
                        else { <strong>@(m.Label ?? record?.Label ?? m.Uri)</strong> }
                        @if (facts?.Placement is { } where) { <span class="muted">(@where)</span> }
                        @if (record?.Lifespan?.Display is { } life) { <span class="muted">@life</span> }
                        @if (record?.Type is { } type) { <span class="tag">@type.ToLowerInvariant()</span> }
                        @if (facts is not null) { <span class="tag">@facts.Entity.Class.ToString().ToLowerInvariant()</span> <span class="tag">@facts.Entity.Status.ToString().ToLowerInvariant()</span> }
                        <span class="tag">@m.Source</span>
                        <a class="small" href="@m.Uri" target="_blank" rel="noopener">@m.Uri</a>
                        @if (record is not null && record.Labels.Count > 1) { <div class="small muted">also: @string.Join(" · ", record.Labels.Where(l => l != record.Label).Take(6))</div> }
                        @if (record?.DataJson is { } data && System.Text.Json.JsonDocument.Parse(data).RootElement.TryGetProperty("description", out var desc)) { <div class="small">@desc.GetString()</div> }
                        @if (Model.Pictures && LinkedArtNet.Alignment.Authorities.SourcePull.Read(record) is { } pulled)
                        {
                            @if (pulled.Picture is { ThumbUrl: { } th } pic) { <figure class="picture small"><a href="@pic.FilePage" target="_blank" rel="noopener"><img src="@th" alt="@pic.FileName" loading="lazy" /></a><figcaption class="small muted">@pic.Attribution</figcaption></figure> }
                            @if (pulled.Description is not null) { <div class="small">@pulled.Description <span class="muted">(@pulled.Source, pulled @pulled.At.ToLocalTime().ToString("yyyy-MM-dd"))</span></div> }
                        }
                        @if (facts is not null)
                        {
                            @* what put the project's entity in this group, and what it stands for, so the row can be judged without its page
                               (the owner, 2026-11-06, at "Chris Beetles Ltd"); and when the entity has merged since the evidence was written, or
                               is one a row above already stands for, the row says so first *@
                            var held = facts.Entity.Equivalents.Where(q => group.Members.Any(x => x.Uri == q.Uri)).ToList();
                            var others = facts.Entity.Equivalents.Where(q => !group.Members.Any(x => x.Uri == q.Uri)).ToList();
                            var firstString = facts.Strings.OrderByDescending(s => s.String.Occurrences).FirstOrDefault();
                            <div class="small muted">
                                @if (facts.Entity.Id != m.Uri) { <strong>now merged into <a href="/p/@Model.Dataset/entity?id=@Uri.EscapeDataString(facts.Entity.Id)" target="_blank" rel="noopener">@(facts.Entity.Label ?? facts.Entity.Id)</a></strong><text> · </text> }
                                @if (sameAsAbove) { <strong>the same entity as a row above</strong><text> · </text> }
                                @if (held.Count > 0) { <text>the project's entity, holding @HeldAll(held, " and ")@if (others.Count > 0) { <text>; also @HeldAll(others)</text> }</text> }
                                else if (facts.Entity.Equivalents.Count > 0) { <text>the project's entity, aligned to @HeldAll(facts.Entity.Equivalents)</text> }
                                else if (facts.IsPlaceholder) { <text>a placeholder@(firstString is null ? "" : $" for \"{firstString.String.Raw}\" ({F(firstString.String.Context)})")</text> }
                                else { <text>the project's own local authority</text> }
                                · stands for @facts.Strings.Count string@(facts.Strings.Count == 1 ? "" : "s")@(facts.Contexts.Count > 0 ? " (" + string.Join(", ", facts.Contexts.Select(F)) + ")" : "")
                                @if (facts.Examples.Count > 0) { <text>· seen in: @string.Join(" · ", facts.Examples.Select(x => (x.Title ?? x.RecordId) + (x.Date is null ? "" : $" ({x.Date})")))</text> }
                            </div>
                        }
                        <div class="reason">@m.Reason</div>
                        @if (!m.IsStore && item.Holders is { } holders && holders.TryGetValue(m.Uri, out var holder))
                        {
                            @* the project entity that holds this record now, since the evidence was written: an identifier added by hand, or a later run *@
                            <div class="small muted">now held by the project's entity <a href="/p/@Model.Dataset/entity?id=@Uri.EscapeDataString(holder.Entity.Id)" target="_blank" rel="noopener">@Named(holder.Entity)</a> <span class="tag">@holder.Entity.Status.ToString().ToLowerInvariant()</span>, which was not among the candidates when this card was written
                                @if (Model.Method != "human") { <form method="post" asp-page-handler="SameAs" class="inline"><input type="hidden" name="id" value="@item.String.Id" /><input type="hidden" name="entity" value="@holder.Entity.Id" /><button type="submit" class="link small">Same as @Named(holder.Entity)</button></form> }
                            </div>
                        }
                    </div>
                    @if (m.Veto == true && Model.Method != "human")
                    {
                        @* ruled out by dates or class, and the person knows better: the catalogue's two years on a birth should not cost a detour
                           through "Something else" (the owner, 2026-11-07, at "Hall, Harry, 1815-1882") *@
                        <form method="post" asp-page-handler="@(m.IsStore ? "SameAs" : "Accept")" class="inline">
                            <input type="hidden" name="id" value="@item.String.Id" /><input type="hidden" name="@(m.IsStore ? "entity" : "target")" value="@m.Uri" />
                            <button type="submit" class="link small" title="Ruled out for the reason shown; you know better. Recorded as your decision.">accept anyway</button>
                        </form>
                    }
                    else if (m.Veto != true && Model.Method != "human" && live.Count == 1)
                    {
                        @* a group of one record: the row's actions are the group's *@
                        @if (!m.IsStore)
                        {
                            <form method="post" asp-page-handler="Accept" class="inline">
                                <input type="hidden" name="id" value="@item.String.Id" /><input type="hidden" name="target" value="@m.Uri" />
                                <button type="submit">Accept</button>
                            </form>
                            <form method="post" asp-page-handler="Override" class="inline">
                                <input type="hidden" name="id" value="@item.String.Id" /><input type="hidden" name="target" value="@m.Uri" />
                                <button type="submit" class="secondary" title="Always read this exact spelling as this record when it occurs in this field; the variants page can widen a rule to every field">Always, in this field</button>
                            </form>
                        }
                        else
                        {
                            <form method="post" asp-page-handler="SameAs" class="inline">
                                <input type="hidden" name="id" value="@item.String.Id" /><input type="hidden" name="entity" value="@m.Uri" />
                                <button type="submit">Same as this</button>
                            </form>
                        }
                    }
                    else if (m.Veto != true && Model.Method != "human")
                    {
                        @* a quiet way to take one row of a group that is one thing, for the rare case the rest are not it *@
                        <form method="post" asp-page-handler="@(m.IsStore ? "SameAs" : "Accept")" class="inline">
                            <input type="hidden" name="id" value="@item.String.Id" /><input type="hidden" name="@(m.IsStore ? "entity" : "target")" value="@m.Uri" />
                            <button type="submit" class="link small" title="@(m.IsStore ? "Only this entity, not the rest of the group" : "Only this record, not the rest of the group")">just this one</button>
                        </form>
                    }
                </div>
            }
            @if (pairLeft == 0) { pairLeft = -1; @pairFoot(live) }
        </div>
        first = false;
    }

    <h2>Something else</h2>
    <div class="grid">
        <div class="card">
            @* the search is a form of its own and the results follow it inside the card: a result's own form nested in the search form
               would end it, and the rest of the results would fall out of the card into the grid (the desk, 2026-10-26) *@
            <form method="get">
                <input type="hidden" name="method" value="@Model.Method" /><input type="hidden" name="context" value="@Model.Context" /><input type="hidden" name="id" value="@item.String.Id" />
                <label for="q">Search the store's entities and the local indexes</label>
                <div class="row"><input type="search" id="q" name="q" value="@(Model.Q ?? reading?.Text ?? item.String.Raw)" style="flex:1" /><button type="submit" class="secondary">Search</button></div>
            </form>
            @if (Model.Q is not null)
            {
                @if (Model.EntityMatches.Count == 0 && Model.IndexMatches.Count == 0) { <p class="muted small">Nothing found for "@Model.Q".</p> }
                @foreach (var e in Model.EntityMatches)
                {
                    <div class="row result"><div style="flex:1"><strong><a href="/p/@Model.Dataset/entity?id=@Uri.EscapeDataString(e.Id)" target="_blank" rel="noopener" title="The entity's page">@e.Label</a></strong> <span class="tag">@e.Class.ToString().ToLowerInvariant()</span> <span class="tag">@e.Status.ToString().ToLowerInvariant()</span><br /><a class="small" href="@e.Id" target="_blank" rel="noopener">@e.Id</a></div>
                        <form method="post" asp-page-handler="SameAs" class="inline"><input type="hidden" name="id" value="@item.String.Id" /><input type="hidden" name="entity" value="@e.Id" /><button type="submit">Same as</button></form></div>
                }
                @foreach (var r in Model.IndexMatches)
                {
                    <div class="row result"><div style="flex:1"><strong>@r.Label</strong> @if (r.Lifespan?.Display is { } l) { <span class="muted">@l</span> } <span class="tag">@r.Type?.ToLowerInvariant()</span> <span class="tag">@r.Source</span><br /><a class="small" href="@r.Uri" target="_blank" rel="noopener">@r.Uri</a></div>
                        <form method="post" asp-page-handler="Accept" class="inline"><input type="hidden" name="id" value="@item.String.Id" /><input type="hidden" name="target" value="@r.Uri" /><button type="submit">Accept</button></form></div>
                }
            }
        </div>
        <form method="post" asp-page-handler="Local" class="card">
            <input type="hidden" name="id" value="@item.String.Id" />
            <h3 style="margin-top:0">None of these: it is real and local</h3>
            <p class="small muted">Keeps the entity as a confirmed local authority, in no external source. The pipeline stops asking.</p>
            <label for="label">Label (as it should be published)</label>
            <input type="text" id="label" name="label" value="@(item.Entity?.Label ?? reading?.Text)" />
            <label for="lnote">Note</label>
            <input type="text" id="lnote" name="note" placeholder="Edinburgh dealer, not the national gallery" />
            <label for="lurl">Known elsewhere (URL, optional)</label>
            <input type="text" id="lurl" name="url" placeholder="https://manuscripts.nls.uk/agents/corporate_entities/1476" title="An archive's agent page, a VIAF cluster: kept as the entity's identifier" />
            <div class="actions"><button type="submit">Keep as local authority</button></div>
        </form>
    </div>

    <div class="actions" style="margin-top:1.5rem">
        @if (item.SkippedAt is { } skipped)
        {
            <form method="post" asp-page-handler="Unskip" class="inline"><input type="hidden" name="id" value="@item.String.Id" /><button type="submit" class="quiet" title="Skipped @skipped.ToString("yyyy-MM-dd HH:mm"): back to its place in the desk's order">Unskip</button></form>
        }
        else
        {
            <form method="post" asp-page-handler="Skip" class="inline"><input type="hidden" name="id" value="@item.String.Id" /><button type="submit" class="quiet" title="To the back of the desk: it comes round again after everything else, in this session or the next">Skip for now</button></form>
        }
        <form method="post" asp-page-handler="Undo" class="inline"><input type="hidden" name="id" value="@item.String.Id" /><button type="submit" class="quiet" title="Take back the latest decision on this string">Undo last decision</button></form>
        <form method="post" asp-page-handler="Flag" class="row inline" style="gap:.4rem"><input type="hidden" name="id" value="@item.String.Id" /><input type="text" name="text" placeholder="Note for another reviewer" style="width:18rem" /><button type="submit" class="quiet">Add note</button></form>
        <a class="button secondary" href="@Url.Page("/Projects/Review", new { dataset = Model.Dataset, method = Model.Method, context = Model.Context, after = item.String.Id })">Next →</a>
    </div>
}
@section Scripts {
    <partial name="_Map" />
}
