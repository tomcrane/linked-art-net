@* The map (plan section 7, "A map", the owner, 2026-11-08). Any element with class "map" and a data-points attribute (a JSON list of
   {lat, lng, label, chosen}) becomes a Leaflet map over OpenStreetMap tiles: one marker per point, the chosen ones emphasised, the view
   fitted to them all. Leaflet 1.9.4 (BSD-2) from unpkg; the tiles are OpenStreetMap's, whose attribution the map shows, as their policy
   requires. Nothing here runs when no element has the class. *@
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<script>
(function () {
    if (typeof L === "undefined") return;
    document.querySelectorAll(".map[data-points]").forEach(function (el) {
        var points;
        try { points = JSON.parse(el.getAttribute("data-points")); } catch (e) { return; }
        if (!points || points.length === 0) return;
        var map = L.map(el, { scrollWheelZoom: false });
        L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", { maxZoom: 18, attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors' }).addTo(map);
        var markers = points.map(function (p) {
            var m = L.circleMarker([p.lat, p.lng], { radius: p.chosen ? 9 : 6, weight: p.chosen ? 3 : 1.5, color: p.chosen ? "#b5451b" : "#365a7a", fillColor: p.chosen ? "#e8a07a" : "#9fb8cf", fillOpacity: 0.85 });
            m.bindTooltip(p.label, { permanent: points.length <= 8, direction: "top", offset: [0, -6] });
            return m.addTo(map);
        });
        var group = L.featureGroup(markers);
        if (points.length === 1) map.setView([points[0].lat, points[0].lng], 8);
        else map.fitBounds(group.getBounds().pad(0.3), { maxZoom: 10 });
    });
})();
</script>
