@page "/p/{dataset}/checks"
@model ChecksModel
@{
    ViewData["Title"] = "Checks";
    var likely = Model.Away.Where(a => a.Likely).ToList();
    var look = Model.Away.Where(a => !a.Likely && !a.Outweighed && a.Row.ItemDescription is not null).ToList();
    var elsewhere = Model.Away.Where(a => a.Outweighed && !a.SamePlace).ToList();
    var sameRecord = Model.Away.Where(a => a.Outweighed && a.SamePlace).ToList();
    // the place a row is compared with is a gazetteer's record, or Wikidata's item when the gazetteer link is not known
    string SourceOf(string uri) => uri.Contains("wikidata.org", StringComparison.Ordinal) ? "Wikidata" : "TGN";
    var unknown = Model.Away.Where(a => !a.Likely && !a.Outweighed && a.Row.ItemDescription is null).ToList(); // one a string speaks for is among the likely, not here too
    // the place by its own name and then where it is (the owner, 2026-11-15, at "Glencoe": "why does this not say Glencoe?"; only the
    // chain of its parents was shown). A place in a district of its own name ("Cardiff" in Cardiff, Wales) is not named twice
    // and broadest first (2026-11-17), so that two places of one name are read from what they share to where they part:
    // "United Kingdom › Scotland › Aberdeenshire › Bridgend" over "United Kingdom › Wales › Bridgend"
    List<string> Path(string label, string chain)
    {
        var parts = chain.Split(',').Select(x => x.Trim()).Where(x => x is not ("Europe" or "World") && x.Length > 0).ToList();
        if (parts.Count == 0 || !string.Equals(parts[0], label, StringComparison.OrdinalIgnoreCase)) parts.Insert(0, label);
        parts.Reverse();
        return parts;
    }
    // how many places, from the broadest, every one of the paths shares: what comes after is where they differ
    int Common(List<List<string>> paths)
    {
        if (paths.Count == 0) return 0;
        if (paths.Count == 1) return paths[0].Count - 1;
        var n = 0;
        while (paths.All(p => p.Count - 1 > n) && paths.All(p => string.Equals(p[n], paths[0][n], StringComparison.OrdinalIgnoreCase))) n++;
        return n;
    }
    Microsoft.AspNetCore.Html.HtmlString PathHtml(List<string> path, int common) =>
        new(string.Join(" › ", path.Select((part, i) => i >= common ? $"<strong>{Html.Encode(part)}</strong>" : $"<span class=\"muted\">{Html.Encode(part)}</span>")));
    // a distance in words, where both the item and the place have coordinates
    string Away(AwayRow item, AwayRow place) => item.ItemAt is { } a && place.HomeAt is { } b ? $"· {AwayRow.Km(a, b):N0} km from the import's item" : "";
    // the pairs of the second check are not of one sort (the owner, 2026-11-20: "some of the 'entities that may be one thing' obviously
    // are, and some obviously aren't. It's not a case of expecting them to be mostly the same"): sorted by what the row itself shows.
    // 0 probably one thing; 1 to look at; 2 of different kinds; 3 places of one name in different places
    string Letters(string? x) => new string((x ?? "").Where(char.IsLetterOrDigit).ToArray()).ToLowerInvariant();
    bool Thin(string? about) => about is null || about.StartsWith("identifiers:", StringComparison.Ordinal);
    int Sort(PossibleDuplicate d)
    {
        if (d.AClass != d.BClass) return 2;
        var (la, lb) = (Letters(d.ALabel), Letters(d.BLabel));
        var oneInOther = la.Length >= 6 && lb.Length >= 6 && (la.Contains(lb, StringComparison.Ordinal) || lb.Contains(la, StringComparison.Ordinal));
        if (d.Linked && (d.SameLabel || oneInOther)) return 0;
        if (d.SameLabel && d.AClass == "Type") return 0;
        if (!d.Linked && d.SameLabel && d.AClass == "Place" && !Thin(d.AAbout) && !Thin(d.BAbout) && d.AAbout != d.BAbout) return 3;
        return 1;
    }
    var parts = Model.Duplicates.GroupBy(Sort).ToDictionary(g => g.Key, g => g.ToList());
    List<PossibleDuplicate> Part(int k) => parts.TryGetValue(k, out var list) ? list : [];
}
<h1>Checks</h1>
@if (Model.Plan is null && Model.Check is null) { <p class="muted">Tests run over the project's own entities, each listing what it finds doubtful for a person to decide. Nothing on a list is changed until you say so.</p> }
else if (Model.Check == "places" || Model.Plan is not null) { <p class="muted">Lists of the project's own entities that a test finds doubtful. "Decide…" on a row shows what the entity is aligned to and the records each of its strings is in. There you say of each string whether it is that place or another, and one button does the rest: the entity is kept, mended, or split between the two. Nothing is changed until you press it. The entity's name opens its page, for anything else.</p> }

@if (Model.Message is not null) { <p class="notice">@Model.Message @if (Model.MessageEntity is { } done) { <a href="/p/@Model.Dataset/entity?id=@Uri.EscapeDataString(done.Id)">Open @done.Label</a> }</p> }
@if (Model.Plan is { } plan)
{
    var pe = plan.Entity;
    var first = plan.Homes[0];
    var itemHome = plan.Homes.FirstOrDefault(h => h.HomeUri == plan.Agreeing);
    var paths = plan.Homes.Select(h => Path(h.Label, h.HomeChain)).ToList();
    var common = Common(paths);
    // every string goes by default when the entity, by the identifier it holds or by its strings, is a place its item is not
    var defaultGo = plan.Preselect is not null && plan.Preselect != plan.Agreeing;
    var holdsTgn = pe.Equivalents.Any(q => q.Source == "tgn");
    var agreed = plan.Meant is null ? itemHome : null;
    var qualify = plan.Rival is not null;
    var loc = Model.SuggestedLabel;
    var total = Model.PlanStrings.Count;
    // the map's points: the import's item, and the places of the name at home that TGN gives coordinates for
    var far = first.ItemAt is { } ia ? plan.Homes.Where(h => h.HomeAt is not null).Select(h => AwayRow.Km(ia, h.HomeAt!.Value)).DefaultIfEmpty(0).Max() : 0;
    var points = new List<object>();
    if (first.ItemAt is { } itemAt)
    {
        points.Add(new { lat = itemAt.Lat, lng = itemAt.Long, label = "The import's item: " + (first.ItemDescription ?? pe.Label), chosen = true });
        foreach (var h in plan.Homes.Where(h => h.HomeAt is not null)) points.Add(new { lat = h.HomeAt!.Value.Lat, lng = h.HomeAt.Value.Long, label = string.Join(", ", Path(h.Label, h.HomeChain).AsEnumerable().Reverse().Take(2)), chosen = false });
    }
    <div class="card">
        <h2 style="margin-top:0">Decide "@pe.Label"</h2>
        <p class="small muted">One entity, @total string@(total == 1 ? "" : "s"). Say of each string whether it is the place this entity is aligned to or another place; one button at the foot then does everything. Nothing is changed until you press it. <a href="/p/@Model.Dataset/entity?id=@Uri.EscapeDataString(pe.Id)" target="_blank" rel="noopener">The entity's own page</a></p>
        @if (Model.Pulled is not null) { <p class="notice small">@Model.Pulled</p> }

        <h3>What this entity is aligned to</h3>
        @* where two places part, seen at a glance (the owner's question on pictures, 2026-11-17, and the assistant's answer after 21 rows:
           what it read each time was the chain of places a name is in, and what it wanted was the place where two chains differ). The
           chains are written broadest first, one above the other, and the part that is not common to them all is bold *@
        <table class="paths">
            <tr><td>The import's Wikidata item</td><td>
                @if (itemHome is not null) { <span class="path">@PathHtml(Path(itemHome.Label, itemHome.HomeChain), common)</span> <span class="muted">· @(first.ItemDescription ?? "the same item as that place's")</span> }
                else { <span><strong>@(first.ItemDescription ?? "not in the local index, and nothing known of it")</strong> <span class="muted">· not one of the places called "@pe.Label" in @Model.HomePlace</span></span> }
                <a href="@first.Item" target="_blank" rel="noopener">@first.Item.Split('/')[^1]</a></td></tr>
            @foreach (var h in plan.Homes.Where(h => h.Holds))
            {
                <tr><td>The TGN identifier it holds</td><td><span class="path">@PathHtml(Path(h.Label, h.HomeChain), common)</span> <span class="muted">@(h.HomeKind is null ? "" : "· " + h.HomeKind) @Away(first, h)</span> <a href="@h.HomeUri" target="_blank" rel="noopener">@SourceOf(h.HomeUri) @h.HomeUri.Split('/')[^1]</a></td></tr>
            }
            @foreach (var h in plan.Homes.Where(h => !h.Holds && h.HomeUri != plan.Agreeing).Take(8))
            {
                <tr><td>Also called "@pe.Label"</td><td><span class="path">@PathHtml(Path(h.Label, h.HomeChain), common)</span> <span class="muted">@(h.HomeKind is null ? "" : "· " + h.HomeKind) @Away(first, h)</span> <a href="@h.HomeUri" target="_blank" rel="noopener">@SourceOf(h.HomeUri) @h.HomeUri.Split('/')[^1]</a></td></tr>
            }
        </table>
        @if (plan.Meant is not null && plan.Homes.FirstOrDefault(h => h.HomeUri == plan.Meant) is { } meant)
        {
            <p class="notice small"><strong>Two different places.</strong> The import's item is one place of the name, and @(meant.Holds ? "the TGN identifier this entity holds" : "what its strings say") is another. One of them is wrong; the records below say which. Each string is set to "another place" to begin with, and that place is chosen further down: change either if the records say otherwise.</p>
        }
        else if (itemHome is not null && plan.Homes.Count == 1)
        {
            <p class="notice small"><strong>Probably right.</strong> The item is the only place of this name in @Model.HomePlace. If the records below agree, leave every string as it is and confirm.</p>
        }
        else if (itemHome is not null)
        {
            <p class="notice small">The item is one of @plan.Homes.Count places called "@pe.Label" in @Model.HomePlace. That says which place the item is, not which the records mean: they say below.</p>
        }
        @if (plan.Odd is not null)
        {
            <p class="notice small"><strong>The string "@plan.Odd" may be somewhere else:</strong> its qualifier is not in what the item says. That is often an older county or an abbreviation for the same place ("Bath (Avon)", "Henley on Thames, Oxon"), and sometimes another thing of the name ("Wallington (Northumberland)", a house).</p>
        }
        @* a map only where it tells something: the item and a place of the name at home far apart (the assistant's view, agreed by the owner:
           it says nothing of Compton in Hampshire against Compton in Surrey, and never shows the answer, which is in the records) *@
        @if (points.Count > 1 && far >= 50)
        {
            <details class="small" style="margin-bottom:.8rem"><summary>Map: the import's item and the places called "@pe.Label" in @Model.HomePlace (up to @far.ToString("N0") km apart)</summary>
                <div class="map" style="margin-top:.5rem" data-points='@System.Text.Json.JsonSerializer.Serialize(points)' aria-label="The import's item and the places of the name at home"></div>
            </details>
        }

        <form method="post" asp-page-handler="Apply" id="decide-form">
            <input type="hidden" name="id" value="@pe.Id" />
            <h3>Its strings: is each one this place?</h3>
            @if (total == 0) { <p class="small muted">No string stands on this entity.</p> }
            @foreach (var (ps, recs, count) in Model.PlanStrings)
            {
                <div class="string-line">
                    <div class="small"><strong>"@ps.Raw"</strong> <span class="muted">as @Model.Project.Manifest.FieldName(ps.Context) · in @count.ToString("N0") record@(count == 1 ? "" : "s")</span> <a href="/p/@Model.Dataset/review?id=@ps.Id" target="_blank" rel="noopener">at the desk</a></div>
                    <div class="outcome">
                        @{ var goes = Model.Go is { Length: > 0 } remembered ? remembered.Contains(ps.Id) : defaultGo; }
                        <label><input type="radio" name="outcome[@ps.Id]" value="stay" data-outcome @(goes ? "" : "checked") /> it is the place this entity is aligned to: <strong>it stays</strong></label>
                        <label><input type="radio" name="outcome[@ps.Id]" value="go" data-outcome data-string="@ps.Id" @(goes ? "checked" : "") /> it is another place: <strong>it goes</strong> to the place chosen below</label>
                    </div>
                    <details class="rec-group" @(total <= 3 ? "open" : "")><summary class="small muted">@(count == 1 ? "its record" : recs.Count < count ? $"{recs.Count} of its {count:N0} records" : $"its {count} records")</summary>
                        @foreach (var x in recs)
                        {
                            <p class="small"><strong>@(x.Title ?? "(no title)")</strong>@(x.Date is null ? "" : $" ({x.Date})") <span class="muted">· @x.RecordId</span>
                            @foreach (var (name, values) in x.NamingFields()) { <br /><span class="muted">@name:</span> @string.Join(" · ", values.Take(8))@(values.Count > 8 ? $" · and {values.Count - 8} more" : "") }
                            </p>
                        }
                    </details>
                </div>
            }

            <div class="decide-part" id="other-place">
            <h3>The other place: where the strings that go should stand</h3>
            @if (plan.Preselect is not null) { <p class="small muted">One is chosen for you, the place this entity holds or its strings name; change it if the records say another.</p> }
            else if (plan.Homes.Count > 1 || plan.Others.Count > 0) { <p class="small muted">Choose one: with several to choose among, none is chosen for you.</p> }
            @foreach (var h in plan.Homes)
            {
                var holder = plan.Holders.GetValueOrDefault(h.HomeUri);
                <p class="small"><label style="margin:0; color:inherit; font-size:inherit"><input type="radio" name="home" value="@h.HomeUri" @((plan.Homes.Count == 1 && plan.Others.Count == 0 && Model.Found.Count == 0 && Model.IFound.Count == 0) || h.HomeUri == plan.Preselect ? "checked" : "") /> <span class="path">@PathHtml(Path(h.Label, h.HomeChain), common)</span></label> <a href="@h.HomeUri" target="_blank" rel="noopener">@SourceOf(h.HomeUri) @h.HomeUri.Split('/')[^1]</a> <span class="muted">@(h.HomeKind is null ? "" : $"· {h.HomeKind} ")@Away(first, h)</span><br />
                @if (pe.Equivalents.Any(q => q.Uri == h.HomeUri)) { <span class="muted">This entity holds this identifier already.</span> }
                else if (holder is not null) { <span class="muted">The project has an entity for it, <a href="/p/@Model.Dataset/entity?id=@Uri.EscapeDataString(holder.Id)" target="_blank" rel="noopener">@holder.Label</a>: the strings go there.</span> }
                else { <span class="muted">No entity of the project holds it yet.</span> }</p>
            }
            @* the place meant may not be at home (the owner, 2026-11-15, at "Raleigh", meant for North Carolina): the project's other entities of the name, and any other place *@
            @foreach (var other in plan.Others.Concat(Model.Found))
            {
                var clue = Model.Clues.GetValueOrDefault(other.Id);
                <p class="small"><label style="margin:0; color:inherit; font-size:inherit"><input type="radio" name="home" value="entity:@other.Id" /> <strong>@other.Label</strong>@if (clue.Placement is not null) { <span> (@clue.Placement)</span> } <span class="muted">· the project's entity · @other.Status.ToString().ToLowerInvariant() · @string.Join(" ", other.Equivalents.Select(q => q.Source)) · stands for @clue.Strings string@(clue.Strings == 1 ? "" : "s")</span></label> <a href="/p/@Model.Dataset/entity?id=@Uri.EscapeDataString(other.Id)" target="_blank" rel="noopener">open</a></p>
            }
            @* the searches' fields belong to a form of their own below (the form attribute): a form inside a form is dropped by the browser *@
            <p class="small"><strong>A place the project has under another name:</strong> <input type="search" name="find" form="mend-find" value="@Model.Find" placeholder="Basel" style="width:14rem; display:inline-block" /> <button type="submit" form="mend-find" class="secondary">Search the project's places</button></p>
            @if (!string.IsNullOrWhiteSpace(Model.Find) && Model.Found.Count == 0) { <p class="small muted">No other place of the project matches "@Model.Find".</p> }
            <p class="small"><strong>A place the project does not have yet:</strong> <input type="search" name="ifind" form="mend-find" value="@Model.IFind" placeholder="Kingston Jamaica" title="The place's name, then a word of where it is to tell it from its namesakes" style="width:14rem; display:inline-block" /> <button type="submit" form="mend-find" class="secondary">Search the indexes</button> <span class="muted">TGN, the Library of Congress and Wikidata; a house or a museum may be there as a body</span></p>
            @if (!string.IsNullOrWhiteSpace(Model.IFind) && Model.IFound.Count == 0) { <p class="small muted">The indexes have no place matching "@Model.IFind". Give the place's name as an authority would have it, then a word of where it is ("Kingston Jamaica"); a house by its full name ("Wallington Hall").</p> }
            @if (Model.IFound.Count > 0) { <p class="small muted" style="margin-bottom:.2rem">Tick every record that is the place meant: one place often stands in several indexes, and the entity is given each identifier ticked.</p> }
            @foreach (var rec in Model.IFound)
            {
                <p class="small"><label style="margin:0; color:inherit; font-size:inherit"><input type="checkbox" name="records" value="@rec.Uri" data-record /> <strong>@rec.Label</strong>@if (ChecksModel.ChainOf(rec) is { } where) { <span> (@where)</span> } else if (LinkedArtNet.Alignment.Authorities.RecordSummary.Says(rec) is { } says && says != rec.Label) { <span class="muted"> · @says</span> } <span class="tag">@rec.Source</span>@if (rec.Type != "Place") { <span class="tag" title="The source has it as a body, not a place">@((rec.Type ?? "").ToLowerInvariant())</span> }</label> <a href="@rec.Uri" target="_blank" rel="noopener">@rec.Uri.Split('/')[^1]</a></p>
            }
            <p class="small"><label style="margin:0; color:inherit; font-size:inherit"><input type="radio" name="home" value="other" /> <strong>Another place</strong>, by its identifier:</label> <input type="text" name="otherUri" placeholder="http://vocab.getty.edu/tgn/..." style="width:22rem; display:inline-block" /></p>
            <p class="small muted">If an entity of the project holds the place chosen, the strings go to that entity. If none does and every string goes, this entity is given the place's identifier; if only some go, a new entity is made for the place.</p>
            </div>

            <div class="decide-part" id="stays">
            <h3>This entity, for the strings that stay</h3>
            @* which label (the owner, 2026-11-17): a place at home usually needs no qualifier, and does when a better-known place
               elsewhere has the name ("Boston" is taken for Massachusetts, not Lincolnshire). The choices are there to pick, not to type *@
            <p class="small" style="margin-bottom:.3rem"><strong>Its label</strong> <span class="muted">· @(qualify
                ? $"a qualifier is suggested: the name alone would be taken for a better-known “{pe.Label}” ({plan.Rival!.Value.Description ?? "no description"}; written about in {plan.Rival.Value.Sitelinks})"
                : "the name as it is is suggested, unless the name alone would be taken for somewhere better known")</span></p>
            <p class="small" style="margin:.2rem 0"><label style="margin:0; color:inherit; font-size:inherit"><input type="radio" name="label" value="@pe.Label" @(!qualify || loc is null ? "checked" : "") /> <strong>@pe.Label</strong> <span class="muted">· as it is</span></label></p>
            @if (loc is not null)
            {
                <p class="small" style="margin:.2rem 0"><label style="margin:0; color:inherit; font-size:inherit"><input type="radio" name="label" value="@loc" @(qualify ? "checked" : "") /> <strong>@loc</strong> <span class="muted">· the Library of Congress heading this entity holds</span></label></p>
            }
            <p class="small" style="margin:.2rem 0"><label style="margin:0; color:inherit; font-size:inherit"><input type="radio" name="label" value="" /> another:</label> <input type="text" name="other" placeholder="@pe.Label (…)" style="width:18rem; display:inline-block" /></p>
            @if (!holdsTgn)
            {
                @* right, and without the identifier of the place it is (seen as a user at "Blickling") *@
                var offer = agreed ?? (plan.Homes.Count == 1 ? plan.Homes[0] : null);
                if (offer is not null)
                {
                    <p class="small" style="margin:.6rem 0 .2rem"><label style="margin:0; color:inherit; font-size:inherit"><input type="checkbox" name="addUri" value="@offer.HomeUri" @(agreed is not null ? "checked" : "") /> also give it the identifier of <span class="path">@PathHtml(Path(offer.Label, offer.HomeChain), Path(offer.Label, offer.HomeChain).Count - 1)</span> (<a href="@offer.HomeUri" target="_blank" rel="noopener">@SourceOf(offer.HomeUri) @offer.HomeUri.Split('/')[^1]</a>): it has no TGN identifier@(agreed is null ? "; tick it if the records say this is the place" : "")</label></p>
                }
            }
            <p class="small muted">The entity is confirmed with this label and leaves the list. Nothing is removed from it.</p>
            </div>

            <div class="decide-part" id="removes">
            <h3>This entity's identifiers, when every string goes</h3>
            @* each line says what will happen to its identifier, in words that change with the tick (the owner, 2026-11-22 at "Wallington" and
               2026-11-24 at "Milano (Tex.)": "I definitely removed the identifiers before I clicked mend", and none was removed: the boxes
               come ticked, each said only "remove", and a press to remove one unticked it) *@
            <p class="small muted">The entity was then aligned to the wrong place altogether. The import's identifiers are set to be removed already: they usually describe the same wrong place. One a rule or a person added since is set to be kept. Each line says what will happen to its identifier; press a line to change it.</p>
            @foreach (var q in pe.Equivalents)
            {
                <p class="small"><label style="margin:0; color:inherit; font-size:inherit"><input type="checkbox" name="remove" value="@q.Uri" data-remove="@q.Source" @(q.Method.StartsWith("imported", StringComparison.Ordinal) || q.Method.StartsWith("through", StringComparison.Ordinal) ? "checked" : "") /> <strong data-remove-says>remove</strong> <span class="tag">@q.Source</span> <a href="@q.Uri" target="_blank" rel="noopener" data-remove-what>@q.Uri</a> <span class="muted">· @q.Method@(q.Uri == first.Item ? " · " + (first.ItemDescription ?? "not in the local index") : "")</span></label></p>
            }
            </div>

            <div class="actions" style="margin-top:1.2rem"><button type="submit" id="apply">Apply what is chosen above</button> <a href="/p/@Model.Dataset/checks">Back to the list, nothing changed</a></div>
            <p class="small muted" id="apply-says">Every string that stays: the entity is kept and confirmed. Every string that goes: the entity is mended whole, to the other place. Some of each: those that go are moved, and the entity is confirmed for the rest.</p>
        </form>
        <form id="mend-find" method="get" data-keep-place><input type="hidden" name="mend" value="@pe.Id" /></form>

        @if (plan.Swap is { } swap)
        {
            @* the third answer (the owner, 2026-11-24, at "West Sussex (England)", whose item was a military unit): the entity is the place its
               strings mean and only its Wikidata item is another record. Confirming would keep the wrong item; mending whole would lose the
               heading that is right *@
            <div class="decide-part">
            <h3>Or: it is this place, and only its Wikidata item is wrong</h3>
            @* the person chooses the record (the owner at "Kingston-upon-Thames", 2026-11-24: the best-known record of the name was the
               Royal Borough, and the strings, places of publication, mean the town, the second on the list) *@
            <p class="small">Its item says it is: <strong>@(swap.ItemDescription ?? "nothing")</strong>. Wikidata's places of this name, the most written-about first: choose the one the strings above mean. The best-known is not always it: a town and the district or borough named for it are separate records.</p>
            <form method="post" asp-page-handler="SwapItem">
                <input type="hidden" name="id" value="@pe.Id" />
                @foreach (var c in plan.SwapItems)
                {
                    <p class="small"><label style="margin:0; color:inherit; font-size:inherit"><input type="radio" name="item" value="@c.Record.Uri" /> <strong>@c.Record.Label</strong> · @(LinkedArtNet.Alignment.Authorities.RecordSummary.Says(c.Record) ?? "no description") <span class="muted">· written about in @c.Sitelinks@(c.Gazetteer is null ? "" : " · names the gazetteer's " + c.Gazetteer)</span></label> <a href="@c.Record.Uri" target="_blank" rel="noopener">@c.Record.Uri.Split('/')[^1]</a></p>
                }
                @if (plan.SwapItems.Count == 0) { <p class="small muted">The local index has no other Wikidata place of this name. The entity's own page can add an identifier by its address.</p> }
                @if (plan.SwapGazetteer.Count > 0)
                {
                    <p class="small" style="margin-top:.6rem">The gazetteer's places of this name. The one the record chosen names is added with it; tick another here if that is the place and the record names none:</p>
                    @foreach (var g in plan.SwapGazetteer)
                    {
                        <p class="small"><label style="margin:0; color:inherit; font-size:inherit"><input type="checkbox" name="gazetteer" value="@g.Uri" /> <strong>@g.Label</strong> <span class="muted">@(ReviewService.ChainOf(g) ?? "")</span></label> <a href="@g.Uri" target="_blank" rel="noopener">TGN @g.Uri.Split('/')[^1]</a></p>
                    }
                }
                <div class="actions"><button type="submit" class="secondary" @(plan.SwapItems.Count == 0 ? "disabled" : "")>Replace its Wikidata item with the record chosen</button></div>
            </form>
            <p class="small muted">The item is taken off the entity and the one chosen put in its place, with the gazetteer's record where the project has that nowhere else. The label, the strings and the other identifiers stay as they are.</p>
            </div>
        }
        <div class="decide-part">
        <h3>Not sure, or it wants more than this screen can do: leave it</h3>
        <form method="post" asp-page-handler="Note">
            <input type="hidden" name="id" value="@pe.Id" />
            <textarea name="text" rows="2" placeholder="What is wrong, and what you could not do here"></textarea>
            <div class="actions"><button type="submit" class="secondary">Leave it on the list, with this note</button></div>
        </form>
        <p class="small muted">Nothing is decided. The note is kept on the entity, and the row stays on the list until someone confirms or mends it.</p>
        </div>
    </div>
    @* the parts of the form that do not apply to what is chosen are folded away, and the button says what it will do; without scripts every
       part shows and the line under the button explains *@
    <script>
    (function () {
        var form = document.getElementById("decide-form");
        if (!form) return;
        function show(id, on) { var el = document.getElementById(id); if (el) el.hidden = !on; }
        // a search has been made: its results are shown whatever is chosen; and a search carries which strings were set to go
        var searched = @((!string.IsNullOrWhiteSpace(Model.Find) || !string.IsNullOrWhiteSpace(Model.IFind)) ? "true" : "false");
        var finder = document.getElementById("mend-find");
        if (finder) finder.addEventListener("submit", function () {
            finder.querySelectorAll("input[name=go]").forEach(function (x) { x.remove(); });
            form.querySelectorAll("input[data-string]:checked").forEach(function (r) { var h = document.createElement("input"); h.type = "hidden"; h.name = "go"; h.value = r.getAttribute("data-string"); finder.appendChild(h); });
        });
        function update() {
            form.querySelectorAll("input[data-remove]").forEach(function (c) {
                var line = c.closest("label"), says = line && line.querySelector("[data-remove-says]"), what = line && line.querySelector("[data-remove-what]");
                if (says) says.textContent = c.checked ? "will be removed:" : "will be kept:";
                if (what) what.style.textDecoration = c.checked ? "line-through" : "";
            });
            var chosen = form.querySelectorAll("input[data-outcome]:checked");
            var total = chosen.length, go = 0;
            chosen.forEach(function (r) { if (r.value === "go") go++; });
            show("other-place", go > 0 || searched); show("stays", go < total || total === 0); show("removes", total > 0 && go === total);
            var b = document.getElementById("apply"), says = document.getElementById("apply-says");
            if (go === 0) { b.textContent = total <= 1 ? "Confirm: it is this place" : "Confirm: all " + total + " strings are this place"; says.textContent = "The entity is kept and confirmed, with the label chosen. Nothing is removed from it."; }
            else if (go === total) { b.textContent = total === 1 ? "Mend: it is the other place" : "Mend: all " + total + " strings are the other place"; var gone = [], kept = []; form.querySelectorAll("input[data-remove]").forEach(function (c) { (c.checked ? gone : kept).push(c.getAttribute("data-remove")); });
                says.textContent = (gone.length ? "Removed from this entity: " + gone.join(", ") + ". " : "Nothing is removed from this entity. ") + (kept.length ? "Kept on it: " + kept.join(", ") + ". " : "") + "Then it is merged into the project's entity for the other place, or given that place's identifier"+ (form.querySelectorAll("input[data-record]:checked").length > 1 ? "s, each one ticked." : "."); }
            else { b.textContent = "Move " + go + " string" + (go === 1 ? "" : "s") + " to the other place, and confirm this entity for the other " + (total - go); says.textContent = "The strings that go are decided onto the other place. This entity keeps its identifiers and is confirmed for the strings that stay."; }
        }
        form.addEventListener("change", function (e) {
            var x = e.target; if (!x || !x.hasAttribute) return;
            // a record ticked is the other place: the single choices above and below it are let go, and the other way about
            if (x.hasAttribute("data-record") && x.checked) form.querySelectorAll("input[name=home]").forEach(function (r) { r.checked = false; });
            if (x.name === "home" && x.checked) form.querySelectorAll("input[data-record]").forEach(function (c) { c.checked = false; });
            if (x.hasAttribute("data-outcome") || x.hasAttribute("data-remove") || x.hasAttribute("data-record") || x.name === "home") update();
        });
        update();
    })();
    </script>
    @if (points.Count > 1 && far >= 50) { <partial name="_Map" /> }
}
