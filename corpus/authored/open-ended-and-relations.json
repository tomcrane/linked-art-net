{
  "$schema": "../schema/corpus-entry.schema.json",
  "source": {
    "name": "Authored: open ends, relations, hedges and sets",
    "licence": "CC0-1.0",
    "notes": "Open-ended ranges, before/after/by/until/since/not before/not after, circa and question marks, 'or' sets, inverted ranges and undated markers. Default profile: an open bound is omitted ('before X' gives only end_of_the_end, ending a second before X; 'by X' includes X), hedges are flags only. Expectations checked by hand."
  },
  "defaults": { "intent": "single", "profile": "default", "status": "verified", "tags": ["relation"] },
  "entries": [
    { "id": "rel-001", "input": "before 1850", "tags": ["before"],
      "expect": { "status": "parsed", "canonical": "before 1850", "edtf": "../1849",
        "timespan": { "end_of_the_end": "1849-12-31T23:59:59Z" }, "flags": ["OpenStart"] } },
    { "id": "rel-002", "input": "after 1850", "tags": ["after"],
      "expect": { "status": "parsed", "canonical": "after 1850", "edtf": "1851/..",
        "timespan": { "begin_of_the_begin": "1851-01-01T00:00:00Z" }, "flags": ["OpenEnd"] } },
    { "id": "rel-003", "input": "by 1850", "tags": ["by"],
      "expect": { "status": "parsed", "canonical": "by 1850", "edtf": "../1850",
        "timespan": { "end_of_the_end": "1850-12-31T23:59:59Z" } } },
    { "id": "rel-004", "input": "until 1850", "tags": ["until"],
      "expect": { "status": "parsed", "canonical": "until 1850", "timespan": { "end_of_the_end": "1850-12-31T23:59:59Z" } } },
    { "id": "rel-005", "input": "since 1850", "tags": ["since"],
      "expect": { "status": "parsed", "canonical": "not-before 1850", "timespan": { "begin_of_the_begin": "1850-01-01T00:00:00Z" } },
      "notes": "'since' includes the year it names." },
    { "id": "rel-006", "input": "not before 1850", "tags": ["not-before"],
      "expect": { "status": "parsed", "canonical": "not-before 1850", "timespan": { "begin_of_the_begin": "1850-01-01T00:00:00Z" } } },
    { "id": "rel-007", "input": "not after 1850", "tags": ["not-after"],
      "expect": { "status": "parsed", "canonical": "not-after 1850", "timespan": { "end_of_the_end": "1850-12-31T23:59:59Z" } } },
    { "id": "rel-008", "input": "ante 1850", "tags": ["before", "latin"],
      "expect": { "status": "parsed", "canonical": "before 1850" } },
    { "id": "rel-009", "input": "post-1945", "tags": ["after", "hyphenated"],
      "expect": { "status": "parsed", "canonical": "after 1945", "timespan": { "begin_of_the_begin": "1946-01-01T00:00:00Z" } } },
    { "id": "rel-010", "input": "pre-war", "tags": ["idiom"],
      "expect": { "status": "unparsed" },
      "notes": "No date in the text." },
    { "id": "rel-011", "input": "1971-", "tags": ["open-end", "trailing-dash"],
      "expect": { "status": "parsed", "canonical": "1971/..", "edtf": "1971/..",
        "timespan": { "begin_of_the_begin": "1971-01-01T00:00:00Z" }, "flags": ["OpenEnd"] } },
    { "id": "rel-012", "input": "-1850", "tags": ["open-start", "leading-dash"],
      "expect": { "status": "parsed", "canonical": "../1850", "timespan": { "end_of_the_end": "1850-12-31T23:59:59Z" }, "flags": ["OpenStart"] },
      "notes": "Catalogue convention; EDTF would read 1851 BCE. The profile policy LeadingDashIsOpenStart (default true) decides, and the EDTF reading is kept as an alternative." },
    { "id": "rel-013", "input": "1971 - present", "tags": ["open-end", "present"],
      "expect": { "status": "parsed", "canonical": "1971/..", "flags": ["OpenEnd"] } },
    { "id": "rel-014", "input": "1971 onwards", "tags": ["open-end"],
      "expect": { "status": "parsed", "canonical": "1971/.." } },
    { "id": "rel-015", "input": "between 1870 and 1890", "tags": ["range", "between"],
      "expect": { "status": "parsed", "canonical": "1870/1890", "edtf": "1870/1890",
        "timespan": { "begin_of_the_begin": "1870-01-01T00:00:00Z", "end_of_the_end": "1890-12-31T23:59:59Z" } } },
    { "id": "rel-016", "input": "1870 to 1890", "tags": ["range", "to"],
      "expect": { "status": "parsed", "canonical": "1870/1890" } },
    { "id": "rel-017", "input": "1870/1890", "tags": ["range", "slash"],
      "expect": { "status": "parsed", "canonical": "1870/1890", "minConfidence": 0.99 } },
    { "id": "rel-018", "input": "1870–1890", "tags": ["range", "en-dash"],
      "expect": { "status": "parsed", "canonical": "1870/1890" } },
    { "id": "rel-019", "input": "1998-1902", "tags": ["range", "inverted"],
      "expect": { "status": "parsed", "canonical": "1998/1902",
        "timespan": { "begin_of_the_begin": "1902-01-01T00:00:00Z", "end_of_the_end": "1998-12-31T23:59:59Z" }, "flags": ["Inverted"], "maxConfidence": 0.8 } },
    { "id": "rel-020", "input": "1904 or 1905", "tags": ["disjunction"],
      "expect": { "status": "parsed", "canonical": "[1904,1905]", "edtf": "[1904,1905]",
        "timespan": { "begin_of_the_begin": "1904-01-01T00:00:00Z", "end_of_the_end": "1905-12-31T23:59:59Z" }, "flags": ["Disjunction"] } },
    { "id": "rel-021", "input": "1904 or 1905 or 1906", "tags": ["disjunction"],
      "expect": { "status": "parsed", "canonical": "[1904,1905,1906]" } },
    { "id": "rel-022", "input": "c. 1850", "tags": ["circa"],
      "expect": { "status": "parsed", "canonical": "1850~", "edtf": "1850~", "flags": ["Approximate"],
        "timespan": { "begin_of_the_begin": "1850-01-01T00:00:00Z", "end_of_the_end": "1850-12-31T23:59:59Z" } } },
    { "id": "rel-023", "input": "circa 1850", "tags": ["circa", "word"],
      "expect": { "status": "parsed", "canonical": "1850~" } },
    { "id": "rel-024", "input": "about 1850", "tags": ["circa", "word"],
      "expect": { "status": "parsed", "canonical": "1850~" } },
    { "id": "rel-025", "input": "approximately 1850", "tags": ["circa", "word"],
      "expect": { "status": "parsed", "canonical": "1850~" } },
    { "id": "rel-026", "input": "1850?", "tags": ["uncertain"],
      "expect": { "status": "parsed", "canonical": "1850?", "flags": ["Uncertain"] } },
    { "id": "rel-027", "input": "probably 1850", "tags": ["uncertain", "word"],
      "expect": { "status": "parsed", "canonical": "1850?" } },
    { "id": "rel-028", "input": "c. 1850?", "tags": ["circa", "uncertain"],
      "expect": { "status": "parsed", "canonical": "1850%", "flags": ["Approximate", "Uncertain"] } },
    { "id": "rel-029", "input": "n.d.", "tags": ["undated"],
      "expect": { "status": "undated", "canonical": "undated" } },
    { "id": "rel-030", "input": "undated", "tags": ["undated"],
      "expect": { "status": "undated" } },
    { "id": "rel-031", "input": "s.d.", "tags": ["undated", "latin"],
      "expect": { "status": "undated" } },
    { "id": "rel-032", "input": "no date", "tags": ["undated"],
      "expect": { "status": "undated" } },
    { "id": "rel-033", "input": "", "tags": ["empty"],
      "expect": { "status": "unparsed" } },
    { "id": "rel-034", "input": "?", "tags": ["uncertain", "no-date"],
      "expect": { "status": "unparsed" } },
    { "id": "rel-035", "input": "Winter 1945", "tags": ["season"],
      "expect": { "status": "parsed", "canonical": "1945-24", "edtf": "1945-24",
        "timespan": { "begin_of_the_begin": "1945-12-01T00:00:00Z", "end_of_the_end": "1946-02-28T23:59:59Z" }, "flags": ["Season"] } },
    { "id": "rel-036", "input": "Spring 1890", "tags": ["season"],
      "expect": { "status": "parsed", "canonical": "1890-21",
        "timespan": { "begin_of_the_begin": "1890-03-01T00:00:00Z", "end_of_the_end": "1890-05-31T23:59:59Z" } } }
  ]
}
