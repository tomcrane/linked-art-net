@page "/p/{dataset}/entity"
@model EntityModel
@{
    var v = Model.View;
    var e = v.Entity;
    ViewData["Title"] = e.Label ?? "Entity";
    var back = Url.Page("/Projects/Entity", new { dataset = Model.Dataset, id = e.Id });
}
@if (Model.Message is not null) { <p class="notice">@Model.Message</p> }
<p class="small muted"><a href="/p/@Model.Dataset/entities">Entities</a> › <code>@e.Id</code></p>
<h1 style="margin-top:0">@e.Label <span class="tag">@e.Class.ToString().ToLowerInvariant()</span> <span class="tag">@e.Status.ToString().ToLowerInvariant()</span>
    @if (v.IsCompound) { <a class="tag" href="#parts" title="A compound heading's own concept, coordinated from its parts, listed below">compound</a> }
    @if (e.Status != EntityStatus.Merged) { <button type="button" class="tray-add small" data-tray="@e.Id" data-tray-label="@e.Label">Add to tray</button> }
    @* desk work under this name is signalled at the top, where the eye lands, with the list further down (the owner, 2026-11-06) *@
    @if (Model.Waiting.Count + Model.OwnQueued.Count > 0) { <a class="tag src" href="@(Model.Waiting.Count > 0 ? "#waiting" : "#strings")" title="Queued strings under this name, and this entity's own strings still at the desk">@(Model.Waiting.Count + Model.OwnQueued.Count) waiting at the desk</a> }</h1>
@if (e.Status == EntityStatus.Provisional && e.Equivalents.Count == 0)
{
    @* a placeholder is a run's, and what is changed on it by hand goes when the run is taken back (the owner, 2026-11-14, having
       changed the class of the publisher placeholder "Osterley Park" to join it to the place: "But I already edited the placeholder
       no?"). The page says so before anything else and sends the reviewer to the desk, where a decision on the string lasts *@
    <div class="notice placeholder-note">
        <p><strong>This is a placeholder, not yet a decision.</strong> The software made it to stand in for @(v.Strings.Count == 1 ? "its string" : "its strings") until someone decides what @(v.Strings.Count == 1 ? "it means" : "they mean"). It lasts only as long as the run that made it: a label, a class or an identifier changed here, or a merge, is lost when the rules are next run.</p>
        @if (v.Strings.Count > 0)
        {
            <p><strong>To settle it, decide the string at the desk</strong>, where a decision is kept:
            @{ var n = 0; }
            @foreach (var ds in v.Strings.OrderByDescending(x => x.String.Occurrences).Take(5))
            {
                <text>@(n++ == 0 ? "" : " · ")</text><a href="/p/@Model.Dataset/review?id=@ds.String.Id">"@ds.String.Raw" (@Model.Project.Manifest.FieldName(ds.String.Context))</a>
            }@(v.Strings.Count > 5 ? $" · and {v.Strings.Count - 5} more, listed below" : "")</p>
            <p class="small muted">There you can say it is the same as an entity the project already has, accept a record for it, or keep it as a local authority.</p>
        }
    </div>
}
@if (e.Status != EntityStatus.Merged)
{
    @* what the entity is, said first and plainly (the owner, 2026-11-13, at the bare "Dagenham", about to relabel it after its wrong
       identifiers: "we need to somehow make this super-clear in the UI"): an entity is what its strings mean, so the strings, their
       fields and the records they were seen in stand at the head of the page, above the label's facts and the identifiers *@
    var top = v.Strings.OrderByDescending(x => x.String.Occurrences).Take(3).ToList();
    <div class="stands">
        @if (v.Strings.Count == 0)
        {
            <p><strong>No string of the catalogue resolves to this entity.</strong> It stands for nothing at present: its label and identifiers describe it, and nothing in the records uses it.</p>
        }
        else
        {
            <p><strong>This entity stands for @v.Strings.Count string@(v.Strings.Count == 1 ? "" : "s") of the catalogue, and is whatever @(v.Strings.Count == 1 ? "it means" : "they mean"):</strong></p>
            <ul>
            @foreach (var ds in top)
            {
                var seenIn = Model.Examples.Where(x => x.String.Id == ds.String.Id).SelectMany(x => x.Examples).Take(2).ToList();
                <li><strong class="stands-string">"@ds.String.Raw"</strong> as <span class="tag" title="the field @ds.String.Context">@Model.Project.Manifest.FieldName(ds.String.Context)</span>@if (Model.Project.Manifest.FieldAbout(ds.String.Context) is { } about) { <span class="small muted"> (@about)</span> }, seen @ds.String.Occurrences time@(ds.String.Occurrences == 1 ? "" : "s")@if (seenIn.Count > 0) { <text>, in </text>@for (var n = 0; n < seenIn.Count; n++) { <text>@(n == 0 ? "" : "; ")<em>@(seenIn[n].Title ?? seenIn[n].RecordId)</em>@(seenIn[n].Date is null ? "" : $" ({seenIn[n].Date})")</text> } }</li>
            }
            </ul>
            @if (v.Strings.Count > top.Count) { <p class="small">and @(v.Strings.Count - top.Count) more: <a href="#strings">all the strings</a>.</p> }
            <p class="small muted">The label and the identifiers below should describe what @(v.Strings.Count == 1 ? "this string means" : "these strings mean") in @(v.Strings.Count == 1 ? "its record" : "their records"). An identifier that describes something else is wrong here, however well the name matches: remove it, and leave the label to say what the strings mean.</p>
        }
    </div>
}
<div class="grid">
    <div>
        @if (Model.Picture is { ThumbUrl: { } thumbUrl } picture)
        {
            @* the first picture a pull brought, with the attribution Commons' licences require beside it, never without (plan section 7) *@
            <figure class="picture"><a href="@picture.FilePage" target="_blank" rel="noopener"><img src="@thumbUrl" alt="@picture.FileName" loading="lazy" /></a><figcaption class="small muted">@picture.Attribution · <a href="@picture.FilePage" target="_blank" rel="noopener">Commons</a></figcaption></figure>
        }
        @if (Model.Coordinates is { } at)
        {
            @* the map (the owner, 2026-11-08): where the entity is, from TGN's coordinates or a pull's; Leaflet over OpenStreetMap tiles, attribution kept *@
            <div id="map" class="map" data-points='@System.Text.Json.JsonSerializer.Serialize(new[] { new { lat = at.Lat, lng = at.Long, label = (e.Label ?? e.Id) + (at.Near is null ? "" : $", near {at.Near}"), chosen = true, approximate = at.Approximate } })' aria-label="Map"></div>
            @if (at.Approximate) { <p class="small muted" style="margin-top:-.6rem">The marker stands at @at.Near, the record's TGN parent: the record itself carries no coordinates.</p> }
        }
        <dl class="facts">
            @if (e.Labels.Any(l => l != e.Label)) { <dt>Also</dt><dd>@string.Join(" · ", e.Labels.Where(l => l != e.Label))</dd> }
            @if (e.Lifespan?.Display is { } life) { <dt>Dates</dt><dd>@life</dd> }
            @if (e.Nationalities.Count > 0) { <dt>Nationality</dt><dd>@string.Join(", ", e.Nationalities)</dd> }
            @if (e.Roles.Count > 0) { <dt>Roles</dt><dd>@string.Join(", ", e.Roles)</dd> }
            <dt>Created</dt><dd>@e.CreatedAt.ToString("yyyy-MM-dd")@(e.RunId is null ? "" : $" in run {e.RunId}")</dd>
        </dl>

        @if (v.IsCompound)
        {
            @* a compound heading's concept says what it is coordinated from (the owner, 2026-11-07, at "Ackermann & Son, Arthur (London)--History") *@
            <h2 id="parts">A compound heading</h2>
            <p class="small muted">A concept of the project coordinated from its parts, each a string of its own with its own decision; the heading holds no identifier itself.</p>
            <table>
                <thead><tr><th>Part</th><th>Context</th><th>Resolves to</th></tr></thead>
                <tbody>
                @foreach (var p in v.Parts)
                {
                    <tr><td>@p.Part.Raw</td><td class="small">@p.Part.Context</td>
                        <td class="small">
                            @if (p.Entity is not null) { <a href="/p/@Model.Dataset/entity?id=@Uri.EscapeDataString(p.Entity.Id)">@p.Entity.Label</a> <span class="tag">@p.Entity.Class.ToString().ToLowerInvariant()</span> <span class="tag">@p.Entity.Status.ToString().ToLowerInvariant()</span> }
                            @if (p.Decision is null) { <span class="muted">undecided</span> }
                            else { <span class="muted">@p.Decision.Method</span> @if (p.Decision.Method == DecisionMethod.Queued) { <a href="/p/@Model.Dataset/review?id=@p.Part.Id">at the desk</a> } }
                        </td></tr>
                }
                </tbody>
            </table>
        }
        <h2>Identifiers</h2>
        @if (e.Equivalents.Count == 0) { <p class="muted">None@(v.IsCompound ? "" : ": a local authority").</p> }
        @* the identifiers in their sets (the owner, 2026-11-13, at the bare "Dagenham": Wikidata's parliamentary constituency, its VIAF
           number and nothing on the page to say so): those that cite one another are boxed together under what they are, each row says
           what its record is, a VIAF number through the record that gives it, and a set is removed as one *@
        @{
            var sets = LinkedArtNet.Alignment.Authorities.IdentifierSets.Of(e.Equivalents.Select(q => q.Uri).ToList(), v.Records);
            var grouped = sets.Any(s => s.Count > 1);
        }
        @if (grouped && sets.Count > 1) { <p class="small muted">Identifiers that cite one another are boxed together. Sets that describe different things are a sign the entity is aligned to two things, or was merged from two.</p> }
        @foreach (var set in sets)
        {
            var members = set.Select(u => e.Equivalents.First(q => q.Uri == u)).ToList();
            var about = members.Select(q => v.Records.GetValueOrDefault(q.Uri)).Where(r => r is not null)
                .OrderByDescending(r => r!.Source == "wikidata").Select(r => LinkedArtNet.Alignment.Authorities.RecordSummary.Says(r)).FirstOrDefault(x => x is not null);
            <div class="@(grouped ? "idset" : "")">
            @if (set.Count > 1)
            {
                <div class="row idset-head">
                    <div style="flex:1"><strong>@(about ?? "A set")</strong> <span class="small muted">· @set.Count identifiers that cite one another</span></div>
                    <form method="post" asp-page-handler="RemoveEquivalents" class="inline">
                        <input type="hidden" name="id" value="@e.Id" />
                        @foreach (var q in members) { <input type="hidden" name="uris" value="@q.Uri" /> }
                        <button type="submit" class="quiet" title="Removes every identifier of this set from the entity; each removal is noted">Remove all @set.Count</button>
                    </form>
                </div>
            }
            <table>
                <tbody>
                @foreach (var q in members)
                {
                    v.Records.TryGetValue(q.Uri, out var record);
                    var giver = record is null ? LinkedArtNet.Alignment.Authorities.IdentifierSets.CitedBy(q.Uri, v.Records.Values) : null;
                    <tr>
                        <td><a class="tag src" href="@q.Uri" target="_blank" rel="noopener" title="@q.Uri">@q.Source</a></td>
                        <td><a href="@q.Uri" target="_blank" rel="noopener">@q.Uri</a>
                            @if (record is not null) { <div class="small muted">@{ var said = LinkedArtNet.Alignment.Authorities.RecordSummary.Says(record); var recLife = record.Lifespan?.Display; }@said @(recLife is not null && said is not null && said.Contains(recLife) ? null : recLife)</div> }
                            else if (giver is not null) { <div class="small muted">the @q.Source identifier that @giver.Source's @giver.Uri.TrimEnd('/').Split('/').Last() gives (@LinkedArtNet.Alignment.Authorities.RecordSummary.Says(giver))</div> }
                            else { <div class="small muted">no record of it in the store@(LinkedArtNet.Alignment.Authorities.SourcePull.CanPull(q.Uri) ? "; \"Pull in from the sources\" below asks it what it is" : "")</div> }
                        </td>
                        <td class="small muted">@q.Method @q.Confidence.ToString("0.00")</td>
                        <td><form method="post" asp-page-handler="RemoveEquivalent" class="inline"><input type="hidden" name="id" value="@e.Id" /><input type="hidden" name="uri" value="@q.Uri" /><button type="submit" class="quiet">Remove</button></form></td>
                    </tr>
                }
                </tbody>
            </table>
            </div>
        }
        @* two ways to add an identifier, as two rows of one grid, label, field, button, so they line up (the owner, 2026-11-08) *@
        <form method="post" asp-page-handler="AddEquivalent" class="labelled" style="margin-top:.6rem">
            <input type="hidden" name="id" value="@e.Id" />
            <label for="uri" class="small muted">Add a URI</label>
            <input type="text" id="uri" name="uri" placeholder="http://vocab.getty.edu/ulan/… or another authority URI" />
            <button type="submit" class="secondary">Add identifier</button>
        </form>
        <form method="get" class="labelled">
            <input type="hidden" name="id" value="@e.Id" />
            <label for="find" class="small muted">or search the indexes</label>
            <input type="search" id="find" name="find" value="@(Model.Find ?? e.Label)" />
            <button type="submit" class="secondary">Search</button>
        </form>
        @if (Model.Find is not null)
        {
            @if (Model.Found.Count == 0) { <p class="small muted">Nothing found for "@Model.Find" that is not already an identifier here.</p> }
            @foreach (var r in Model.Found)
            {
                <div class="row result"><div style="flex:1"><strong>@r.Label</strong> @if (r.Lifespan?.Display is { } l) { <span class="muted">@l</span> } <span class="tag">@r.Type?.ToLowerInvariant()</span> <span class="tag">@r.Source</span><br /><a class="small" href="@r.Uri" target="_blank" rel="noopener">@r.Uri</a></div>
                    <form method="post" asp-page-handler="AddEquivalent" class="inline"><input type="hidden" name="id" value="@e.Id" /><input type="hidden" name="uri" value="@r.Uri" /><button type="submit" class="secondary">Add as identifier</button></form></div>
            }
        }

        @if (!v.IsCompound)
        {
            @* From the sources, on demand (the owner, 2026-11-08): what Wikidata (and through it Wikipedia and Commons), ULAN, the Library
               of Congress and LUX say about this entity, fetched when asked and kept on the records; nothing is fetched to show the page *@
            <h2 id="sources">From the sources</h2>
            @if (Model.Pullable.Count == 0) { <p class="small muted">Nothing to pull: none of the identifiers is in Wikidata, ULAN, the Library of Congress or LUX.</p> }
            else
            {
                <form method="post" asp-page-handler="Pull" class="row" style="gap:.6rem; align-items:center">
                    <input type="hidden" name="id" value="@e.Id" />
                    <button type="submit" class="secondary" title="Fetch what each source says now and keep it here; pressed again, it refreshes">@(Model.Pulled.Count == 0 ? "Pull in from the sources" : "Pull in again")</button>
                    <span class="small muted">@Model.Pullable.Count identifier@(Model.Pullable.Count == 1 ? "" : "s") with a live record@(Model.Pulled.Count == 0 ? ", not yet pulled" : $"; last pulled {Model.Pulled.Values.Max(p => p.At).ToLocalTime():yyyy-MM-dd HH:mm}"). Each fact is the source's own, dated; nothing here is ours.</span>
                </form>
                @foreach (var q in Model.Pullable)
                {
                    var p = Model.Pulled.GetValueOrDefault(q.Uri);
                    <div class="card source">
                        <div class="source-head">
                            <span class="tag src">@q.Source</span>
                            <strong>@(p?.Label ?? q.Uri.Split('/').Last())</strong>
                            @if (p is not null) { <span class="small muted">pulled @p.At.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span> }
                            <form method="post" asp-page-handler="Pull" class="inline"><input type="hidden" name="id" value="@e.Id" /><input type="hidden" name="uri" value="@q.Uri" /><button type="submit" class="quiet small">@(p is null ? "pull" : "refresh")</button></form>
                        </div>
                        <div class="small muted uri"><a href="@q.Uri" target="_blank" rel="noopener">@q.Uri</a></div>
                        @if (p is null) { <p class="small muted">Not pulled yet.</p> }
                        else
                        {
                            @if (p.SelfEcho) { <p class="notice small" style="margin:.4rem 0">@p.Note</p> }
                            else if (p.Note is not null) { <p class="small muted">@p.Note</p> }
                            @if (p.Picture is { ThumbUrl: { } th } pic) { <figure class="picture small"><a href="@pic.FilePage" target="_blank" rel="noopener"><img src="@th" alt="@pic.FileName" loading="lazy" /></a><figcaption class="small muted">@pic.Attribution</figcaption></figure> }
                            @if (p.Description is not null) { <p>@p.Description</p> }
                            @if (p.Aliases.Count > 0) { <p class="small muted">also: @string.Join(" · ", p.Aliases)</p> }
                            @if (p.Extract is not null) { <p class="small">@p.Extract @if (p.ExtractUrl is not null) { <a href="@p.ExtractUrl" target="_blank" rel="noopener">@(p.ExtractFrom ?? "source")</a> }</p> }
                            @if (p.Facts.Count > 0)
                            {
                                <dl class="facts small">
                                @foreach (var f in p.Facts) { <dt>@f.Key</dt><dd>@if (f.Url is not null) { <a href="@f.Url" target="_blank" rel="noopener">@f.Value</a> } else { @f.Value }</dd> }
                                </dl>
                            }
                            @if (p.Lat is { } lat && p.Long is { } lon) { <p class="small muted">at @lat.ToString("0.0000"), @lon.ToString("0.0000")</p> }
                            @if (!p.HasAnything) { <p class="small muted">The source answered with nothing to show.</p> }
                        }
                    </div>
                }
            }
        }

        @if (Model.Examples.Count > 0)
        {
            <h2>In the records</h2>
            <div class="card">
            @foreach (var (s, examples) in Model.Examples)
            {
                <p class="small muted" style="margin-bottom:.2rem">as "@s.Raw", @Model.Project.Manifest.FieldName(s.Context)</p>
                @foreach (var x in examples)
                {
                    <p class="small"><strong>@(x.Title ?? "(no title)")</strong>@(x.Date is null ? "" : $" ({x.Date})") <span class="muted">· @x.RecordId · from &lt;@x.Field&gt;</span>
                    @foreach (var (name, values) in x.NamingFields()) { <br /><span class="muted">@name:</span> @string.Join(" · ", values) }
                    </p>
                }
            }
            </div>
        }

        @if (Model.Waiting.Count > 0)
        {
            <h2 id="waiting">Waiting at the desk under this name (@Model.Waiting.Count)</h2>
            <p class="small">
            @for (var i = 0; i < Model.Waiting.Count; i++)
            {
                var w = Model.Waiting[i];
                if (i > 0) { <text> · </text> }
                <a href="/p/@Model.Dataset/review?id=@w.String.Id">"@w.String.Raw" (@Model.Project.Manifest.FieldName(w.String.Context))</a>
            }
            </p>
        }
        <h2 id="strings">Strings that resolve here (@v.Strings.Count)</h2>
        <form method="post" asp-page-handler="Reopen">
            <input type="hidden" name="id" value="@e.Id" />
            <table>
                <thead><tr><th></th><th>String</th><th>Context</th><th>Decided</th></tr></thead>
                <tbody>
                @foreach (var s in v.Strings)
                {
                    <tr><td><input type="checkbox" name="strings" value="@s.String.Id" aria-label="select" /></td><td>@s.String.Raw</td><td class="small"><span title="the field @s.String.Context">@Model.Project.Manifest.FieldName(s.String.Context)</span> ×@s.String.Occurrences</td><td class="small muted">@if (s.Decision.Method == DecisionMethod.Queued) { <a href="/p/@Model.Dataset/review?id=@s.String.Id" title="Waiting at the desk: open it there">queued · at the desk</a> } else { @s.Decision.Method }@(s.Decision.Reviewer is null ? "" : $" · {s.Decision.Reviewer}")</td></tr>
                }
                </tbody>
            </table>
            @if (v.Strings.Count > 0) { <div class="actions"><button type="submit" class="quiet" title="Take the selected strings away from this entity; they are undecided again and the next reconcile reconsiders them">Reopen selected strings</button></div> }
        </form>
    </div>
    <div>
        <form method="post" asp-page-handler="Label" class="card">
            <input type="hidden" name="id" value="@e.Id" />
            <h3 style="margin-top:0">Label</h3>
            <input type="text" name="label" value="@e.Label" />
            <div class="actions"><button type="submit" class="secondary">Save label</button></div>
        </form>
        @* what kind of thing it is, changeable by a person: an identifier added by hand can say what the field could not (the owner,
           2026-11-07, at "Ackermann and Son", a Person holding ULAN's corporate body) *@
        <form method="post" asp-page-handler="Class" class="card">
            <input type="hidden" name="id" value="@e.Id" />
            <h3 style="margin-top:0">Class</h3>
            <select name="cls">
                @foreach (var c in Enum.GetValues<EntityClass>()) { <option value="@c" selected="@(c == e.Class)">@c.ToString().ToLowerInvariant()</option> }
            </select>
            @if (e.Status == EntityStatus.Provisional)
            {
                @* a placeholder's class is the reading's guess; the thing it stands for often has an entity of the right class already
                   (the owner, 2026-11-07, at the "Ackermann" placeholder beside the firm's entity) *@
                <p class="small muted">This is a placeholder. If the thing it stands for already has an entity of the right class, merge into that one, or decide its waiting string there at the desk, rather than change the class here.</p>
            }
            <p class="small muted">A change is noted on the entity. The identifier keeps its path.</p>
            <div class="actions"><button type="submit" class="secondary">Save class</button></div>
        </form>
        @if (e.Status != EntityStatus.Confirmed)
        {
            <form method="post" asp-page-handler="Confirm" class="card">
                <input type="hidden" name="id" value="@e.Id" />
                <h3 style="margin-top:0">Confirm</h3>
                <p class="small muted">A person vouches for this entity as it stands: as a local authority if it has no identifiers, or with the identifiers it has.</p>
                <input type="text" name="note" placeholder="Note (optional)" />
                <div class="actions"><button type="submit">Confirm</button></div>
            </form>
        }
        @* the search is one form and each result's merge another, side by side, never nested: a form inside a form is dropped by
           the browser, and its button then submits the search (the 2026-10-21 bug: "Merge into this" did nothing) *@
        <div class="card">
            <h3 style="margin-top:0">Merge into another entity</h3>
            @if (Model.Held is not null && Model.MergeCandidates.Count == 1) { <p class="small notice">The identifier you added is held by the entity below. If they are one thing, merge this entity into it; its strings, labels and identifiers follow.</p> }
            <form method="get" class="row"><input type="hidden" name="id" value="@e.Id" /><input type="search" name="merge" value="@Model.Merge" placeholder="Search for the survivor" style="flex:1" /><button type="submit" class="secondary">Search</button></form>
            @foreach (var other in Model.MergeCandidates)
            {
                <div class="row" style="margin-top:.4rem"><div style="flex:1"><strong>@other.Label</strong> <span class="tag">@other.Class.ToString().ToLowerInvariant()</span> <span class="tag">@other.Status.ToString().ToLowerInvariant()</span> <span class="small muted">@string.Join(" ", other.Equivalents.Select(q => q.Source))</span></div>
                    <form method="post" asp-page-handler="Merge" class="inline"><input type="hidden" name="id" value="@e.Id" /><input type="hidden" name="survivor" value="@other.Id" />
                        @if (other.Class != e.Class) { <text>as a </text><select name="cls" title="The two differ in class: the merged entity's class"><option value="@other.Class" selected>@other.Class.ToString().ToLowerInvariant()</option><option value="@e.Class">@e.Class.ToString().ToLowerInvariant()</option></select> }
                        <button type="submit">Merge into this</button></form></div>
            }
        </div>
        <form method="post" asp-page-handler="Note" class="card">
            <input type="hidden" name="id" value="@e.Id" />
            <h3 style="margin-top:0">History and notes</h3>
            @* the audit log (doc 12 section 13, item 1): every hand change is a note with before and after, and the decisions a person made
               on this entity's strings stand beside them, newest first *@
            @{
                var history = v.Notes.Select(n => (When: n.CreatedAt, Who: n.Author ?? "", Text: n.Text, StringId: (long?)null))
                    .Concat(v.Strings.Where(s => s.Decision.Reviewer is not null).Select(s => (When: s.Decision.DecidedAt, Who: s.Decision.Reviewer!, Text: $"\"{s.String.Raw}\" ({s.String.Context}) decided here, {s.Decision.Method}", StringId: (long?)s.String.Id)))
                    .OrderByDescending(h => h.When).ToList();
            }
            @if (history.Count == 0) { <p class="small muted">No hand changes yet.</p> }
            @foreach (var h in history)
            {
                <p class="small"><strong>@h.Who</strong> <span class="muted">@h.When.ToString("yyyy-MM-dd HH:mm")</span><br />@h.Text
                    @if (h.StringId is { } sid) { <a class="small" href="/p/@Model.Dataset/review?id=@sid">the string</a> }</p>
            }
            <input type="text" name="text" placeholder="Add a note" />
            <div class="actions"><button type="submit" class="quiet">Add note</button></div>
        </form>
    </div>
</div>
@section Scripts {
    @if (Model.Coordinates is not null) { <partial name="_Map" /> }
}
