{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tomcrane/linked-art-net/schemas/timespan-result.schema.json",
  "title": "LinkedArtNet.Dates service result",
  "description": "One parsed input as returned by GET /v1/timespan and inside POST /v1/timespan results. TimeSpans are Linked Art JSON.",
  "type": "object",
  "required": ["input", "status", "kind", "confidence", "flags", "strategy", "alternatives", "notes", "profile", "parserVersion"],
  "additionalProperties": false,
  "properties": {
    "input": { "type": "string" },
    "ref": { "type": ["string", "null"] },
    "status": { "enum": ["parsed", "partial", "undated", "unparsed"] },
    "kind": { "enum": ["none", "single", "birthDeath", "formationDissolution", "floruit"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "canonical": { "type": ["string", "null"] },
    "edtf": { "type": ["string", "null"] },
    "flags": { "type": "array", "items": { "type": "string" } },
    "strategy": { "type": "string" },
    "timespan": { "$ref": "#/$defs/timespan" },
    "begin": { "$ref": "#/$defs/timespan" },
    "end": { "$ref": "#/$defs/timespan" },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["canonical", "confidence", "note"],
        "additionalProperties": false,
        "properties": {
          "canonical": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "note": { "type": "string" },
          "timespan": { "$ref": "#/$defs/timespan" }
        }
      }
    },
    "notes": { "type": "array", "items": { "type": "string" } },
    "unconsumed": { "type": ["string", "null"] },
    "profile": { "type": "string" },
    "parserVersion": { "type": "string" }
  },
  "$defs": {
    "dateTime": { "type": "string", "pattern": "^-?[0-9]{4,}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "timespan": {
      "type": ["object", "null"],
      "required": ["type"],
      "properties": {
        "type": { "const": "TimeSpan" },
        "_label": { "type": "string" },
        "identified_by": { "type": "array" },
        "begin_of_the_begin": { "$ref": "#/$defs/dateTime" },
        "end_of_the_begin": { "$ref": "#/$defs/dateTime" },
        "begin_of_the_end": { "$ref": "#/$defs/dateTime" },
        "end_of_the_end": { "$ref": "#/$defs/dateTime" }
      }
    }
  }
}
