{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Parser": {
    "ProfilesDirectory": "../../profiles",
    "MaxInputLength": 500,
    "MaxInputsPerRequest": 500,
    "MaxRequestBodyBytes": 262144,
    "MemoSize": 50000,
    "CacheMaxAgeSeconds": 86400,
    "RequestsPerMinute": 600
  },
  "Capture": {
    "Enabled": false,
    "Path": "capture/unparsed.jsonl",
    "MinConfidence": 0.75
  }
}
