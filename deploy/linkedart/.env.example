# Copy to .env beside docker-compose.yml and fill in. Never commit .env.

# Image tag to run: a release tag (v0.1.0) or latest.
IMAGE_TAG=latest

# GitHub login allowed into the trainer at /dates/train (add Trainer__Reviewers__1 etc. in docker-compose.yml for more).
TRAINER_REVIEWER=tomcrane

# GitHub OAuth app (Settings > Developer settings > OAuth Apps):
#   Homepage URL            https://linkedart.net
#   Authorization callback  https://linkedart.net/dates/train/signin-github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Fine-grained personal access token for opening corpus pull requests: repository access to SUBMISSION_REPO only,
# permissions Contents: read and write, Pull requests: read and write.
GITHUB_SUBMISSION_TOKEN=
SUBMISSION_REPO=tomcrane/linked-art-net
SUBMISSION_BASE_BRANCH=de-pmc

# Optional: an Anthropic API key lets the trainer ask Claude for a proposed reading of inputs the parser cannot read
# (LinkedArtNet.Dates.Llm; docs/08-corpus-contributions.md section 7). Use a key from the Console organisation linked to
# your Claude plan's monthly API credits, ideally in a workspace of its own with a spend limit. Without it the trainer
# offers no proposals; nothing else uses the key, and the public dates service never calls a model.
ANTHROPIC_API_KEY=
