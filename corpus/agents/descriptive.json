    { "id": "ul-002", "input": "French illuminator, active mid-15th century", "tags": ["active", "century-band"],
      "expect": { "kind": "person", "name": null, "nationalities": ["French"], "roleLabels": ["illuminator"], "dateText": "active mid-15th century", "noUnconsumed": true,
