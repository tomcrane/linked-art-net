@page "/p/{dataset}/entities"
@model EntitiesModel
@{ ViewData["Title"] = "Entities"; }
<div class="row" style="justify-content:space-between">
    <h1 style="margin:0">Entities</h1>
    <form method="get" class="row" style="gap:.5rem">
        <input type="search" name="q" value="@Model.Q" placeholder="Search by name" aria-label="Search" style="width:18rem" />
        <select name="status" onchange="this.form.submit()" aria-label="Status">
            <option value="">any status</option>
            @foreach (var s in Enum.GetValues<EntityStatus>().Where(s => s != EntityStatus.Merged)) { <option value="@s" selected="@(Model.Status == s)">@s.ToString().ToLowerInvariant()</option> }
        </select>
        <select name="cls" onchange="this.form.submit()" aria-label="Class">
            <option value="">any class</option>
            @foreach (var c in Enum.GetValues<EntityClass>()) { <option value="@c" selected="@(Model.Class == c)">@c.ToString().ToLowerInvariant()</option> }
        </select>
        <button type="submit" class="secondary">Go</button>
    </form>
</div>
@if (Model.Entities.Count == 0) { <p class="empty">No entities match.</p> }
else
{
    <table>
        <thead><tr><th>Label</th><th>Class</th><th>Status</th><th>Dates</th><th>Identifiers</th></tr></thead>
        <tbody>
        @foreach (var e in Model.Entities)
        {
            <tr>
                <td><a href="/p/@Model.Dataset/entity?id=@Uri.EscapeDataString(e.Id)">@e.Label</a>@if (e.Labels.Count > 0) { <div class="small muted">@string.Join(" · ", e.Labels.Where(l => l != e.Label).Take(3))</div> }</td>
                <td>@e.Class.ToString().ToLowerInvariant()</td>
                <td><span class="tag">@e.Status.ToString().ToLowerInvariant()</span></td>
                <td class="small">@e.Lifespan?.Text</td>
                <td class="small">@foreach (var q in e.Equivalents.Take(5)) { <span class="tag src">@q.Source</span> }</td>
            </tr>
        }
        </tbody>
    </table>
    @if (Model.Q is null && Model.Entities.Count == EntitiesModel.PageSize)
    {
        <p><a class="button secondary" href="@Url.Page("/Projects/Entities", new { dataset = Model.Dataset, status = Model.Status, cls = Model.Class, after = Model.Entities[^1].Id })">Next page →</a></p>
    }
}
