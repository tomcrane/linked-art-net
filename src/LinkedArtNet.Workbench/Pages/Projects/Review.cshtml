@page "/p/{dataset}/review"
@model ReviewModel
@functions {
    // a field named to the reviewer in the manifest's plain words ("place of publication" for place), its own name on hover (the owner, 2026-11-13)
    string F(string? context) => Model.Project.Manifest.FieldName(context);
    Microsoft.AspNetCore.Html.IHtmlContent Field(string? context)
    {
        var enc = System.Text.Encodings.Web.HtmlEncoder.Default;
        var about = Model.Project.Manifest.FieldAbout(context);
        return new Microsoft.AspNetCore.Html.HtmlString($"<span title=\"{enc.Encode("the field " + context + (about is null ? "" : ": " + about))}\">{enc.Encode(F(context))}</span>");
    }
    // a project entity named with its placement when known ("Birmingham (Ala.)"), so namesakes on one page can be told apart (the owner, 2026-11-07)
    // an entity known by its id and label only, named as Named names one: with where it is, so that two of one label read apart
    // (seen as a user, 2026-11-20: "Same as Winchester" on the Virginian group and on the English)
    string NamedById(string id, string? label)
    {
        var f = Model.Item?.Entities.Values.FirstOrDefault(x => x.Entity.Id == id);
        return (label ?? id) + (f?.Placement is { } p ? $" ({p})" : "");
    }
    string Named(LinkedArtNet.Alignment.Entity e)
    {
        var f = Model.Item?.Entities.Values.FirstOrDefault(x => x.Entity.Id == e.Id);
        return (e.Label ?? e.Id) + (f?.Placement is { } p ? $" ({p})" : "");
    }

    // an identifier as a link to its record, with what the record is when the store holds it: "wikidata's Q3403624 (Dagenham:
    // Parliamentary constituency in the United Kingdom, 1945-2010)" (the owner, 2026-11-13, at the two Dagenhams)
    Microsoft.AspNetCore.Html.IHtmlContent Held(string uri, string? source = null)
    {
        var enc = System.Text.Encodings.Web.HtmlEncoder.Default;
        source ??= LinkedArtNet.Alignment.AuthorityUris.SourceOf(uri);
        var says = Model.Item is { } it && it.Records.TryGetValue(uri, out var r) ? LinkedArtNet.Alignment.Authorities.RecordSummary.Says(r) : null;
        // no record of it here (a VIAF number): the record on the card that gives it says what it is
        if (says is null && Model.Item is { } card && !card.Records.ContainsKey(uri) && LinkedArtNet.Alignment.Authorities.IdentifierSets.CitedBy(uri, card.Records.Values) is { } giver)
            says = $"given by {giver.Source}'s {giver.Uri.TrimEnd('/').Split('/').Last()}";
        return new Microsoft.AspNetCore.Html.HtmlString(
            $"<a href=\"{enc.Encode(uri)}\" target=\"_blank\" rel=\"noopener\">{enc.Encode(source + "'s " + uri.TrimEnd('/').Split('/').Last())}</a>"
            + (says is null ? "" : $" <span class=\"said\">({enc.Encode(says)})</span>"));
    }

    // the merge of a holder pair, on its own line at the foot of the pair's box
    Microsoft.AspNetCore.Html.IHtmlContent PairFoot(long id, IEnumerable<string> targets)
    {
        var enc = System.Text.Encodings.Web.HtmlEncoder.Default;
        var b = new Microsoft.AspNetCore.Html.HtmlContentBuilder();
        b.AppendHtml($"<form method=\"post\" action=\"/p/{enc.Encode(Model.Dataset)}/review?handler=AcceptTogether\" class=\"pair-foot\">");
        b.AppendHtml(Html.AntiForgeryToken());
        b.AppendHtml($"<input type=\"hidden\" name=\"id\" value=\"{id}\" />");
        foreach (var t in targets) b.AppendHtml($"<input type=\"hidden\" name=\"targets\" value=\"{enc.Encode(t)}\" />");
        b.AppendHtml("<button type=\"submit\" class=\"secondary\" title=\"You choose the survivor next, and see what will happen before it is done\">Merge them and accept this string onto the survivor</button>");
        b.AppendHtml(" <span class=\"small muted\">You choose the survivor next; nothing is merged until you confirm.</span></form>");
        return b;
    }

    Microsoft.AspNetCore.Html.IHtmlContent HeldAll(IEnumerable<LinkedArtNet.Alignment.Equivalent> held, string separator = ", ")
    {
        var b = new Microsoft.AspNetCore.Html.HtmlContentBuilder();
        var first = true;
        foreach (var q in held) { if (!first) b.Append(separator); b.AppendHtml(Held(q.Uri, q.Source)); first = false; }
        return b;
    }
}
@{
    ViewData["Title"] = "Review";
    var item = Model.Item;
}
<div class="row" style="justify-content:space-between">
    @* what is reviewed, in the title and in a line under it (the owner, 2026-11-19, now that Checks reviews entities: "Source String Review
       Desk"?; the assistant as a user: "source string" is the toolkit's word, and what it wanted on arriving was one plain sentence) *@
    <div><h1 style="margin:0">String review</h1>
    <p class="small muted" style="margin:.2rem 0 0; max-width:34rem">Each card is one piece of text from the catalogue records, such as a place, a name or a subject. Decide what it names.</p></div>
    <form method="get" class="row" style="gap:.5rem">
        <input type="hidden" name="method" value="@Model.Method" />
        <select name="context" onchange="this.form.submit()" aria-label="Context">
            <option value="">all contexts (@Model.Queue.Sum(r => r.Count))</option>
            @foreach (var row in Model.Queue)
            {
                <option value="@row.Context" selected="@(row.Context == Model.Context)">@row.Context (@row.Count)</option>
            }
        </select>
        <select name="method" onchange="this.form.submit()" aria-label="Kind">
            <option value="queued" selected="@(Model.Method == "queued")">queued for review</option>
            <option value="minted" selected="@(Model.Method == "minted")">minted (nothing found)</option>
            <option value="human" selected="@(Model.Method == "human")">decided by a person</option>
        </select>
    </form>
</div>
@if (Model.Plan is { } waiting) { <p class="notice"><strong>Confirm first:</strong> @waiting.Ours.Count of the project's own entities are ticked and would become one. <a href="#confirm-together">What will happen, and the choice, is under the candidates</a>; nothing is done until you press Merge and accept there.</p> }
@if (Model.Message is not null) { <p class="notice" data-flash>@Model.Message @if (Model.Decided is { } d) { <text>· </text><a href="/p/@Model.Dataset/entity?id=@Uri.EscapeDataString(d.Id)"><strong>@d.Label</strong></a><text>, to add identifiers or notes before going on</text> }</p> }

<details class="help">
    <summary>What am I supposed to do here?</summary>
    <p>One string at a time, as the catalogue wrote it, with the records it was seen in under <strong>In the records</strong>.
    Below it, what the software found: each box is a group, one authority record or several records that say they are the
    same thing, best first; greyed rows were ruled out and the reason says why. Say what the string is with the group's own
    button: <strong>Accept</strong> (it is this record), <strong>Accept these as one</strong> (it is this group, one entity with
    all its identifiers), <strong>Same as</strong> an entity the project already has; <strong>Always, in this field</strong>
    (the same, and this spelling means this from now on); <strong>just this one</strong> on a row of a group takes that record
    alone; search for <strong>something else</strong>; or
    <strong>Keep as local authority</strong> when it is real and none of the cards is it. A card that is one of the project's own
    entities says what it stands for and holds; when two of them hold records of one group, the group says so and offers to merge them
    and accept the string onto the survivor, showing what will happen first. The other queued strings under the same name are listed
    above the records, and after an action the desk goes to them before it moves on. Not sure? <strong>Skip for now</strong>,
    or leave a <strong>note</strong> for another reviewer. Every decision can be undone. <a href="/help#the-desk">The guide</a>
    has the rest.</p>
</details>
@if (item is null)
{
    <p class="empty">Nothing @(Model.Method == "queued" ? "waiting for review" : "here")@(Model.Context is null ? "" : $" in {Model.Context}"). <a href="/p/@Model.Dataset">Back to the project</a>.</p>
}
else
{
    var ev = item.Evidence;
    var reading = ev.Reading;
    <p class="small muted">@Model.Remaining in this list · string @item.String.Id · seen @item.String.Occurrences time@(item.String.Occurrences == 1 ? "" : "s") as <strong>@Field(item.String.Context)</strong> · decided <em>@item.Decision.Method</em>@(item.Decision.Reviewer is null ? "" : $" by {item.Decision.Reviewer}") @item.Decision.DecidedAt.ToString("yyyy-MM-dd")
    <text>· </text><a href="@Url.Page("/Projects/Review", new { dataset = Model.Dataset, method = Model.Method, context = Model.Context, id = item.String.Id, pictures = !Model.Pictures })" title="Thumbnails on the cards whose records have been pulled from the sources with a picture; off by default">@(Model.Pictures ? "hide pictures" : "show pictures")</a>
    @if (item.LookedAgain is null) { <text>· </text><a href="@Url.Page("/Projects/Review", new { dataset = Model.Dataset, method = Model.Method, context = Model.Context, id = item.String.Id, look = true })" title="Show what today's rules would offer for this string, without deciding anything">Look again</a> }</p>
    @if (item.LookedAgain is { } outcome)
    {
        <p class="flash">Looked at again under today's rules: it would be <strong>@(outcome switch { "matchedstore" => "matched to an entity the project already has", "accepted" => "accepted", "queued" => "queued for review", "minted" => "minted, nothing found", "overridden" => "decided by a standing override", _ => outcome })</strong>. The stored decision is unchanged; the actions below act on what you see. <a href="@Url.Page("/Projects/Review", new { dataset = Model.Dataset, method = Model.Method, context = Model.Context, id = item.String.Id })">Back to the stored evidence</a></p>
    }
    @if (item.LookedAgain is null && item.Decision.Method is not (DecisionMethod.Queued or "minted") && Model.Plan is null)
    {
        @* a card opened by its link after it was decided says so first (the owner, 2026-11-14, back at "Brockley" by an old queue link:
           "nothing tells me it has been settled... or is that Currently?"). Who or what decided it, onto what, and the way back and on *@
        var byPerson = item.Decision.Method is DecisionMethod.Human or DecisionMethod.NotAName;
        var notNameWhy = item.Decision.Method == DecisionMethod.NotAName && ev.Extra is { } nx && nx.TryGetProperty("reason", out var nr) ? nr.GetString() : null;
        <div class="notice settled">
            <p><strong>This string is decided and is not in the queue.</strong>
                @if (byPerson) { <text>@(item.Decision.Reviewer ?? "A reviewer") decided it on @item.Decision.DecidedAt.ToString("yyyy-MM-dd")</text> }
                else { <text>The rules decided it on @item.Decision.DecidedAt.ToString("yyyy-MM-dd") (@item.Decision.Method)</text> }
                @{
                    // the group the decision took: the one that holds the entity itself or a record the entity holds. It says where the
                    // thing is and why it was chosen, which the entity's bare label does not ("it is Sandy": the owner, 2026-11-15)
                    var took = item.Entity is null ? null : item.Evidence.Groups.FirstOrDefault(g => g.Members.Any(m => m.Uri == item.Entity.Id || item.Entity.Equivalents.Any(q => q.Uri == m.Uri)));
                    var tookWhere = took?.Members.Select(m => item.Records.TryGetValue(m.Uri, out var tr) ? LinkedArtNet.Alignment.Authorities.Coordinates.Parents(tr) : null).FirstOrDefault(x => x is not null);
                    var tookWhy = took?.Members.Where(m => m.Veto != true).Select(m => m.Reason).FirstOrDefault(r => !string.IsNullOrWhiteSpace(r));
                }
                @if (item.Entity is not null) { <text>: it is </text><a href="/p/@Model.Dataset/entity?id=@Uri.EscapeDataString(item.Entity.Id)" target="_blank" rel="noopener">@item.Entity.Label</a>@if (tookWhere is not null) { <text> (@string.Join(", ", tookWhere.Split(',').Select(x => x.Trim()).Where(x => x.Length > 0 && x != "World").Take(3)))</text> } <span class="tag">@item.Entity.Class.ToString().ToLowerInvariant()</span> <span class="tag">@item.Entity.Status.ToString().ToLowerInvariant()</span>@(item.Entity.Equivalents.Count == 0 ? ", a local authority with no identifier elsewhere" : $", with {item.Entity.Equivalents.Count} identifier{(item.Entity.Equivalents.Count == 1 ? "" : "s")}")<text>.</text> }
                else if (item.Decision.Method == DecisionMethod.NotAName) { <text>: <strong>it is not a name</strong>, @(notNameWhy == CurationService.RecordWantsFixing ? "and its record wants fixing" : "the cataloguer's way of saying that nothing is known"). No entity stands for it.</text> }
                else { <text>: left unresolved.</text> }
            </p>
            @if (tookWhy is not null) { <p class="small"><strong>Why:</strong> @tookWhy.</p> }
            <p class="small">Nothing more is needed. Below is the card as it was decided: the candidate that was chosen first, and the others it was chosen from folded away. You can <a href="#something-else">decide it differently</a> with any action here, take the decision back with <strong>Undo last decision</strong> at the foot, or go on:
                <a href="@Url.Page("/Projects/Review", new { dataset = Model.Dataset, method = DecisionMethod.Queued, context = Model.Context, after = item.String.Id })">the next string in the queue →</a></p>
        </div>
    }
    @* the entity the string stands on is on a check's list: said here, with the way there (the owner, 2026-11-22) *@
    @foreach (var hit in Model.OnChecks)
    {
        <p class="notice small"><strong>The entity this string stands on@(item.Entity is null ? "" : $", {item.Entity.Label},") is on a check's list.</strong> @hit.Title: @hit.Says. <a href="@hit.Href" target="_blank" rel="noopener">@hit.Action</a></p>
    }
    <p class="string">@item.String.Raw</p>
    @if (reading is not null)
    {
        <dl class="facts">
            <dt>Read as</dt><dd><strong>@reading.Text</strong> @if (reading.Classes is { Count: > 0 }) { <span class="tag">@string.Join(" or ", reading.Classes)</span> }</dd>
            @if (reading.Lifespan is not null) { <dt>Dates</dt><dd>@reading.Lifespan</dd> }
            @if (reading.Roles is { Count: > 0 }) { <dt>Roles</dt><dd>@string.Join(", ", reading.Roles)</dd> }
            @if (reading.Nationalities is { Count: > 0 }) { <dt>Nationality</dt><dd>@string.Join(", ", reading.Nationalities)</dd> }
            @if (item.Entity is not null) { <dt>Currently</dt><dd><a href="/p/@Model.Dataset/entity?id=@Uri.EscapeDataString(item.Entity.Id)" target="_blank" rel="noopener" title="The entity's page">@item.Entity.Label</a> <span class="tag">@item.Entity.Status.ToString().ToLowerInvariant()</span> <code class="small">@item.Entity.Id</code></dd> }
        </dl>
    }
    @* the entity this notice settles the string onto, if it shows: the card's other offers of that entity say so and carry no button
       (one button for one act; seen as a user on 2026-11-20 at "New Gallery", where "Settle it onto", the hint's "Same as" and the
       candidate's each offered it) *@
    var settledId = item.Decision.Method == DecisionMethod.Queued && item.Entity is { Status: EntityStatus.Confirmed or EntityStatus.Aligned } && Model.Plan is null ? item.Entity.Id : null;
    @if (item.Decision.Method == DecisionMethod.Queued && item.Entity is { Status: EntityStatus.Confirmed or EntityStatus.Aligned } settled && Model.Plan is null)
    {
        @* a queued string whose entity is no placeholder any more: something settled the entity and not the string (a keep refused
           half-way, before 2026-11-14; a hand change on the entity's page). The desk says so and offers the one step that is left *@
        <form method="post" asp-page-handler="SameAs" asp-route-method="@Model.Method" asp-route-context="@Model.Context" class="notice small">
            <input type="hidden" name="id" value="@item.String.Id" /><input type="hidden" name="entity" value="@settled.Id" />
            <strong>This string is still queued, but the entity it points at is already @settled.Status.ToString().ToLowerInvariant():</strong>
            <a href="/p/@Model.Dataset/entity?id=@Uri.EscapeDataString(settled.Id)" target="_blank" rel="noopener">@settled.Label</a>.
            If that is what the string means, <button type="submit" class="secondary">Settle it onto @settled.Label</button> and it leaves the queue.
        </form>
    }
    @if (Model.LongerForms.Count > 0)
    {
        @* the project's own neighbours (the owner's marks on the trial, 2026-11-19: "Blackwell" is the project's Basil Blackwell, and was not offered;
           counted first: 173 of the 749 queued publisher strings have a longer form already decided, 100 of them onto one entity; some are another
           thing, "Mead" beside "Mead Art Museum", so it is shown and a person says "Same as") *@
        // where a longer form's entity is also a candidate on this card: the group's place among those not ruled out, and its score
        var liveGroups = item.Evidence.Groups.Where(g => g.Members.Any(m => m.Veto != true && m.SetAside != true)).ToList();
        Func<string, (int At, double Score)?> onCard = key =>
        {
            for (var gi = 0; gi < liveGroups.Count; gi++)
                if (liveGroups[gi].Members.Any(m => m.Veto != true && m.SetAside != true && Model.CandidateEntity.TryGetValue(m.Uri, out var ce) && ce.Id == key)) return (gi, liveGroups[gi].Score);
            return null;
        };
        var agreeing = Model.LongerForms.GroupBy(f => f.EntityId).Where(g => onCard(g.Key) is { At: 0 }).ToList();
        // it stands aside where a candidate below the top bears the string as written, its bracketed qualifier apart (seen as a user,
        // 2026-11-20: a catalogue of 1762 by the "Society for the Encouragement of Arts...", the head naming the Royal Society of Arts
        // through a longer form, and the Society's own heading the second candidate; counted: five of the ten such cards then left)
        Func<string?, string> lettersOf = x => new string(System.Text.RegularExpressions.Regex.Replace(x ?? "", @"\s*\([^()]*\)\s*$", "").Where(char.IsLetterOrDigit).ToArray()).ToLowerInvariant();
        var asWritten = lettersOf(item.String.Raw);
        var borneBelow = liveGroups.Skip(1).Any(g => g.Members.Any(m => m.Veto != true && m.SetAside != true && lettersOf(m.Label) == asWritten));
        @if (agreeing.Count == 1 && Model.Method != "human" && settledId is null && !borneBelow)
        {
            @* two lines of evidence that meet (the owner at "Schwabe", 2026-11-20: "there should be some encouragement?"). Counted first: 20 queued
               cards have it at the top candidate; of the nine among the strings marked in the second trial all nine were the same body, and of
               nine where it met a lower candidate one was not. Said as agreement, not proof: both can rest on one earlier decision ("Penguin") *@
            var ag = agreeing[0];
            var agLabel = ag.First().EntityLabel ?? ag.Key;
            <div class="notice" style="margin:.5rem 0">
                <strong>Two things on this card point to @agLabel.</strong> A longer form of the name, "@ag.First().Raw", is already decided onto it, and it holds the record of the top candidate below (@onCard(ag.Key)!.Value.Score.ToString("0.00")).
                <span class="small">They agree, which is not proof: both may rest on one earlier decision. If the records below are its own, the <a href="#top-candidate">top candidate</a>'s button, "Same as @agLabel", decides it.</span>
            </div>
        }
        <div class="small" style="margin:.5rem 0"><strong>Longer forms of this name, already decided in this project:</strong> <span class="muted">a hint; they may be another thing of the name</span>
        @foreach (var byEntity in Model.LongerForms.GroupBy(f => f.EntityId))
        {
            var also = onCard(byEntity.Key);
            <div class="row" style="gap:.5rem; align-items:baseline; margin:.2rem 0"><span style="flex:1">@foreach (var f in byEntity) { <a href="/p/@Model.Dataset/review?id=@f.StringId" target="_blank" rel="noopener" title="This string's card">@f.Raw</a><span class="muted"> (@f.Records.ToString("N0") record@(f.Records == 1 ? "" : "s"))</span><text> · </text> }
                on <a href="/p/@Model.Dataset/entity?id=@Uri.EscapeDataString(byEntity.Key)" target="_blank" rel="noopener">@(byEntity.First().EntityLabel ?? byEntity.Key)</a>@if (also is { } a) { <span class="muted" title="The same entity is offered among the candidates below: its button there and this one do the same thing"> · also @(a.At == 0 ? "the top candidate" : "a candidate") below, at @a.Score.ToString("0.00"), and decided there</span> }</span>
                @* one button for one act (the owner, 2026-11-20): an entity that is also a candidate below is decided there, where its record is *@
                @if (byEntity.Key == settledId) { <span class="small muted">settled by the button above</span> }
                else if (also is null) { <form method="post" asp-page-handler="SameAs" asp-route-method="@Model.Method" asp-route-context="@Model.Context" class="inline"><input type="hidden" name="id" value="@item.String.Id" /><input type="hidden" name="entity" value="@byEntity.Key" /><button type="submit" class="secondary" title="Decides this string onto that entity">Same as @(byEntity.First().EntityLabel ?? "this")</button></form> }</div>
        }
        </div>
    }
    @if (item.String.Raw.Contains('?') && item.Decision.Method == DecisionMethod.Queued)
    {
        <p class="small notice">The record itself is unsure: the cataloguer wrote a question mark. Decide what it most probably is. The question mark stays in the record's text, so the doubt is not lost.</p>
    }
    @foreach (var near in Model.NearSpellings)
    {
        @* a name the project uses, one letter away (seen as a user, 2026-11-23: "Londo", an Agnew's catalogue, offered Londo in the Congo) *@
        <form method="post" asp-page-handler="SameAs" asp-route-method="@Model.Method" asp-route-context="@Model.Context" class="notice small">
            <input type="hidden" name="id" value="@item.String.Id" /><input type="hidden" name="entity" value="@near.Id" />
            <strong>A misspelling, perhaps.</strong> This project has <a href="/p/@Model.Dataset/entity?id=@Uri.EscapeDataString(near.Id)" target="_blank" rel="noopener">@NamedById(near.Id, near.Label)</a>, one letter away, on @near.Records.ToString("N0") records. A hint by spelling alone: the records below say whether it is meant.
            <button type="submit" class="secondary">Same as @NamedById(near.Id, near.Label)</button>
            <span class="muted">If it is, the misspelling can go to the cataloguers under <a href="#ways-out">The record is wrong</a>.</span>
        </form>
    }
    @if (Model.Mates.Count > 0)
    {
        <div class="small" id="run"><strong>The same thing, written another way?</strong> Tick any of these that are, and the button you press decides them too:
            @foreach (var mate in Model.Mates)
            {
                <label style="text-transform:none; letter-spacing:normal; font-size:inherit; font-weight:400; color:inherit; margin:0 .8rem 0 0; display:inline-block"><input type="checkbox" data-also value="@mate.String.Id" /> "@mate.String.Raw" <span class="muted">(@F(mate.String.Context))</span></label>
            }
        </div>
    }
    @if (item.Siblings.Count > 0)
    {
        @* the other queued strings under this name; after an action the desk goes to these first (the owner, 2026-11-06) *@
        <p class="small"><strong>Also waiting under this name:</strong>
        @for (var i = 0; i < item.Siblings.Count; i++)
        {
            var sib = item.Siblings[i];
            if (i > 0) { <text> · </text> }
            <a href="@Url.Page("/Projects/Review", new { dataset = Model.Dataset, method = Model.Method, context = Model.Context, id = sib.String.Id })">"@sib.String.Raw" (@F(sib.String.Context))</a>
        }
        <span class="muted">· after an action the desk goes to these first</span></p>
    }
    @* every record the string occurs in, grouped by what another field says (doc 12 section 14.6): the largest groups, the first few
       records of each, and the other fields to group by *@
    var recs = await Model.Project.Desk.RecordsForAsync(item.String, Model.By, Model.Project.Manifest);
    @if (recs.Count > 0)
    {
        <p class="notice small" id="by-record-note" hidden><strong><span id="by-record-count">0</span> ticked: the next Accept or Same as you press decides only the ticked records</strong>, each for itself. The string's other records are left as they are. Untick to decide the whole string.</p>
        var shown = recs.Groups.Sum(g => g.Records);
        var groupFields = recs.Groups.SelectMany(g => g.First).SelectMany(x => x.NamingFields().Select(f => f.Name)).Append("medium").Append("class").Distinct().Where(f => f != recs.By).ToList();
        <div class="card"><h3 style="margin-top:0">In the records</h3>
        <p class="small muted">In <strong>@recs.Count.ToString("N0")</strong> record@(recs.Count == 1 ? "" : "s")@if (recs.Via is { } via) { <text>, those of "@via.Raw", which it is part of</text> }@if (recs.Groups.Count > 1 || shown < recs.Count)
            {
                <text>, grouped by what <strong>@recs.By</strong> says@(shown < recs.Count ? $" (the {recs.Groups.Count} largest groups, {shown:N0} records)" : "")</text>
            }
            @if (recs.Count > 1)
            {
                <text> · group by: </text>
                @foreach (var f in groupFields) { <a data-keep-place href="@Url.Page("/Projects/Review", new { dataset = Model.Dataset, method = Model.Method, context = Model.Context, id = item.String.Id, by = f })">@f</a><text> </text> }
            }
        </p>
        @* several groups: each folds, the largest open, so that the groups are read as a list and the candidates are not pushed off the
           screen (seen in the browser, 2026-11-15: "Cambridge", eight groups of three records before the first candidate) *@
        @foreach (var g in recs.Groups)
        {
            var several = recs.Groups.Count > 1;
            @if (several) { @:<details class="rec-group" @(ReferenceEquals(g, recs.Groups[0]) ? "open" : "")><summary class="small"><span class="muted">@recs.By:</span> <strong>@(g.Value ?? "(none given)")</strong> <span class="muted">· @g.Records.ToString("N0") record@(g.Records == 1 ? "" : "s")</span>@if (g.Value is not null && recs.Hints.TryGetValue(g.Value, out var hs) && hs.FirstOrDefault(h => h.Place is not null) is { } lead) { <span class="hint" title="A hint, not a decision: where this publisher is, by @(lead.From == "table" ? "the shipped table of publishers" : "its other imprints in this project")"> · in @lead.Place</span> }@if (recs.Via is null && g.Value is not null) { <label style="text-transform:none; letter-spacing:normal; font-size:inherit; font-weight:400; color:inherit; margin:0 0 0 .8rem; display:inline" title="Decide only the records of this group: the next Accept or Same as you press decides the ticked records, each for itself, and not the string"><input type="checkbox" data-records value="by|@recs.By|@g.Value" /> decide only @(g.Records == 1 ? "this record" : $"these {g.Records:N0}")</label> }</summary>
            }
            @if (g.Value is not null && recs.Hints.TryGetValue(g.Value, out var groupHints))
            {
                @* what a record's other field says about the string (the owner, 2026-11-15, at "Cambridge"): hints, nothing decided *@
                <p class="small hint-line"><span class="muted">Where this publisher is:</span>
                    @foreach (var h in groupHints)
                    {
                        <span class="hint-item">@if (h.Uri is not null) { <a href="@h.Uri" target="_blank" rel="noopener">@h.Text</a> } else if (h.EntityId is not null) { <a href="@Url.Page("/Projects/Entity", new { dataset = Model.Dataset, id = h.EntityId })">@h.Text</a> } else { @h.Text }</span>
                    }
                    <span class="muted">· a hint: nothing is decided by it</span>
                </p>
            }
            @foreach (var x in g.First)
            {
                var recordUrl = Model.Project.Manifest.RecordUrl(x.Source, x.RecordId);
                Model.RecordDecisions.TryGetValue(x.Source + "|" + x.RecordId, out var recOwn);
                @if (recOwn is not null)
                {
                    <form method="post" asp-page-handler="RecordUndo" asp-route-method="@Model.Method" asp-route-context="@Model.Context" data-keep-place class="small notice" style="margin:.3rem 0">
                        <input type="hidden" name="id" value="@item.String.Id" /><input type="hidden" name="decision" value="@recOwn.Id" />
                        <strong>In this record it is <a href="/p/@Model.Dataset/entity?id=@Uri.EscapeDataString(recOwn.EntityId ?? "")" target="_blank" rel="noopener">@NamedById(recOwn.EntityId ?? "", recOwn.EntityLabel)</a></strong>, decided for this record alone by @(recOwn.Reviewer ?? "a reviewer") on @recOwn.DecidedAt.ToString("yyyy-MM-dd").
                        <button type="submit" class="link small">take it back</button>
                    </form>
                }
                <p class="small">@if (recs.Via is null && recs.Count > 1 && recOwn is null) { <input type="checkbox" data-records value="rec|@x.Source|@x.RecordId" title="Decide this record alone: the next Accept or Same as you press decides the ticked records, not the string" /> }<strong>@(x.Title ?? "(no title)")</strong>@(x.Date is null ? "" : $" ({x.Date})") <span class="muted">· @if (recordUrl is not null) { <a href="@recordUrl" target="_blank" rel="noopener" title="This record in the @Model.Project.Manifest.SystemName(x.Source)">@x.RecordId</a> } else { <span title="@Model.Project.Manifest.SystemName(x.Source)">@x.RecordId</span> } · from &lt;@x.Field&gt;</span>
                @* the title looked up outside (the owner, 2026-11-19: "I'm often googling the book title to try to find publisher info"): a trial of two
                   places to look, a union catalogue of UK libraries and the web; the title up to its statement of responsibility, in quotes for the web *@
                @if (!string.IsNullOrWhiteSpace(x.Title))
                {
                    var lookFor = x.Title.Split(" / ")[0].Trim();
                    <span class="muted">· look up the title: <a href="https://discover.libraryhub.jisc.ac.uk/search?q=@Uri.EscapeDataString(lookFor)" target="_blank" rel="noopener" title="Searches Jisc Library Hub Discover, the union catalogue of UK research libraries, for this title: its records give the publisher's full name and place">Library Hub</a> · <a href="https://www.google.com/search?q=@Uri.EscapeDataString("\"" + lookFor + "\"")" target="_blank" rel="noopener" title="Searches the web for this title, in quotes">web</a> · <a href="https://www.google.com/search?q=@Uri.EscapeDataString("\"" + lookFor + "\" " + item.String.Raw)" target="_blank" rel="noopener" title="Searches the web for this title, in quotes, together with the card's string: for a title that is not the only one of its name (the owner, 2026-11-19: &quot;souvenir white rabbit&quot;)">web, with "@item.String.Raw"</a></span>
                }
                @foreach (var (name, values) in x.NamingFields()) { <br /><span class="muted">@name:</span> @string.Join(" · ", values) }
                </p>
            }
            @if (g.Records > g.First.Count) { <p class="small muted">and @((g.Records - g.First.Count).ToString("N0")) more@(recs.Groups.Count > 1 ? " in this group" : "")</p> }
            @if (several) { @:</details>
            }
        }
        </div>
    }
    @if (Model.FullerNames.Count > 0)
    {
        @* a publisher's fuller name in the indexes (the owner, 2026-11-19: yes, "though with enough caveats that the user doesn't lean on it too heavily -
           they still have to be sure"). Shown apart from the candidates, unscored, never chosen by a rule; the record's place is the one test offered *@
        var recordPlaces = recs.Groups.SelectMany(g => g.First).SelectMany(x => x.NamingFields()).Where(f => f.Name == "place").SelectMany(f => f.Values)
            .SelectMany(v => v.Split(';', ',')).Select(v => v.Trim(' ', '[', ']', '.', '?')).Where(v => v.Length >= 4).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
        <div class="card">
            <h3 style="margin-top:0">Fuller names in the indexes <span class="muted small">· found by adding a publisher's word (Press, Books, Publishing, Gallery …) to "@item.String.Raw"</span></h3>
            <p class="small"><strong>A guess by name only, to be checked.</strong> These were found because their names begin with this string; nothing was scored, and no rule chose them. A body of the fuller name can be another body altogether, in another country or another century. Before accepting one, open its record and set what it says (what kind of body, where, when) against the records above@(recordPlaces.Count > 0 ? ", published at " + string.Join(", ", recordPlaces.Take(4)) : ""). If none is plainly the publisher, none is the answer.</p>
            @foreach (var r in Model.FullerNames)
            {
                var says = LinkedArtNet.Alignment.Authorities.RecordSummary.Says(r);
                var at = recordPlaces.FirstOrDefault(p => (r.Label + " " + says).Contains(p, StringComparison.OrdinalIgnoreCase));
                <div class="row result"><div style="flex:1"><strong>@r.Label</strong> @if (!string.IsNullOrWhiteSpace(r.Type)) { <span class="tag">@r.Type.ToLowerInvariant()</span> } <span class="tag">@r.Source</span>
                    @* said only when it agrees: most records held here name no place, and "does not name the records' place" read as a mark against the right one ("Yale University Press", 2026-11-19) *@
                    @if (at is not null) { <span class="small" title="The record's place of publication is named in this body's record. It agrees; it does not prove.">· names @at, where a record was published</span> }
                    @if (says is not null && says != r.Label) { <div class="small muted">@says</div> } else { <br /> }
                    <a class="small" href="@r.Uri" target="_blank" rel="noopener" title="Open the record and read it before accepting">@r.Uri</a>
                        @if (Model.StandingOn.TryGetValue(r.Uri, out var fst) && fst.Records > 0)
                        {
                            <div class="small"><strong>Already in this project:</strong> @fst.Records.ToString("N0") record@(fst.Records == 1 ? "" : "s") in @fst.Strings.ToString("N0") other string@(fst.Strings == 1 ? "" : "s") stand on this, through <a href="/p/@Model.Dataset/entity?id=@Uri.EscapeDataString(fst.EntityId)" target="_blank" rel="noopener">@(fst.EntityLabel ?? fst.EntityId)</a> <span class="muted" title="It says the project uses this record already, and how much. It does not say the earlier decisions were right.">· how much it is used, not whether rightly</span></div>
                        }</div>
                    <form method="post" asp-page-handler="Accept" asp-route-method="@Model.Method" asp-route-context="@Model.Context" class="inline"><input type="hidden" name="id" value="@item.String.Id" /><input type="hidden" name="target" value="@r.Uri" /><button type="submit" class="secondary" title="Decides this string onto this record. Read the record first.">Accept, having checked</button></form></div>
            }
        </div>
    }
    @if (item.Notes.Count > 0)
    {
        <div class="card"><h3 style="margin-top:0">Notes</h3>@foreach (var n in item.Notes) { <p class="small"><strong>@n.Author</strong> <span class="muted">@n.CreatedAt.ToString("yyyy-MM-dd HH:mm")</span><br />@n.Text</p> }</div>
    }

    // a decided card shows what was chosen, not a list of things still to choose from (the owner, 2026-11-15, at "Sandy": the green
    // notice said decided, and the map and the candidates below "suggest there is still work to do")
    var decidedCard = item.LookedAgain is null && item.Decision.Method is not (DecisionMethod.Queued or "minted") && Model.Plan is null;
    var chosenGroup = decidedCard && item.Entity is not null ? ev.Groups.FirstOrDefault(g => g.Members.Any(m => m.Uri == item.Entity.Id || item.Entity.Equivalents.Any(q => q.Uri == m.Uri))) : null;
    // among candidates level in score, one in the project's home place comes first (seen as a user, 2026-11-23: Birmingham in Alabama
    // above Birmingham in England, for a library in the United Kingdom); the order is otherwise as the evidence has it
    var homePlace = Model.Project.Manifest.HomePlace;
    bool AtHome(LinkedArtNet.Alignment.Reconciliation.EvidenceGroup g) => !string.IsNullOrWhiteSpace(homePlace) && g.Members.Any(m => m.Veto != true && m.SetAside != true
        && ((item.Records.TryGetValue(m.Uri, out var hr) && (LinkedArtNet.Alignment.Authorities.Coordinates.Parents(hr) ?? "").Contains(homePlace, StringComparison.OrdinalIgnoreCase))
            || (item.Entities.TryGetValue(m.Uri, out var hf) && ((hf.Placement ?? "").Contains(homePlace, StringComparison.OrdinalIgnoreCase)
                || hf.Entity.Equivalents.Any(q => item.Records.TryGetValue(q.Uri, out var er) && (LinkedArtNet.Alignment.Authorities.Coordinates.Parents(er) ?? "").Contains(homePlace, StringComparison.OrdinalIgnoreCase))))));
    var inOrder = ev.Groups.Select((g, i) => (g, i)).OrderByDescending(x => Math.Round(x.g.Score, 2)).ThenByDescending(x => AtHome(x.g) ? 1 : 0).ThenBy(x => x.i).Select(x => x.g).ToList();
    var shownGroups = chosenGroup is null ? inOrder : ev.Groups.Where(g => ReferenceEquals(g, chosenGroup)).Concat(ev.Groups.Where(g => !ReferenceEquals(g, chosenGroup))).ToList();
    var foldOpen = false;
    // a reason every candidate shares is said once for the card and not on each (the assistant as a user, 2026-11-19: "Athens" said one
    // sentence thirty times; the owner: "show what they need to see and not more")
    var liveReasons = ev.Groups.SelectMany(g => g.Members).Where(m => m.Veto != true && m.SetAside != true && !string.IsNullOrWhiteSpace(m.Reason) && !m.Reason!.Contains("a placeholder awaiting review", StringComparison.Ordinal)).Select(m => m.Reason!.Split("; ")).ToList();
    var saidOnce = liveReasons.Count >= 3 ? liveReasons[0].Where(c => !c.StartsWith("name ", StringComparison.Ordinal) && liveReasons.All(r => r.Contains(c))).ToList() : new List<string>();
    Func<string?, string> lessReason = reason => reason is null ? "" : string.Join("; ", reason.Split("; ").Where(c => !saidOnce.Contains(c)));
    // the titles of the string's records, for seeing which heading was made from one of them
    var recordTitles = recs.Groups.SelectMany(g => g.First).Select(x => x.Title).OfType<string>().Select(t => t.Split(':')[0].Trim()).Where(t => t.Length >= 12).Distinct().ToList();
    // LoC's and ULAN's records among the candidates that have not been pulled: a pull brings what each heading was made from
    var unpulled = ev.Groups.Where(g => g.Members.Any(m => m.Veto != true)).SelectMany(g => g.Members).Where(m => !m.IsStore && m.Source is "loc" or "ulan" && item.Records.TryGetValue(m.Uri, out var ur) && LinkedArtNet.Alignment.Authorities.SourcePull.Read(ur) is null).Select(m => m.Uri).Distinct().Take(12).ToList();
    <h2>@(chosenGroup is not null ? "What it was decided as" : "Candidates")</h2>
    @if (chosenGroup is null && item.Decision.Method == DecisionMethod.Queued && item.LookedAgain is null)
    {
        // why the card waits for a person, read from its evidence (the owner, 2026-11-19: "say why card is queued"; the assistant had met
        // one exact candidate at 1.00 and nothing to say why it had not been accepted)
        var liveGroups = ev.Groups.Where(g => g.Members.Any(m => m.Veto != true && m.SetAside != true)).ToList();
        var topScore = liveGroups.Count == 0 ? 0 : liveGroups.Max(g => g.Score);
        var level = liveGroups.Count(g => g.Score >= topScore - 0.001);
        var acceptAt = Model.Project.Manifest.AcceptScore;
        var why = ev.Groups.Count == 0 ? "the indexes and the project's entities offered nothing for it."
            : liveGroups.Count == 0 ? "every candidate found was ruled out, each for the reason it gives."
            : level >= 2 ? $"{level} candidates are level at {topScore:0.00}, and nothing in the string tells them apart" + (saidOnce.Count > 0 ? ": " + string.Join("; ", saidOnce) + "." : ". The records above may.")
            : topScore < acceptAt ? $"its best candidate scores {topScore:0.00}, under the {acceptAt:0.00} at which a rule may accept."
            : liveGroups.First(g => g.Score >= topScore - 0.001).Sources.Count == 0 && liveGroups.First(g => g.Score >= topScore - 0.001).Members.Any(m => Model.CandidateEntity.ContainsKey(m.Uri)) ? $"its top candidate at {topScore:0.00} was another string's placeholder when this card was written; that string has since been decided, and the entity it went to is offered below."
            : liveGroups.First(g => g.Score >= topScore - 0.001).Sources.Count == 0 ? $"its top candidate at {topScore:0.00} is another string's placeholder in this project, which carries no identifier: a person says whether the two strings are one thing, or which of the records below both are."
            : liveGroups.First(g => g.Score >= topScore - 0.001).Sources.Count < 2 ? $"its one candidate at {topScore:0.00} comes from a single source ({string.Join(", ", liveGroups.First(g => g.Score >= topScore - 0.001).Sources)}). A rule accepts on one source only where the string carries something to check it by, a date or a place; this one does not, so a person confirms it."
            : "the rules did not accept its best candidate" + (saidOnce.Count > 0 ? ": " + string.Join("; ", saidOnce) + "." : ".");
        <p class="small"><strong>Why it waits for a person:</strong> @why</p>
    }
    else if (saidOnce.Count > 0)
    {
        <p class="small muted">Of every candidate below: @string.Join("; ", saidOnce).</p>
    }
    @if (chosenGroup is null && unpulled.Count > 0 && ev.Groups.Count(g => g.Members.Any(m => m.Veto != true)) >= 2)
    {
        @* namesakes told apart by what each heading was made from (the owner, 2026-11-19; the assistant at "Robbins, David (editor)": ten of
           the name, each a name and a year of birth). LoC's record cites the works; a pull brings them, for this card's candidates only *@
        <form method="post" asp-page-handler="Works" data-keep-place asp-route-method="@Model.Method" asp-route-context="@Model.Context" asp-route-id="@item.String.Id" class="inline" style="margin-bottom:.6rem">
            @foreach (var u in unpulled) { <input type="hidden" name="uris" value="@u" /> }
            <button type="submit" class="secondary small" title="Asks the Library of Congress and ULAN for these records: the works each heading was made from, and what else each says of its person or body. Nothing is decided">Fetch what each heading was made from (@unpulled.Count record@(unpulled.Count == 1 ? "" : "s"))</button>
        </form>
    }
    @if (Model.Plan is { } plan)
    {
        @* two or more of the project's own entities among the ticked: what accepting them together will do, shown before it is done, since a
           merge is not undone by Undo (the owner, 2026-11-06, at "Chris Beetles Ltd": the firm's two aligned entities and two placeholders in
           one group, and a warning after the fact that sent them to the entity page) *@
        <form method="post" asp-page-handler="AcceptTogether" asp-route-method="@Model.Method" asp-route-context="@Model.Context" class="notice" id="confirm-together">
            <input type="hidden" name="id" value="@item.String.Id" /><input type="hidden" name="confirmed" value="true" />
            @if (Model.Always) { <input type="hidden" name="always" value="true" /> }
            @foreach (var t in Model.Targets ?? []) { <input type="hidden" name="targets" value="@t" /> }
            <h3 style="margin-top:0">@plan.Ours.Count of the project's own entities are ticked: they become one</h3>
            <p class="small">Choose which survives. The others merge into it, and their strings, identifiers and labels follow. A merge is permanent: <strong>Undo</strong> takes back this string's decision, not the merge.</p>
            @foreach (var e in plan.Ours)
            {
                item.Entities.TryGetValue(e.Id, out var ef);
                <label class="small inline" style="display:block; margin:.3rem 0"><input type="radio" name="survivor" value="@e.Id" checked="@(e.Id == plan.Survivor.Id)" />
                    <strong>@Named(e)</strong> <span class="tag">@e.Class.ToString().ToLowerInvariant()</span> <span class="tag">@e.Status.ToString().ToLowerInvariant()</span>
                    @if (e.Equivalents.Count > 0) { <text>holds @HeldAll(e.Equivalents);</text> } else { <text>no identifier;</text> }
                    @if (ef is not null) { <text>stands for @ef.Strings.Count string@(ef.Strings.Count == 1 ? "" : "s")@(ef.Contexts.Count > 0 ? " (" + string.Join(", ", ef.Contexts.Select(F)) + ")" : "")</text> }
                    · <a href="/p/@Model.Dataset/entity?id=@Uri.EscapeDataString(e.Id)" target="_blank" rel="noopener">its page</a></label>
            }
            @{ var classes = plan.Ours.Select(e => e.Class).Distinct().ToList(); }
            @if (classes.Count > 1)
            {
                @* a Person and a Group do not merge silently: the merged entity's class is chosen here (the owner, 2026-11-07, at "Ackermann and Son") *@
                <p class="small">They differ in class. The merged entity is a
                    <select name="cls">@foreach (var c in classes) { <option value="@c" selected="@(c == plan.Survivor.Class)">@c.ToString().ToLowerInvariant()</option> }</select>
                    (the survivor's unless you choose; the change is noted on it).</p>
            }
            <p class="small">Then @if (plan.Identifiers.Count == 0) { <text>no new identifier is added</text> } else { <text>@plan.Identifiers.Count identifier@(plan.Identifiers.Count == 1 ? "" : "s") added: </text>@for (var n = 0; n < plan.Identifiers.Count; n++) { <text>@(n == 0 ? "" : ", ")</text>@Held(plan.Identifiers[n]) } }, and "@item.String.Raw" is decided onto the survivor.</p>
            <div class="actions"><button type="submit">Merge and accept</button> <a class="button secondary" href="@Url.Page("/Projects/Review", new { dataset = Model.Dataset, method = Model.Method, context = Model.Context, id = item.String.Id })">Back</a></div>
        </form>
    }
        // the store has moved on since this evidence was written: an entity merged into another shows under the survivor's facts, and the
        // desk says so above the candidates rather than let three rows stand for one entity with the run's old reasons (the owner,
        // 2026-11-06, at the next Chris Beetles string)
        var overtaken = item.Entities.Where(kv => kv.Value.Entity.Id != kv.Key)
            .Select(kv => (Was: ev.Groups.SelectMany(g => g.Members).FirstOrDefault(m => m.Uri == kv.Key)?.Label ?? kv.Key, Now: kv.Value.Entity))
            .DistinctBy(o => (o.Was, o.Now.Id)).ToList(); // two placeholders of one label say it once
        var seenEntities = new HashSet<string>(StringComparer.Ordinal);
    @if (overtaken.Count > 0 && item.LookedAgain is null)
    {
        <p class="flash small">The store has changed since this evidence was written: @string.Join("; ", overtaken.Select(o => $"\"{o.Was}\" has merged into {o.Now.Label ?? o.Now.Id}")). The rows below say which.
        <a href="@Url.Page("/Projects/Review", new { dataset = Model.Dataset, method = Model.Method, context = Model.Context, id = item.String.Id, look = true })">Look again</a> shows the string as today's rules see it.</p>
    }
    @if (ev.Groups.Count == 0)
    {
        <p class="muted">The rules found nothing for this string among the kinds of thing its field allows@(reading?.Classes is { Count: > 0 } kinds ? " (" + string.Join(" or ", kinds).ToLowerInvariant() + ")" : "").
            @if (Model.Searched) { <text>A search for "@Model.Q" has been run for you under <a href="#something-else">Something else</a>: it looks at every entity of the project and every index, whatever the kind. If one of its results is the thing, say <strong>Same as this</strong>; if nothing is and the thing is real, keep it as a local authority.</text> }</p>
    }
    @if (ev.Groups.Count > 1 && Model.Method != "human" && chosenGroup is null)
    {
        <form method="post" asp-page-handler="AcceptTogether" asp-route-method="@Model.Method" asp-route-context="@Model.Context" id="together" class="row" style="gap:.5rem; margin:.25rem 0 .75rem">
            <input type="hidden" name="id" value="@item.String.Id" />
            <button type="submit" class="secondary" title="The ticked groups are one thing: one entity with all their identifiers">Accept the ticked together</button>
            <span class="small muted">tick "together" on two or more groups that are the same thing</span>
        </form>
    }
        // the map (the owner, 2026-11-08): namesake places side by side on one map, since seeing the St Iveses apart is how a person picks
        // the right one; a marker per placed candidate, labelled with the record's label and its placement, the best group's markers emphasised
        var points = new List<object>();
        var unplaced = new List<string>();
        var bestGroup = chosenGroup ?? ev.Groups.FirstOrDefault(g => g.Members.Any(m => m.Veto != true && m.SetAside != true));
        // each group that reaches the map has a letter, on its markers and at the head of its card, so that a card and its place can be
        // found from each other (the owner, 2026-11-14, at "Donnington": five namesakes, the labels over one another, and nothing to say
        // which card is which pin); hovering either lights the other, and a marker pressed goes to its card
        var pins = new Dictionary<LinkedArtNet.Alignment.Reconciliation.EvidenceGroup, string>(ReferenceEqualityComparer.Instance);
        string PinOf(LinkedArtNet.Alignment.Reconciliation.EvidenceGroup g)
        {
            if (!pins.TryGetValue(g, out var pin)) pins[g] = pin = pins.Count < 26 ? ((char)('A' + pins.Count)).ToString() : (pins.Count + 1).ToString();
            return pin;
        }
        foreach (var g in shownGroups)
            foreach (var m in g.Members)
            {
                item.Records.TryGetValue(m.Uri, out var rec);
                item.Entities.TryGetValue(m.Uri, out var ef);
                var isPlace = ef?.Entity.Class == EntityClass.Place || rec?.Type == "Place";
                var label = ef is not null ? Named(ef.Entity) : (m.Label ?? rec?.Label ?? m.Uri);
                if (ef is null && rec?.DataJson is { } dj && System.Text.Json.JsonDocument.Parse(dj).RootElement.TryGetProperty("parentString", out var ps) && ps.GetString() is { } parents)
                    label += " (" + string.Join(", ", parents.Split(',').Select(x => x.Trim()).Where(x => x.Length > 0).Take(2)) + ")";
                if (item.Placed is null || !item.Placed.TryGetValue(m.Uri, out var at)) { if (isPlace) unplaced.Add(label); continue; }
                if (at.Near is not null) label += $", near {at.Near}";
                if (at.Via is not null) label += $" (the coordinates of {at.Via})";
                // a borrowed marker is drawn only when the group has none of its own: LoC's "Madison (Wis.)" at the coordinates of TGN's
                // Madison lay over that record's own marker and made it look approximate (the owner's card, 2026-11-15)
                if (at.Approximate && g.Members.Any(o => !ReferenceEquals(o, m) && item.Placed is not null && item.Placed.TryGetValue(o.Uri, out var own) && !own.Approximate)) continue;
                points.Add(new { lat = at.Lat, lng = at.Long, label, chosen = ReferenceEquals(g, bestGroup) && m.Veto != true && m.SetAside != true, approximate = at.Approximate, source = m.Source, pin = PinOf(g), focus = AtHome(g) });
            }
    if (points.Count > 0)
    {
        <div id="map" class="map" data-focus-label="in @homePlace" data-points='@System.Text.Json.JsonSerializer.Serialize(points)' aria-label="The candidates on a map"></div>
        @* a place with no coordinates anywhere is named, so the map's silence about it is not read as absence (the owner, 2026-11-08, at Windsor Castle) *@
        @if (unplaced.Count > 0) { <p class="small muted" style="margin-top:-.6rem">Not on the map, no coordinates in its record: @string.Join(" · ", unplaced.Distinct().Take(6)).</p> }
        @if (points.Any(p => (bool)p.GetType().GetProperty("approximate")!.GetValue(p)!)) { <p class="small muted" style="margin-top:-.4rem">A hollow marker stands where the record itself carries no coordinates: at its TGN parent, or where TGN puts the same name in the same place.</p> }
    }
    var first = true;
    foreach (var group in shownGroups)
    {
        if (chosenGroup is not null && !first && !foldOpen)
        {
            foldOpen = true;
            @Html.Raw($"<details class=\"others\"><summary>The {shownGroups.Count - 1} other candidate{(shownGroups.Count == 2 ? "" : "s")} it was chosen from</summary>")
        }
        var live = group.Members.Where(m => m.Veto != true && m.SetAside != true).ToList();
        var allVeto = live.Count == 0;
        // the project's own firm entities in the group, each followed through a merge and counted once
        var firm = live.Where(m => item.Entities.TryGetValue(m.Uri, out var f) && !f.IsPlaceholder).Select(m => item.Entities[m.Uri].Entity).DistinctBy(e => e.Id).ToList();
        // the one project entity the group's records belong to, whether it was among the candidates or has come to hold them since
        // (seen as a user, 2026-11-20, at "Louvre": the group said "Accept these as one" and each row "Same as Musée du Louvre")
        var heldBy = live.Where(m => Model.CandidateEntity.ContainsKey(m.Uri)).Select(m => Model.CandidateEntity[m.Uri]).DistinctBy(x => x.Id).ToList();
        (string Id, string? Label)? groupEntity = null;
        if (firm.Count == 1) { groupEntity = (firm[0].Id, firm[0].Label); } else if (firm.Count == 0 && heldBy.Count == 1) { groupEntity = heldBy[0]; }
        var isSettled = settledId is not null && heldBy.Any(x => x.Id == settledId);
        // a holder pair's box (the owner, 2026-11-13, at Dagenham: the notice did not say which rows it meant, and its button sat in the
        // flow of the text): the rows still to box, and the merge's own line under the last of them
        var pairLeft = -1;
        Func<IEnumerable<LinkedArtNet.Alignment.Reconciliation.EvidenceMember>, Microsoft.AspNetCore.Html.IHtmlContent> pairFoot = targets => PairFoot(item.String.Id, targets.Select(t => t.Uri));
        var pinOfGroup = pins.TryGetValue(group, out var letter) ? letter : null;
        <div class="card @(first && !allVeto && !live.All(m => (m.Reason ?? "").Contains("qualifier not placed", StringComparison.Ordinal)) ? "best" : "") @(allVeto ? "veto" : "")" data-pin="@pinOfGroup" id="@(pinOfGroup is null ? null : "pin-" + pinOfGroup)">
            <div class="row">
                @if (first) { <a id="top-candidate"></a> }
                @if (pinOfGroup is not null) { <span class="pin" title="This candidate's marker on the map above">@pinOfGroup</span> }
                @if (chosenGroup is not null && ReferenceEquals(group, chosenGroup)) { <span class="tag chosen-tag">decided as this</span> }
                <span class="score">@group.Score.ToString("0.00")</span>
                @foreach (var s in group.Sources) { if (group.Members.FirstOrDefault(m => m.Source == s)?.Uri is { } su) { <a class="tag src" href="@su" target="_blank" rel="noopener" title="@su">@s</a> } else { <span class="tag src">@s</span> } }
                @if (group.Members.Count > 1) { <span class="muted small">@group.Members.Count records agree they are one thing</span> }
                @* the group is the card: its tick and its action are in its header, and the rows of a group of several go quiet (the owner,
                   2026-11-06: ten actions on the rows of a box that is one thing, and "card" read as the row) *@
                @* the chosen group of a decided card offers nothing to accept: it is what the string already is (seen in the browser,
                   2026-11-15: "decided as this" beside a black "Accept these as one") *@
                @if (chosenGroup is not null && ReferenceEquals(group, chosenGroup)) { <span class="small muted" style="margin-left:auto">the string is decided onto this</span> }
                else if (!allVeto && Model.Method != "human")
                {
                    <span style="margin-left:auto"></span>
                    @if (ev.Groups.Count > 1) { <label class="small inline" style="white-space:nowrap" title="This group is one of the things to accept together"><input type="checkbox" name="targets" value="@string.Join(" ", live.Select(m => m.Uri))" form="together" /> together</label> }
                    @if (live.Count > 1 && firm.Count <= 1)
                    {
                        <form method="post" asp-page-handler="AcceptTogether" asp-route-method="@Model.Method" asp-route-context="@Model.Context" class="inline">
                            <input type="hidden" name="id" value="@item.String.Id" />
                            @foreach (var m in live) { <input type="hidden" name="targets" value="@m.Uri" /> }
                            @if (isSettled) { <span class="small muted">settled by the button at the head of this card</span> }
                            else { <button type="submit" title="@(groupEntity is not null ? "The string is this entity, which gets any record of the group it does not hold yet" : "The string is this group: one entity with all its identifiers")">@(groupEntity is { } ge ? $"Same as {NamedById(ge.Id, ge.Label)}" : "Accept these as one")</button> }
                            <button type="submit" name="always" value="true" class="secondary" title="The same, and this exact spelling means it from now on in this field; the variants page can widen a rule to every field">Always, in this field</button>
                        </form>
                    }
                }
            </div>
            @if (firm.Count >= 2 && Model.Method != "human" && Model.Plan is null)
            {
                @* two or more of the project's own firm entities in one group: the store disagrees with itself, which is why the string was
                   queued; the group says so and offers the merge as its own action (the owner, 2026-11-06, at "Chris Beetles Ltd") *@
                <div class="pair-head small">
                    <strong>@firm.Count of the project's entities hold records of this group: the @firm.Count boxed here.</strong>
                    The authorities say they are one thing, and the string was queued because the store disagrees with itself.
                    <a href="/help/scenarios#holder-pair" target="_blank" rel="noopener">How to decide this, with an example</a>.
                    @* two entities that hold different records of one curated source are, by that source, two things: the box says so before
                       the merge is pressed (the owner, 2026-11-14: Tours and Lille under one label, Dagenham the town and the constituency,
                       Poughkeepsie the city and the town, each offered as a pair with "the authorities say they are one thing") *@
                    @{
                        string[] curated = ["loc", "lcsh", "wikidata", "ulan", "tgn", "aat"];
                        var apart = firm.SelectMany(e => e.Equivalents.Where(q => curated.Contains(q.Source)).Select(q => (Entity: e, q.Source, q.Uri)))
                            .GroupBy(x => x.Source).Where(g => g.Select(x => x.Uri).Distinct().Count() > 1 && g.Select(x => x.Entity.Id).Distinct().Count() > 1).ToList();
                    }
                    @if (apart.Count > 0)
                    {
                        <div class="pair-warn">
                            <strong>Look before merging:</strong> they hold different records of @string.Join(" and ", apart.Select(g => g.Key)):
                            @* side by side, with the dates and the other names a record carries, since that is where two bodies of one name
                               show ("Leicester Galleries (1902-1977)" beside "Leicester Galleries (1984- )": the owner, 2026-11-15, having
                               merged them) *@
                            <table class="pair-compare">
                                <thead><tr><th></th>@foreach (var e in firm) { <th>@Named(e)</th> }</tr></thead>
                                <tbody>
                                @foreach (var g in apart)
                                {
                                    <tr>
                                        <th>@g.Key</th>
                                        @foreach (var e in firm)
                                        {
                                            <td>
                                                @foreach (var x in g.Where(x => x.Entity.Id == e.Id).DistinctBy(x => x.Uri))
                                                {
                                                    item.Records.TryGetValue(x.Uri, out var rec);
                                                    <div><a href="@x.Uri" target="_blank" rel="noopener"><strong>@(rec?.Label ?? x.Uri.TrimEnd('/').Split('/').Last())</strong></a>@if (rec?.Lifespan?.Display is { } dates) { <text> · @dates</text> }</div>
                                                    @if (rec is not null && LinkedArtNet.Alignment.Authorities.RecordSummary.Says(rec) is { } says && says != rec.Label) { <div class="small muted">@says</div> }
                                                    @if (rec is not null && rec.Labels.Where(l => l != rec.Label).Take(4).ToList() is { Count: > 0 } also) { <div class="small muted">also: @string.Join(" · ", also)</div> }
                                                }
                                                @if (!g.Any(x => x.Entity.Id == e.Id)) { <span class="muted small">no record of this source</span> }
                                            </td>
                                        }
                                    </tr>
                                }
                                </tbody>
                            </table>
                            A source that keeps two records is usually saying these are two things. If the project means one, remove the set that does not belong on that entity's page first; if it means two, do not merge. <a href="/help/scenarios#the-authorities-hold-two-the-project-means-one" target="_blank" rel="noopener">An example</a>.
                        </div>
                    }
                </div>
                pairLeft = firm.Count;
            }
            @foreach (var m in (firm.Count >= 2 ? group.Members.OrderBy(x => item.Entities.TryGetValue(x.Uri, out var held) && !held.IsPlaceholder ? 0 : 1).ToList() : group.Members))
            {
                item.Records.TryGetValue(m.Uri, out var record);
                item.Entities.TryGetValue(m.Uri, out var facts);
                // the project entity this record belongs to now, when the row is a record and not the entity itself
                (string Id, string? Label)? heldNow = !m.IsStore && Model.CandidateEntity.TryGetValue(m.Uri, out var hn) ? hn : null;
                // a placeholder that has since merged into an entity which another row of the card offers: one button for the entity, the
                // other row's (seen as a user, 2026-11-20: George Allen & Unwin Ltd offered three times after a morning's decisions)
                var mergedInto = m.IsStore && facts is not null && facts.Entity.Id != m.Uri ? facts.Entity.Id : null;
                var offeredElsewhere = mergedInto is not null && ev.Groups.SelectMany(g => g.Members).Any(o => o.Uri != m.Uri && o.Veto != true && o.SetAside != true
                    && Model.CandidateEntity.TryGetValue(o.Uri, out var oc) && oc.Id == mergedInto
                    && (!o.IsStore || o.Uri == mergedInto || string.CompareOrdinal(o.Uri, m.Uri) < 0));
                var sameAsAbove = facts is not null && !seenEntities.Add(facts.Entity.Id);
                // the box of a holder pair: the project's entities the notice speaks of, each a boxed row, and the merge under the last
                var boxed = pairLeft > 0 && facts is not null && !sameAsAbove && firm.Any(e => e.Id == facts.Entity.Id);
                if (pairLeft == 0) { pairLeft = -1; @pairFoot(live) }
                if (boxed) { pairLeft--; }
                <div class="row @(boxed ? "pair-row" : "")" style="@(boxed ? "" : "margin-top:.5rem;") @(m.Veto == true || m.SetAside == true ? "opacity:.6" : "")">
                    <div style="flex:1">
                        @* a project entity's name is the link to its page, in another tab so the desk stays where it is; the URI below it is the
                           URI's own link, as every record's (the owner, 2026-11-05: "Mr Stanley" beside placeholders of the name, which might fold
                           onto it, and nothing to tell them apart but their records) *@
                        @if (m.IsStore || m.Uri.StartsWith(Model.Project.Project.IdentifierBase, StringComparison.Ordinal)) { <strong><a href="/p/@Model.Dataset/entity?id=@Uri.EscapeDataString(m.Uri)" target="_blank" rel="noopener" title="The entity's page: its identifiers, the strings that resolve to it and the records they were seen in">@(m.Label ?? m.Uri)</a></strong> <button type="button" class="tray-add small" data-tray="@(facts?.Entity.Id ?? m.Uri)" data-tray-label="@(facts?.Entity.Label ?? m.Label ?? m.Uri)" data-tray-text="Tray">Tray</button> }
                        else { <strong>@(m.Label ?? record?.Label ?? m.Uri)</strong> }
                        @if (facts?.Placement is { } where) { <span class="muted">(@where)</span> }
                        @* a place record says where it is on its own row, whether or not the string carried a qualifier to compare it with *@
                        else if (facts is null && record?.Type == "Place" && LinkedArtNet.Alignment.Authorities.Coordinates.Parents(record) is { } chain)
                        { <span class="muted">(@string.Join(", ", chain.Split(',').Select(x => x.Trim()).Where(x => x.Length > 0 && x != "World").Take(3)))</span> }
                        @if (record?.Lifespan?.Display is { } life) { <span class="muted">@life</span> }
                        @if (record?.Type is { } type) { <span class="tag">@type.ToLowerInvariant()</span> }
                        @if (facts is not null) { <span class="tag">@facts.Entity.Class.ToString().ToLowerInvariant()</span> <span class="tag">@facts.Entity.Status.ToString().ToLowerInvariant()</span> }
                        <span class="tag">@m.Source</span>
                        <a class="small" href="@m.Uri" target="_blank" rel="noopener">@m.Uri</a>
                        @if (record is not null && record.Labels.Count > 1) { <div class="small muted">also: @string.Join(" · ", record.Labels.Where(l => l != record.Label).Take(6))</div> }
                        @if (record?.DataJson is { } data && System.Text.Json.JsonDocument.Parse(data).RootElement.TryGetProperty("description", out var desc)) { <div class="small">@desc.GetString()</div> }
                        @if (Model.Pictures && LinkedArtNet.Alignment.Authorities.SourcePull.Read(record) is { } pulled)
                        {
                            @if (pulled.Picture is { ThumbUrl: { } th } pic) { <figure class="picture small"><a href="@pic.FilePage" target="_blank" rel="noopener"><img src="@th" alt="@pic.FileName" loading="lazy" /></a><figcaption class="small muted">@pic.Attribution</figcaption></figure> }
                            @if (pulled.Description is not null) { <div class="small">@pulled.Description <span class="muted">(@pulled.Source, pulled @pulled.At.ToLocalTime().ToString("yyyy-MM-dd"))</span></div> }
                        }
                        @if (facts is not null)
                        {
                            @* what put the project's entity in this group, and what it stands for, so the row can be judged without its page
                               (the owner, 2026-11-06, at "Chris Beetles Ltd"); and when the entity has merged since the evidence was written, or
                               is one a row above already stands for, the row says so first *@
                            var held = facts.Entity.Equivalents.Where(q => group.Members.Any(x => x.Uri == q.Uri)).ToList();
                            var others = facts.Entity.Equivalents.Where(q => !group.Members.Any(x => x.Uri == q.Uri)).ToList();
                            var firstString = facts.Strings.OrderByDescending(s => s.String.Occurrences).FirstOrDefault();
                            <div class="small muted">
                                @if (facts.Entity.Id != m.Uri) { <strong>now merged into <a href="/p/@Model.Dataset/entity?id=@Uri.EscapeDataString(facts.Entity.Id)" target="_blank" rel="noopener">@(facts.Entity.Label ?? facts.Entity.Id)</a></strong><text> · </text> }
                                @if (sameAsAbove) { <strong>the same entity as a row above</strong><text> · </text> }
                                @if (held.Count > 0) { <text>the project's entity, holding @HeldAll(held, " and ")@if (others.Count > 0) { <text>; also @HeldAll(others)</text> }</text> }
                                else if (facts.Entity.Equivalents.Count > 0) { <text>the project's entity, aligned to @HeldAll(facts.Entity.Equivalents)</text> }
                                else if (facts.IsPlaceholder) { <text>a placeholder@(firstString is null ? "" : $" for \"{firstString.String.Raw}\" ({F(firstString.String.Context)})")</text> }
                                else { <text>the project's own local authority</text> }
                                · stands for @facts.Strings.Count string@(facts.Strings.Count == 1 ? "" : "s")@(facts.Contexts.Count > 0 ? " (" + string.Join(", ", facts.Contexts.Select(F)) + ")" : "")
                                @if (facts.Examples.Count > 0) { <text>· seen in: @string.Join(" · ", facts.Examples.Select(x => (x.Title ?? x.RecordId) + (x.Date is null ? "" : $" ({x.Date})")))</text> }
                            </div>
                        }
                        <div class="reason">@lessReason(m.Reason)</div>
                        @if (!m.IsStore && item.Records.TryGetValue(m.Uri, out var madeFromRec) && LinkedArtNet.Alignment.Authorities.SourcePull.Read(madeFromRec) is { } madeFrom && madeFrom.Facts.Where(f => f.Key is "Found in" or "Occupation").Select(f => f.Value).ToList() is { Count: > 0 } works)
                        {
                            var namesIt = recordTitles.Any(t => works.Any(w => w.Contains(t, StringComparison.OrdinalIgnoreCase)));
                            <div class="small works"><span class="muted">made from:</span> @string.Join(" · ", works.Take(5))@(works.Count > 5 ? $" · and {works.Count - 5} more" : "")@if (namesIt) { <strong> · names a record of this string</strong> }</div>
                        }
                        @* what the project already has of this candidate, in one line (the owner, 2026-11-20: "fold those three lines into one"): the
                           entity that holds the record, how much stands on it (the owner at "Cape", 2026-11-19), and the longer form if it is the one
                           at the head of the card. The act itself is the row's or the group's button; a link for it is kept only where a group of
                           several records has no button that names the entity *@
                        @if (heldNow is { } hnow)
                        {
                            Model.StandingOn.TryGetValue(m.Uri, out var st);
                            var longerRaw = Model.LongerForms.FirstOrDefault(f => f.EntityId == hnow.Id)?.Raw;
                            var groupNames = groupEntity is { } gn && gn.Id == hnow.Id;
                            <div class="small"><strong>In this project already:</strong> the entity <a href="/p/@Model.Dataset/entity?id=@Uri.EscapeDataString(hnow.Id)" target="_blank" rel="noopener">@(hnow.Label ?? hnow.Id)</a> holds this @("record" + (st is { Records: > 0 } ? $", with {st.Records:N0} record{(st.Records == 1 ? "" : "s")} in {st.Strings:N0} other string{(st.Strings == 1 ? "" : "s")} on it" : "") + (longerRaw is not null ? $", the longer form \"{longerRaw}\" among them" : "")).
                                <span class="muted" title="It says the project uses this record already, and how much. It does not say the earlier decisions were right.">Used, which is not to say rightly.</span>
                                @if (Model.Method != "human" && m.Veto != true && live.Count > 1 && !groupNames) { <form method="post" asp-page-handler="SameAs" asp-route-method="@Model.Method" asp-route-context="@Model.Context" class="inline"><input type="hidden" name="id" value="@item.String.Id" /><input type="hidden" name="entity" value="@hnow.Id" /><button type="submit" class="link small">Same as @(hnow.Label ?? "this entity")</button></form> }
                            </div>
                        }
                    </div>
                    @if (m.Veto == true && Model.Method != "human")
                    {
                        @* ruled out by dates or class, and the person knows better: the catalogue's two years on a birth should not cost a detour
                           through "Something else" (the owner, 2026-11-07, at "Hall, Harry, 1815-1882") *@
                        <form method="post" asp-page-handler="@(m.IsStore ? "SameAs" : "Accept")" asp-route-method="@Model.Method" asp-route-context="@Model.Context" class="inline">
                            <input type="hidden" name="id" value="@item.String.Id" /><input type="hidden" name="@(m.IsStore ? "entity" : "target")" value="@m.Uri" />
                            <button type="submit" class="link small" title="Ruled out for the reason shown; you know better. Recorded as your decision.">accept anyway</button>
                        </form>
                    }
                    else if (m.Veto != true && Model.Method != "human" && live.Count == 1)
                    {
                        @* a group of one record: the row's actions are the group's *@
                        @if (!m.IsStore && !(chosenGroup is not null && ReferenceEquals(group, chosenGroup)))
                        {
                            @if (isSettled) { <span class="small muted">settled by the button at the head of this card</span> } else { <form method="post" asp-page-handler="Accept" asp-route-method="@Model.Method" asp-route-context="@Model.Context" class="inline">
                                <input type="hidden" name="id" value="@item.String.Id" /><input type="hidden" name="target" value="@m.Uri" />
                                @* a record the project already holds: accepting it is saying the string is that entity, and the button says so *@
                                <button type="submit" title="@(heldNow is null ? "The string is this record: an entity is made for it, or found if the project has one" : "This record belongs to the project's entity already: the string is decided onto that entity")">@(heldNow is { } hb ? $"Same as {NamedById(hb.Id, hb.Label)}" : "Accept")</button>
                            </form> }
                            <form method="post" asp-page-handler="Override" asp-route-method="@Model.Method" asp-route-context="@Model.Context" class="inline">
                                <input type="hidden" name="id" value="@item.String.Id" /><input type="hidden" name="target" value="@m.Uri" />
                                <button type="submit" class="secondary" title="Always read this exact spelling as this record when it occurs in this field; the variants page can widen a rule to every field">Always, in this field</button>
                            </form>
                        }
                        else
                        {
                            @if (!isSettled && !offeredElsewhere) { <form method="post" asp-page-handler="SameAs" asp-route-method="@Model.Method" asp-route-context="@Model.Context" class="inline">
                                <input type="hidden" name="id" value="@item.String.Id" /><input type="hidden" name="entity" value="@m.Uri" />
                                <button type="submit">Same as this</button>
                            </form> } else { <span class="small muted">@(isSettled ? "settled by the button at the head of this card" : "now that entity: decided by its other row")</span> }
                        }
                    }
                    else if (m.Veto != true && Model.Method != "human")
                    {
                        @* a quiet way to take one row of a group that is one thing, for the rare case the rest are not it *@
                        <form method="post" asp-page-handler="@(m.IsStore ? "SameAs" : "Accept")" class="inline">
                            <input type="hidden" name="id" value="@item.String.Id" /><input type="hidden" name="@(m.IsStore ? "entity" : "target")" value="@m.Uri" />
                            <button type="submit" class="link small" title="@(m.IsStore ? "Only this entity, not the rest of the group" : "Only this record, not the rest of the group")">just this one</button>
                        </form>
                    }
                </div>
            }
            @if (pairLeft == 0) { pairLeft = -1; @pairFoot(live) }
        </div>
        first = false;
    }
    @if (foldOpen) { @Html.Raw("</details>") }
    @if (ev.Hidden > 0)
    {
        <p class="notice small"><strong>@ev.Hidden more candidate@(ev.Hidden == 1 ? "" : "s") level with these @(ev.Hidden == 1 ? "is" : "are") not shown.</strong> A card keeps twelve: those in the project's home place first, then the most written-about. If the right one is not here, search for it under <a href="#something-else">Something else</a> with a word that tells it apart ("Plymouth Devon").</p>
    }

    <h2 id="something-else">@(chosenGroup is not null ? "Decide it differently" : "Something else")</h2>
    <div class="grid">
        <div class="card">
            @* the search is a form of its own and the results follow it inside the card: a result's own form nested in the search form
               would end it, and the rest of the results would fall out of the card into the grid (the desk, 2026-10-26) *@
            <form method="get" data-keep-place>
                <input type="hidden" name="method" value="@Model.Method" /><input type="hidden" name="context" value="@Model.Context" /><input type="hidden" name="id" value="@item.String.Id" />
                <label for="q">Search the store's entities and the local indexes</label>
                <div class="row"><input type="search" id="q" name="q" value="@(Model.Q ?? reading?.Text ?? item.String.Raw)" style="flex:1" /><button type="submit" class="secondary">Search</button></div>
            </form>
            @if (Model.Q is not null)
            {
                @* what was just done, said where the reader lands after "the record is wrong" *@
                @if (Model.Message is not null && Model.Message.StartsWith("Logged for the cataloguers", StringComparison.Ordinal) || Model.Message?.StartsWith("Already on the cataloguers", StringComparison.Ordinal) == true) { <p class="notice small">@Model.Message</p> }
                @if (Model.Searched && Model.EntityMatches.Count + Model.IndexMatches.Count > 0) { <p class="small"><strong>Found by searching for "@Model.Q"</strong>, since the rules offered nothing:</p> }
                @if (Model.EntityMatches.Count == 0 && Model.IndexMatches.Count == 0) { <p class="muted small">Nothing found for "@Model.Q". The project's entities and the local indexes (TGN, ULAN, AAT, the Library of Congress, Wikidata) were searched and have nothing of that name: it is not there, or is there under another name.</p> }
                @if (Model.NearName is not null) { <p class="small"><strong>Nothing matches all of "@Model.Q".</strong> The indexes were searched, and what follows is everything they have named "@Model.NearName": if the one you want is not among them, the indexes do not have it.</p> }
                @foreach (var e in Model.EntityMatches)
                {
                    <div class="row result"><div style="flex:1"><strong><a href="/p/@Model.Dataset/entity?id=@Uri.EscapeDataString(e.Id)" target="_blank" rel="noopener" title="The entity's page">@e.Label</a></strong> <span class="tag">@e.Class.ToString().ToLowerInvariant()</span> <span class="tag">@e.Status.ToString().ToLowerInvariant()</span>
                        @* which one it is (the owner, 2026-11-19: three places called "Winchester" and nothing to tell them apart; the merge search and the project's search say where a place is and what stands on it, and this had the entity's address in their stead) *@
                        @{ var mc = Model.MatchClues.GetValueOrDefault(e.Id); }
                        @if (mc.Placement is not null) { <span class="muted">(@mc.Placement)</span> }
                        <br /><span class="small muted">@(e.Equivalents.Count == 0 ? "no identifiers" : string.Join(" ", e.Equivalents.Select(q => q.Source).Distinct()))@if (Model.MatchClues.ContainsKey(e.Id)) { <text> · stands for @mc.Strings string@(mc.Strings == 1 ? "" : "s")</text> }</span></div>
                        <form method="post" asp-page-handler="SameAs" asp-route-method="@Model.Method" asp-route-context="@Model.Context" class="inline"><input type="hidden" name="id" value="@item.String.Id" /><input type="hidden" name="entity" value="@e.Id" /><button type="submit">Same as</button></form></div>
                }
                @foreach (var r in Model.IndexMatches)
                {
                    <div class="row result">@if (Model.IndexMatches.Count > 1) { <input type="checkbox" form="found-together" name="targets" value="@r.Uri" title="Tick the records that are one thing, then Accept the ticked as one" style="margin-right:.5rem" /> }<div style="flex:1"><strong>@r.Label</strong> @if (r.Lifespan?.Display is { } l) { <span class="muted">@l</span> } @if (!string.IsNullOrWhiteSpace(r.Type)) { <span class="tag">@r.Type.ToLowerInvariant()</span> } <span class="tag">@r.Source</span>
                        @* what the record is, so that two results of one name can be told apart (the owner, 2026-11-14: two Wikidata "Brockley"s, a village in Suffolk and the district of London, and an empty tag where one had no kind) *@
                        @if (LinkedArtNet.Alignment.Authorities.RecordSummary.Says(r) is { } says && says != r.Label) { <div class="small muted">@says</div> } else { <br /> }
                        <a class="small" href="@r.Uri" target="_blank" rel="noopener">@r.Uri</a></div>
                        <form method="post" asp-page-handler="Accept" asp-route-method="@Model.Method" asp-route-context="@Model.Context" class="inline"><input type="hidden" name="id" value="@item.String.Id" /><input type="hidden" name="target" value="@r.Uri" /><button type="submit">Accept</button></form></div>
                }
            }
            @if (Model.Q is not null && Model.IndexMatches.Count > 1)
            {
                @* one thing in two indexes (seen as a user, 2026-11-23: LoC's and Wikidata's Gainesville, and a button for each) *@
                <form id="found-together" method="post" asp-page-handler="AcceptTogether" asp-route-method="@Model.Method" asp-route-context="@Model.Context" class="small" style="margin-top:.6rem">
                    <input type="hidden" name="id" value="@item.String.Id" />
                    <button type="submit" class="secondary">Accept the ticked as one</button> <span class="muted">where two indexes have the same thing: one entity, with each identifier ticked</span>
                </form>
            }
        </div>
        <form method="post" asp-page-handler="Local" asp-route-method="@Model.Method" asp-route-context="@Model.Context" class="card">
            <input type="hidden" name="id" value="@item.String.Id" />
            <h3 style="margin-top:0">None of these: it is real and local</h3>
            <p class="small muted">Keeps the entity as a confirmed local authority, in no external source. The pipeline stops asking.</p>
            <label for="label">Label (as it should be published)</label>
            <input type="text" id="label" name="label" value="@(item.Entity?.Label ?? reading?.Text)" />
            @* what kind of thing it is: the field's kinds first, then the rest, since a publisher may be a house and a subject anything
               (the owner, 2026-11-14, keeping the publisher "Osterley Park": "should I be able to choose the class?") *@
            @{
                var fieldKinds = Model.Project.Manifest.Contexts.TryGetValue(item.String.Context, out var rule) ? rule.Classes : new List<EntityClass>();
                var isNow = item.Entity?.Class ?? (fieldKinds.Count > 0 ? fieldKinds[0] : EntityClass.Group);
                var kindsOffered = fieldKinds.Concat(Enum.GetValues<EntityClass>()).Distinct().ToList();
            }
            <label for="lcls">It is a</label>
            <select id="lcls" name="cls" title="The kinds this field usually holds come first; choose another when the thing is not one of them">
                @foreach (var k in kindsOffered) { <option value="@k" selected="@(k == isNow)">@k.ToString().ToLowerInvariant()@(fieldKinds.Contains(k) ? "" : " (not usual in this field)")</option> }
            </select>
            <label for="lnote">Note</label>
            <input type="text" id="lnote" name="note" placeholder="Edinburgh dealer, not the national gallery" />
            <label for="lurl">Known elsewhere (URL, optional)</label>
            <input type="text" id="lurl" name="url" placeholder="https://manuscripts.nls.uk/agents/corporate_entities/1476" title="An archive's agent page, a VIAF cluster: kept as the entity's identifier" />
            <div class="actions"><button type="submit">Keep as local authority</button></div>
        </form>
        @* the third answer (the owner, 2026-11-22, to "S" in a place of publication and "s.n." in 375 records' publisher): not a thing at
           all. One button, and the reason chosen beside it; the reason the string itself suggests is chosen to begin with *@
        @{ var looksLike = System.Text.RegularExpressions.Regex.IsMatch(item.String.Raw, @"^\W*(s\W*[nl]|.*not identified|\p{L}\??|\P{L}+)\W*$", System.Text.RegularExpressions.RegexOptions.IgnoreCase) ? CurationService.SuggestedReason([item.String.Raw]) : null; }
        <form method="post" asp-page-handler="NotAName" asp-route-method="@Model.Method" asp-route-context="@Model.Context" class="card">
            <input type="hidden" name="id" value="@item.String.Id" />
            <h3 style="margin-top:0">It is not a name</h3>
            <p class="small muted">No entity is made for it and the string leaves the queue. Say which it is:</p>
            <p class="small"><label style="text-transform:none; letter-spacing:normal; font-size:inherit; font-weight:400; color:inherit; margin:0"><input type="radio" name="reason" value="@CurationService.NothingKnown" required @(looksLike == CurationService.NothingKnown ? "checked" : "") /> <strong>Nothing is known.</strong> The cataloguer wrote that the book does not say: "s.n." (no publisher named), "S.l." (no place), "[publisher not identified]". The record is as it should be.</label></p>
            <p class="small"><label style="text-transform:none; letter-spacing:normal; font-size:inherit; font-weight:400; color:inherit; margin:0"><input type="radio" name="reason" value="@CurationService.RecordWantsFixing" required @(looksLike == CurationService.RecordWantsFixing ? "checked" : "") /> <strong>The record wants fixing.</strong> A stray letter or number where a name should be ("S", "21"), for a cataloguer to look at.</label></p>
            <label for="nnote">Note</label>
            <input type="text" id="nnote" name="note" placeholder="what is left of “S.l.”, by the look of it" />
            <div class="actions"><button type="submit">Not a name</button></div>
        </form>
    </div>

    @* the ways out (the owner, 2026-11-23): a card that cannot be decided as it stands has a named way out for each reason, and each
       leaves a record that a list shows. Not a decision: the string stays to be decided, or is set aside saying why *@
    var cardEntities = item.Entities.Values.Where(f => !f.IsPlaceholder).Select(f => f.Entity).Concat(item.Entity is { Status: not EntityStatus.Provisional } own ? [own] : Array.Empty<LinkedArtNet.Alignment.Entity>())
            .Concat(Model.EntityMatches.Where(e => e.Status != EntityStatus.Provisional).Take(8)).DistinctBy(e => e.Id).ToList();
    <h2 id="ways-out">Can't decide it as it stands?</h2>
    <p class="small muted">Say why, and it is recorded where someone will see it. None of these decides the string.</p>
    <div class="grid">
        <form method="post" asp-page-handler="RecordWrong" asp-route-method="@Model.Method" asp-route-context="@Model.Context" class="card">
            <input type="hidden" name="id" value="@item.String.Id" />
            <h3 style="margin-top:0">The record is wrong</h3>
            <p class="small muted">A misspelling, two things in one field, the wrong field. It goes on the list for the cataloguers, on each record that has this text; then the card looks for what it should have been.</p>
            <label for="wkind">What is wrong</label>
            <select id="wkind" name="kind">@foreach (var k in Finding.DeskKinds) { <option value="@k">@k</option> }</select>
            <label for="wshould">It should read</label>
            <input type="text" id="wshould" name="shouldRead" placeholder="the text as it ought to be" />
            <label for="wnote">Note for the cataloguer (optional)</label>
            <input type="text" id="wnote" name="note" />
            <div class="actions"><button type="submit" class="secondary">Log it for the cataloguers</button></div>
        </form>
        <div class="card">
            <form method="post" asp-page-handler="SetAside" asp-route-method="@Model.Method" asp-route-context="@Model.Context">
                <input type="hidden" name="id" value="@item.String.Id" /><input type="hidden" name="mixed" value="true" />
                <h3 style="margin-top:0">It is different things in different records</h3>
                <p class="small muted">One spelling, and the records mean two places or two people by it. It cannot be decided as one string; it is set aside to be decided record by record.</p>
                <input type="text" name="text" placeholder="which records are which, if you can say (optional)" />
                <div class="actions"><button type="submit" class="secondary">Set aside: decide by record</button></div>
            </form>
            <form method="post" asp-page-handler="SetAside" asp-route-method="@Model.Method" asp-route-context="@Model.Context" style="margin-top:1.2rem">
                <input type="hidden" name="id" value="@item.String.Id" /><input type="hidden" name="mixed" value="false" />
                <h3 style="margin-top:0">Not sure: it wants someone who knows</h3>
                <input type="text" name="text" placeholder="what would someone need to know to decide it?" />
                <div class="actions"><button type="submit" class="secondary">Set aside with this question</button></div>
            </form>
        </div>
        @if (cardEntities.Count > 0)
        {
            <form method="post" asp-page-handler="ReportEntity" asp-route-method="@Model.Method" asp-route-context="@Model.Context" class="card">
                <input type="hidden" name="id" value="@item.String.Id" />
                <h3 style="margin-top:0">An entity of the project is wrong</h3>
                <p class="small muted">One of the project's own entities on this card is aligned to the wrong thing, is two things, or says too little to tell. A note goes on the entity, and it is listed to be put right.</p>
                <label for="rentity">Which</label>
                <select id="rentity" name="entity">@foreach (var ce in cardEntities) { <option value="@ce.Id">@NamedById(ce.Id, ce.Label) · @ce.Class.ToString().ToLowerInvariant()</option> }</select>
                <label for="rtext">What is wrong with it</label>
                <input type="text" id="rtext" name="text" required />
                <div class="actions"><button type="submit" class="secondary">Report the entity</button></div>
            </form>
        }
    </div>

    <div class="actions" style="margin-top:1.5rem">
        @if (item.SkippedAt is { } skipped)
        {
            <form method="post" asp-page-handler="Unskip" asp-route-method="@Model.Method" asp-route-context="@Model.Context" class="inline"><input type="hidden" name="id" value="@item.String.Id" /><button type="submit" class="quiet" title="Skipped @skipped.ToString("yyyy-MM-dd HH:mm"): back to its place in the desk's order">Unskip</button></form>
        }
        else
        {
            <form method="post" asp-page-handler="Skip" asp-route-method="@Model.Method" asp-route-context="@Model.Context" class="inline"><input type="hidden" name="id" value="@item.String.Id" /><button type="submit" class="quiet" title="To the back of the desk: it comes round again after everything else, in this session or the next">Skip for now</button></form>
        }
        <form method="post" asp-page-handler="Undo" asp-route-method="@Model.Method" asp-route-context="@Model.Context" class="inline"><input type="hidden" name="id" value="@item.String.Id" /><button type="submit" class="quiet" title="Take back the latest decision on this string">Undo last decision</button></form>
        <form method="post" asp-page-handler="Flag" asp-route-method="@Model.Method" asp-route-context="@Model.Context" class="row inline" style="gap:.4rem"><input type="hidden" name="id" value="@item.String.Id" /><input type="text" name="text" placeholder="Note for another reviewer" style="width:18rem" /><button type="submit" class="quiet">Add note</button></form>
        <a class="button secondary" href="@Url.Page("/Projects/Review", new { dataset = Model.Dataset, method = Model.Method, context = Model.Context, after = item.String.Id })">Next →</a>
    </div>
}
@section Scripts {
    <script>
    // what is ticked on the card travels with whichever deciding button is pressed: records, to be decided for themselves; other
    // strings, to be decided with this one. Without scripts the ticks do nothing and the buttons decide the string, as before.
    (function () {
        function ticked(sel) { return Array.prototype.slice.call(document.querySelectorAll(sel + ":checked")); }
        function show() {
            var n = ticked("input[data-records]").length, note = document.getElementById("by-record-note");
            if (note) { note.hidden = n === 0; document.getElementById("by-record-count").textContent = n === 1 ? "1 record or group" : n + " records or groups"; }
        }
        document.addEventListener("change", function (e) { if (e.target && e.target.hasAttribute && e.target.hasAttribute("data-records")) show(); });
        // a search reloads the card: what was ticked goes with it and is ticked again (seen as a user: three records ticked, a search
        // for the place they were, and the ticks gone)
        document.addEventListener("submit", function (e) {
            var f = e.target; if (!f.matches || !f.matches("form[method=get]")) return;
            ticked("input[data-records], input[data-also]").forEach(function (c) { var h = document.createElement("input"); h.type = "hidden"; h.name = "tick"; h.value = c.value; f.appendChild(h); });
        }, true);
        new URLSearchParams(location.search).getAll("tick").forEach(function (v) {
            document.querySelectorAll("input[data-records], input[data-also]").forEach(function (c) { if (c.value === v) { c.checked = true; var d = c.closest("details"); if (d) d.open = true; } });
        });
        document.addEventListener("submit", function (e) {
            var f = e.target, action = (f.getAttribute && f.getAttribute("action")) || "";
            if (!/handler=(Accept|SameAs|AcceptTogether)\b/.test(action)) return;
            function carry(name, sel) { ticked(sel).forEach(function (c) { var h = document.createElement("input"); h.type = "hidden"; h.name = name; h.value = c.value; f.appendChild(h); }); }
            carry("records", "input[data-records]"); carry("also", "input[data-also]");
        }, true);
        show();
    })();
    </script>
    <partial name="_Map" />
}
