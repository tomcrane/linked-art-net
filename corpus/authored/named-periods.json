{
  "$schema": "../schema/corpus-entry.schema.json",
  "source": {
    "name": "Authored: named periods and regnal years",
    "licence": "CC0-1.0",
    "notes": "Period names resolved by the built-in tables (Japanese eras and periods, Chinese dynasties and reign periods, British periods and reigns, conventional archaeological periods), regnal years, and periods combined with bands, hedges and ranges. Expectations checked by hand against the tables under the default profile."
  },
  "defaults": { "intent": "single", "profile": "default", "status": "verified", "tags": ["named-period"] },
  "entries": [
    { "id": "per-001", "input": "Edo period", "tags": ["japanese"],
      "expect": { "status": "parsed", "canonical": "period:edo", "edtf": "1603/1868", "flags": ["NamedPeriod"],
        "timespan": { "begin_of_the_begin": "1603-01-01T00:00:00Z", "end_of_the_end": "1868-12-31T23:59:59Z" } } },
    { "id": "per-002", "input": "Edo", "tags": ["japanese"],
      "expect": { "status": "parsed", "canonical": "period:edo" } },
    { "id": "per-003", "input": "江戸時代", "tags": ["japanese", "script"],
      "expect": { "status": "parsed", "canonical": "period:edo" } },
    { "id": "per-004", "input": "early Edo period", "tags": ["japanese", "band"],
      "expect": { "status": "parsed", "canonical": "early period:edo", "flags": ["NamedPeriod", "Band"],
        "timespan": { "begin_of_the_begin": "1603-01-01T00:00:00Z", "end_of_the_end": "1692-12-31T23:59:59Z" } },
      "notes": "266 years long, so the century band table applies, scaled by 2.66: early = positions 0-33 = 1603-1692." },
    { "id": "per-005", "input": "Meiji period", "tags": ["japanese", "era"],
      "expect": { "status": "parsed", "canonical": "period:meiji",
        "timespan": { "begin_of_the_begin": "1868-10-23T00:00:00Z", "end_of_the_end": "1912-07-30T23:59:59Z" } } },
    { "id": "per-006", "input": "Meiji 27", "tags": ["japanese", "regnal"],
      "expect": { "status": "parsed", "canonical": "period:meiji-27", "edtf": "1894",
        "timespan": { "begin_of_the_begin": "1894-01-01T00:00:00Z", "end_of_the_end": "1894-12-31T23:59:59Z" } } },
    { "id": "per-007", "input": "Meiji 27 (1894)", "tags": ["japanese", "regnal", "parenthesised"],
      "expect": { "status": "parsed", "canonical": "period:meiji-27" },
      "notes": "The parenthesised Western year repeats the regnal year and is not a second date." },
    { "id": "per-008", "input": "Shōwa 45", "tags": ["japanese", "regnal", "diacritic"],
      "expect": { "status": "parsed", "canonical": "period:showa-45", "years": { "start": 1970, "end": 1970 } } },
    { "id": "per-009", "input": "Heisei", "tags": ["japanese", "era"],
      "expect": { "status": "parsed", "canonical": "period:heisei", "timespan": { "begin_of_the_begin": "1989-01-08T00:00:00Z", "end_of_the_end": "2019-04-30T23:59:59Z" } } },
    { "id": "per-010", "input": "Reiwa", "tags": ["japanese", "era", "open-end"],
      "expect": { "status": "parsed", "canonical": "period:reiwa", "flags": ["OpenEnd"], "timespan": { "begin_of_the_begin": "2019-05-01T00:00:00Z" } } },
    { "id": "per-011", "input": "Kangxi period", "tags": ["chinese", "reign"],
      "expect": { "status": "parsed", "canonical": "period:kangxi", "edtf": "1662/1722" } },
    { "id": "per-012", "input": "Kangxi 12", "tags": ["chinese", "regnal"],
      "expect": { "status": "parsed", "canonical": "period:kangxi-12", "years": { "start": 1673, "end": 1673 } } },
    { "id": "per-013", "input": "Qianlong 60th year", "tags": ["chinese", "regnal"],
      "expect": { "status": "parsed", "canonical": "period:qianlong-60", "years": { "start": 1795, "end": 1795 } } },
    { "id": "per-014", "input": "Ming dynasty", "tags": ["chinese", "dynasty"],
      "expect": { "status": "parsed", "canonical": "period:ming", "edtf": "1368/1644" } },
    { "id": "per-015", "input": "late Ming", "tags": ["chinese", "dynasty", "band"],
      "expect": { "status": "parsed", "canonical": "late period:ming", "edtf": "1553/1644" } },
    { "id": "per-016", "input": "Ming - Qing dynasty", "tags": ["chinese", "dynasty", "range"],
      "expect": { "status": "parsed", "canonical": "period:ming/period:qing", "edtf": "1368/1912" } },
    { "id": "per-017", "input": "Tang dynasty", "tags": ["chinese", "dynasty"],
      "expect": { "status": "parsed", "canonical": "period:tang", "edtf": "0618/0907" } },
    { "id": "per-018", "input": "Western Zhou", "tags": ["chinese", "dynasty", "bce"],
      "expect": { "status": "parsed", "canonical": "period:western-zhou", "edtf": "-1045/-0770", "flags": ["Bce"] } },
    { "id": "per-019", "input": "Victorian", "tags": ["british"],
      "expect": { "status": "parsed", "canonical": "period:victorian", "edtf": "1837/1901" } },
    { "id": "per-020", "input": "late Victorian", "tags": ["british", "band"],
      "expect": { "status": "parsed", "canonical": "late period:victorian", "edtf": "1882/1901" } },
    { "id": "per-021", "input": "Regency period", "tags": ["british"],
      "expect": { "status": "parsed", "canonical": "period:regency", "edtf": "1811/1820" } },
    { "id": "per-022", "input": "George III", "tags": ["british", "reign"],
      "expect": { "status": "parsed", "canonical": "period:george-iii",
        "timespan": { "begin_of_the_begin": "1760-10-25T00:00:00Z", "end_of_the_end": "1820-01-29T23:59:59Z" } } },
    { "id": "per-023", "input": "c. Georgian", "tags": ["british", "circa"],
      "expect": { "status": "parsed", "canonical": "period:georgian~", "flags": ["Approximate", "NamedPeriod"] } },
    { "id": "per-024", "input": "Roman Britain", "tags": ["archaeological"],
      "expect": { "status": "parsed", "canonical": "period:roman-britain", "edtf": "0043/0410" } },
    { "id": "per-025", "input": "medieval", "tags": ["archaeological"],
      "expect": { "status": "parsed", "canonical": "period:medieval", "edtf": "1066/1485" },
      "notes": "British convention; a continental profile would supply 500-1500." },
    { "id": "per-026", "input": "Second World War", "tags": ["event"],
      "expect": { "status": "parsed", "canonical": "period:second-world-war",
        "timespan": { "begin_of_the_begin": "1939-09-01T00:00:00Z", "end_of_the_end": "1945-09-02T23:59:59Z" } } },
    { "id": "per-027", "input": "Baroque", "tags": ["style"],
      "expect": { "status": "unparsed" },
      "notes": "Styles are not periods; a profile may add a style table." },
    { "id": "per-028", "input": "Victoria 10", "tags": ["british", "not-regnal"],
      "expect": { "status": "parsed", "canonical": "period:victoria", "flags": ["Unconsumed"], "maxConfidence": 0.8 },
      "notes": "British reigns are not regnal-counted in the tables: the reign is read and the number left unconsumed." },
    { "id": "per-029", "input": "period:edo", "tags": ["canonical"],
      "expect": { "status": "parsed", "canonical": "period:edo", "minConfidence": 1 } },
    { "id": "per-030", "input": "Edo period, 18th century", "tags": ["japanese", "century", "multiple-dates"],
      "expect": { "status": "parsed", "canonical": "period:edo/century 18", "flags": ["NamedPeriod"], "maxConfidence": 0.9 },
      "notes": "Two dates with nothing joining them: the span covers both, at reduced confidence. The owner may prefer the narrower reading; policy open." }
  ]
}
