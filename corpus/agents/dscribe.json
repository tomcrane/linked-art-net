{
  "source": {
    "name": "Authored: DScribe / CALM agent strings (Paul Mellon Centre form)",
    "licence": "CC0-1.0",
    "notes": "The 'Surname, Forenames [Honorific, dates] (role)' convention of the Paul Mellon Centre's DScribe exports. Seeded from the shapes in the pmc-2 branch's ParsedAgentTests, with invented names; expectations checked by hand. The nested 'dates' expectation is the dates corpus's shape and is checked by the dates parser."
  },
  "defaults": { "profile": "dscribe", "status": "verified", "tags": ["dscribe"] },
  "entries": [
    { "id": "ds-001", "input": "Ashworth, Mary [1958-] (editor)", "tags": ["open-end"],
      "expect": { "kind": "person", "name": "Ashworth, Mary", "familyName": "Ashworth", "givenNames": "Mary", "displayName": "Mary Ashworth", "dateText": "1958-", "roleLabels": ["editor"], "noUnconsumed": true,
        "dates": { "status": "parsed", "canonical": "1958/..", "kind": "birthDeath" } } },
    { "id": "ds-002", "input": "Leconte de Lisle, Charles Marie [1818-1894] (author)", "tags": ["lifespan"],
      "expect": { "kind": "person", "name": "Leconte de Lisle, Charles Marie", "familyName": "Leconte de Lisle", "givenNames": "Charles Marie", "dateText": "1818-1894", "roleLabels": ["author"], "noUnconsumed": true,
        "dates": { "status": "parsed", "kind": "birthDeath", "canonical": "1818/1894", "years": { "start": 1818, "end": 1894 } } } },
    { "id": "ds-003", "input": "Grierson, Herbert John Clifford [Sir, 1866-1960] (preface by)", "tags": ["honorific", "role-phrase"],
      "expect": { "kind": "person", "name": "Grierson, Herbert John Clifford", "honorifics": ["Sir"], "dateText": "1866-1960", "roles": ["preface by"], "roleLabels": ["writer of preface"], "noUnconsumed": true, "minConfidence": 0.9,
        "dates": { "status": "parsed", "kind": "birthDeath", "canonical": "1866/1960" } } },
    { "id": "ds-004", "input": "Reynolds, Joshua [Sir, 1723-1792] (artist)", "tags": ["honorific"],
      "expect": { "kind": "person", "name": "Reynolds, Joshua", "honorifics": ["Sir"], "dateText": "1723-1792", "roleLabels": ["artist"], "noUnconsumed": true,
        "dates": { "status": "parsed", "kind": "birthDeath", "canonical": "1723/1792" } } },
    { "id": "ds-005", "input": "Hogarth, William [1697-1764]", "tags": ["lifespan", "no-role"],
      "expect": { "kind": "person", "name": "Hogarth, William", "dateText": "1697-1764", "roles": [], "noUnconsumed": true,
        "dates": { "status": "parsed", "kind": "birthDeath", "canonical": "1697/1764" } } },
    { "id": "ds-006", "input": "Turner, J. M. W. [1775-1851] (artist)", "tags": ["initials"],
      "expect": { "kind": "person", "name": "Turner, J. M. W.", "familyName": "Turner", "givenNames": "J. M. W.", "dateText": "1775-1851", "roleLabels": ["artist"], "noUnconsumed": true } },
    { "id": "ds-007", "input": "Waterhouse, Ellis [1905-1985] (introduction by)", "tags": ["role-phrase"],
      "expect": { "kind": "person", "name": "Waterhouse, Ellis", "roleLabels": ["writer of introduction"], "noUnconsumed": true,
        "dates": { "status": "parsed", "kind": "birthDeath", "canonical": "1905/1985" } } },
    { "id": "ds-008", "input": "Royal Academy of Arts [1768-] (publisher)", "tags": ["group", "open-end"],
      "expect": { "kind": "group", "name": "Royal Academy of Arts", "familyName": null, "dateText": "1768-", "roleLabels": ["publisher"], "noUnconsumed": true } },
    { "id": "ds-009", "input": "Thames & Hudson Ltd (publisher)", "tags": ["group", "no-dates"],
      "expect": { "kind": "group", "name": "Thames & Hudson Ltd", "noDates": true, "roleLabels": ["publisher"], "noUnconsumed": true } },
    { "id": "ds-010", "input": "Paul Mellon Centre for Studies in British Art (publisher)", "tags": ["group"],
      "expect": { "kind": "group", "name": "Paul Mellon Centre for Studies in British Art", "roleLabels": ["publisher"], "noDates": true } },
    { "id": "ds-011", "input": "Smith, John [fl. 1750-1780] (engraver)", "tags": ["floruit"],
      "expect": { "kind": "person", "name": "Smith, John", "dateText": "fl. 1750-1780", "roleLabels": ["engraver"],
        "dates": { "status": "parsed", "kind": "floruit", "canonical": "fl 1750/1780" } } },
    { "id": "ds-012", "input": "Smith, John [c. 1700-1765] (artist)", "tags": ["circa"],
      "expect": { "kind": "person", "name": "Smith, John", "dateText": "c. 1700-1765",
        "dates": { "status": "parsed", "flags": ["Approximate"] } } },
    { "id": "ds-013", "input": "Smith, John [b. 1902] (editor)", "tags": ["born-only"],
      "expect": { "kind": "person", "name": "Smith, John", "dateText": "b. 1902", "roleLabels": ["editor"],
        "dates": { "status": "parsed", "canonical": "born 1902" } } },
    { "id": "ds-014", "input": "Smith, John [-1690] (author)", "tags": ["died-only"],
      "expect": { "kind": "person", "name": "Smith, John", "dateText": "-1690",
        "dates": { "status": "parsed", "canonical": "../1690" } } },
    { "id": "ds-015", "input": "Smith, John [1866-1960, Sir] (preface by)", "tags": ["honorific", "order"],
      "expect": { "kind": "person", "name": "Smith, John", "honorifics": ["Sir"], "dateText": "1866-1960", "roleLabels": ["writer of preface"], "noUnconsumed": true },
      "notes": "The bracket contents in the other order read the same." },
    { "id": "ds-016", "input": "Smith, John (attributed)", "tags": ["qualifier"],
      "expect": { "kind": "person", "name": "Smith, John", "qualifiers": ["attributedTo"], "noDates": true, "roles": [] } },
    { "id": "ds-017", "input": "Smith, John [see also Jones, Mary]", "tags": ["unplaceable"],
      "expect": { "kind": "person", "name": "Smith, John", "noDates": true, "maxConfidence": 0.9 },
      "notes": "A cross-reference in brackets is not a date, honorific or qualifier; it is reported as unplaced and lowers the confidence." },
    { "id": "ds-018", "input": "Sir Joshua Reynolds (contributor of two plates)", "tags": ["direct-order", "unknown-role"],
      "expect": { "kind": "person", "name": "Joshua Reynolds", "honorifics": ["Sir"], "roles": ["contributor of two plates"], "noDates": true, "maxConfidence": 0.95 } },
    { "id": "ds-019", "input": "Smith, John [b. 12 May, 1866] (author)", "tags": ["comma-in-date"], "status": "proposed",
      "expect": { "kind": "person", "name": "Smith, John", "dateText": "b. 12 May, 1866",
        "dates": { "status": "parsed", "canonical": "born 1866-05-12" } },
      "notes": "The agent parser keeps the date in one piece; the dates parser reads 'b. 12 May, 1866' only partially (the comma between month and year), so this stays a target for the dates grammar." },
    { "id": "ds-020", "input": "Anonymous", "tags": ["anonymous"],
      "expect": { "kind": "unknown", "qualifiers": ["anonymous"], "noDates": true } }
  ]
}
