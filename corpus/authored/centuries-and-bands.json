{
  "$schema": "../schema/corpus-entry.schema.json",
  "source": {
    "name": "Authored: centuries, decades and bands",
    "licence": "CC0-1.0",
    "notes": "Ordinal centuries in several notations (14th century, C14, XIVth c., 1300s), the popular convention (19th century = 1800-1899), bands (early 0-33, mid 34-66, late 67-99 of a century; early 0-3, mid 3-6, late 7-9 of a decade; halves and quarters exact; beginning/end = first/last decade of a century), shared suffixes ('early - mid 13th century') and hedged bands. Expectations checked by hand under the default profile."
  },
  "defaults": { "intent": "single", "profile": "default", "status": "verified", "tags": ["century"] },
  "entries": [
    { "id": "cen-001", "input": "19th century", "tags": ["ordinal"],
      "expect": { "status": "parsed", "canonical": "century 19", "edtf": "1800/1899",
        "timespan": { "begin_of_the_begin": "1800-01-01T00:00:00Z", "end_of_the_end": "1899-12-31T23:59:59Z" } } },
    { "id": "cen-002", "input": "nineteenth century", "tags": ["ordinal", "word"],
      "expect": { "status": "parsed", "canonical": "century 19" } },
    { "id": "cen-003", "input": "C19", "tags": ["ordinal", "abbreviated"],
      "expect": { "status": "parsed", "canonical": "century 19" } },
    { "id": "cen-004", "input": "19th c.", "tags": ["ordinal", "abbreviated"],
      "expect": { "status": "parsed", "canonical": "century 19" } },
    { "id": "cen-005", "input": "XIXth century", "tags": ["ordinal", "roman"],
      "expect": { "status": "parsed", "canonical": "century 19" } },
    { "id": "cen-006", "input": "s. XIV", "tags": ["ordinal", "roman", "spanish"],
      "expect": { "status": "parsed", "canonical": "century 14", "edtf": "1300/1399" } },
    { "id": "cen-007", "input": "1800s", "tags": ["unspecified-digits", "ambiguous"],
      "expect": { "status": "parsed", "canonical": "18XX", "edtf": "18XX",
        "timespan": { "begin_of_the_begin": "1800-01-01T00:00:00Z", "end_of_the_end": "1899-12-31T23:59:59Z" } },
      "notes": "'1800s' is read as the century (1800-1899), not the decade 1800-1809; the decade reading is an alternative." },
    { "id": "cen-008", "input": "1st century", "tags": ["ordinal"],
      "expect": { "status": "parsed", "canonical": "century 1", "edtf": "0000/0099" },
      "notes": "Popular convention gives 0-99; year 0 is 1 BCE, which is the convention's known wrinkle." },
    { "id": "cen-009", "input": "21st century", "tags": ["ordinal"],
      "expect": { "status": "parsed", "canonical": "century 21", "edtf": "2000/2099" } },
    { "id": "cen-010", "input": "early 14th century", "tags": ["ordinal", "band"],
      "expect": { "status": "parsed", "canonical": "early century 14", "edtf": "1300/1333",
        "timespan": { "begin_of_the_begin": "1300-01-01T00:00:00Z", "end_of_the_end": "1333-12-31T23:59:59Z" }, "flags": ["Band"] } },
    { "id": "cen-011", "input": "mid-14th century", "tags": ["ordinal", "band", "hyphenated"],
      "expect": { "status": "parsed", "canonical": "mid century 14", "edtf": "1334/1366" } },
    { "id": "cen-012", "input": "late 14th century", "tags": ["ordinal", "band"],
      "expect": { "status": "parsed", "canonical": "late century 14", "edtf": "1367/1399" } },
    { "id": "cen-013", "input": "first half of the 14th century", "tags": ["ordinal", "band", "half"],
      "expect": { "status": "parsed", "canonical": "h1 century 14", "edtf": "1300/1349" } },
    { "id": "cen-014", "input": "2nd half 14th century", "tags": ["ordinal", "band", "half", "abbreviated"],
      "expect": { "status": "parsed", "canonical": "h2 century 14", "edtf": "1350/1399" } },
    { "id": "cen-015", "input": "second quarter of the 14th century", "tags": ["ordinal", "band", "quarter"],
      "expect": { "status": "parsed", "canonical": "q2 century 14", "edtf": "1325/1349" } },
    { "id": "cen-016", "input": "last quarter of the 19th century", "tags": ["ordinal", "band", "quarter"],
      "expect": { "status": "parsed", "canonical": "q4 century 19", "edtf": "1875/1899" } },
    { "id": "cen-017", "input": "beginning of the 19th century", "tags": ["ordinal", "band"],
      "expect": { "status": "parsed", "canonical": "beginning century 19", "edtf": "1800/1809" } },
    { "id": "cen-018", "input": "end of the 19th century", "tags": ["ordinal", "band"],
      "expect": { "status": "parsed", "canonical": "end century 19", "edtf": "1890/1899" } },
    { "id": "cen-019", "input": "turn of the century", "tags": ["idiom"],
      "expect": { "status": "unparsed" },
      "notes": "Which century is not stated; a profile with a reference century could resolve it, the default does not guess." },
    { "id": "cen-020", "input": "early - mid 13th century", "tags": ["ordinal", "band", "range", "shared-suffix"],
      "expect": { "status": "parsed", "canonical": "early century 13/mid century 13", "edtf": "1200/1266" } },
    { "id": "cen-021", "input": "late 13th - early 14th century", "tags": ["ordinal", "band", "range", "shared-suffix"],
      "expect": { "status": "parsed", "canonical": "late century 13/early century 14", "edtf": "1267/1333" } },
    { "id": "cen-022", "input": "c. late 15th century", "tags": ["ordinal", "band", "circa"],
      "expect": { "status": "parsed", "canonical": "late century 15~", "edtf": "1467/1499",
        "timespan": { "begin_of_the_begin": "1467-01-01T00:00:00Z", "end_of_the_end": "1499-12-31T23:59:59Z" }, "flags": ["Approximate", "Band"] } },
    { "id": "cen-023", "input": "1950s", "tags": ["decade"],
      "expect": { "status": "parsed", "canonical": "195X", "edtf": "195X" } },
    { "id": "cen-024", "input": "the 1950's", "tags": ["decade", "apostrophe", "article"],
      "expect": { "status": "parsed", "canonical": "195X" } },
    { "id": "cen-025", "input": "early 1950s", "tags": ["decade", "band"],
      "expect": { "status": "parsed", "canonical": "early 195X", "edtf": "1950/1953" } },
    { "id": "cen-026", "input": "mid-1950s", "tags": ["decade", "band", "hyphenated"],
      "expect": { "status": "parsed", "canonical": "mid 195X", "edtf": "1953/1956" } },
    { "id": "cen-027", "input": "late 1950s", "tags": ["decade", "band"],
      "expect": { "status": "parsed", "canonical": "late 195X", "edtf": "1957/1959",
        "timespan": { "begin_of_the_begin": "1957-01-01T00:00:00Z", "end_of_the_end": "1959-12-31T23:59:59Z" } } },
    { "id": "cen-028", "input": "1900-10s", "tags": ["decade", "range", "abbreviated-end"],
      "expect": { "status": "parsed", "canonical": "1900/191X", "edtf": "1900/191X",
        "timespan": { "begin_of_the_begin": "1900-01-01T00:00:00Z", "end_of_the_end": "1919-12-31T23:59:59Z" } } },
    { "id": "cen-029", "input": "18th or 19th century", "tags": ["ordinal", "disjunction"],
      "expect": { "status": "parsed", "canonical": "[century 18,century 19]", "edtf": "1700/1899", "flags": ["Disjunction"] } },
    { "id": "cen-030", "input": "17th-18th century", "tags": ["ordinal", "range"],
      "expect": { "status": "parsed", "canonical": "century 17/century 18", "edtf": "1600/1799" } }
  ]
}
