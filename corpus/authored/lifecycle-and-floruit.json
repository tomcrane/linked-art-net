{
  "$schema": "../schema/corpus-entry.schema.json",
  "source": {
    "name": "Authored: lifecycles and floruit",
    "licence": "CC0-1.0",
    "notes": "Birth-death pairs in the forms found in authority files and catalogue headings ('1606-1669', 'b. 1850', 'd. 1920', '1606?-1669', '(1606-1669)'), floruit ('fl. 1480-1510', 'active 1920s'), and the pair/auto intents. Pair intent splits an interval into Begin (birth) and End (death); a single marked date gives one half; an unmarked single date is Partial. Expectations checked by hand."
  },
  "defaults": { "intent": "pair", "profile": "default", "status": "verified", "tags": ["lifecycle"] },
  "entries": [
    { "id": "life-001", "input": "1606-1669", "tags": ["pair", "range"],
      "expect": { "status": "parsed", "kind": "birthDeath", "canonical": "1606/1669",
        "begin": { "begin_of_the_begin": "1606-01-01T00:00:00Z", "end_of_the_end": "1606-12-31T23:59:59Z" },
        "end": { "begin_of_the_begin": "1669-01-01T00:00:00Z", "end_of_the_end": "1669-12-31T23:59:59Z" } } },
    { "id": "life-002", "input": "(1606-1669)", "tags": ["pair", "range", "parenthesised"],
      "expect": { "status": "parsed", "kind": "birthDeath", "canonical": "1606/1669" } },
    { "id": "life-003", "input": "1606?-1669", "tags": ["pair", "range", "uncertain"],
      "expect": { "status": "parsed", "kind": "birthDeath", "canonical": "1606?/1669", "flags": ["Uncertain"],
        "begin": { "begin_of_the_begin": "1606-01-01T00:00:00Z", "end_of_the_end": "1606-12-31T23:59:59Z" } } },
    { "id": "life-004", "input": "c. 1606-1669", "tags": ["pair", "range", "circa"],
      "expect": { "status": "parsed", "kind": "birthDeath", "canonical": "1606~/1669", "flags": ["Approximate"] },
      "notes": "A leading circa hedges the first date only." },
    { "id": "life-005", "input": "1606-", "tags": ["pair", "open-end"],
      "expect": { "status": "parsed", "kind": "birthDeath", "canonical": "1606/..",
        "begin": { "begin_of_the_begin": "1606-01-01T00:00:00Z", "end_of_the_end": "1606-12-31T23:59:59Z" }, "flags": ["OpenEnd"] },
      "notes": "Living person or death unknown: no End span." },
    { "id": "life-006", "input": "b. 1850", "tags": ["born"],
      "expect": { "status": "parsed", "kind": "birthDeath", "canonical": "born 1850",
        "begin": { "begin_of_the_begin": "1850-01-01T00:00:00Z", "end_of_the_end": "1850-12-31T23:59:59Z" }, "flags": ["Lifecycle"] } },
    { "id": "life-007", "input": "born 1850", "tags": ["born", "word"],
      "expect": { "status": "parsed", "kind": "birthDeath", "canonical": "born 1850" } },
    { "id": "life-008", "input": "d. 1920", "tags": ["died"],
      "expect": { "status": "parsed", "kind": "birthDeath", "canonical": "died 1920",
        "end": { "begin_of_the_begin": "1920-01-01T00:00:00Z", "end_of_the_end": "1920-12-31T23:59:59Z" } } },
    { "id": "life-009", "input": "died c. 1920", "tags": ["died", "circa"],
      "expect": { "status": "parsed", "kind": "birthDeath", "canonical": "died 1920~", "flags": ["Approximate"] } },
    { "id": "life-010", "input": "† 1920", "tags": ["died", "dagger"],
      "expect": { "status": "parsed", "kind": "birthDeath", "canonical": "died 1920" } },
    { "id": "life-011", "input": "* 1850 † 1920", "tags": ["pair", "symbols"],
      "expect": { "status": "parsed", "kind": "birthDeath", "canonical": "born 1850/died 1920" },
      "notes": "Genealogical symbols; both halves marked." },
    { "id": "life-012", "input": "bapt. 1606", "tags": ["baptised"],
      "expect": { "status": "parsed", "kind": "birthDeath", "canonical": "baptised 1606",
        "begin": { "begin_of_the_begin": "1606-01-01T00:00:00Z", "end_of_the_end": "1606-12-31T23:59:59Z" } },
      "notes": "A baptism stands in for the birth date; the caller decides whether to record it as such." },
    { "id": "life-013", "input": "bur. 1669", "tags": ["buried"],
      "expect": { "status": "parsed", "kind": "birthDeath", "canonical": "buried 1669",
        "end": { "begin_of_the_begin": "1669-01-01T00:00:00Z", "end_of_the_end": "1669-12-31T23:59:59Z" } } },
    { "id": "life-014", "input": "fl. 1480-1510", "tags": ["floruit", "range"],
      "expect": { "status": "parsed", "kind": "floruit", "canonical": "fl 1480/1510",
        "timespan": { "begin_of_the_begin": "1480-01-01T00:00:00Z", "end_of_the_end": "1510-12-31T23:59:59Z" },
        "begin": { "begin_of_the_begin": "1480-01-01T00:00:00Z", "end_of_the_end": "1480-12-31T23:59:59Z" },
        "end": { "begin_of_the_begin": "1510-01-01T00:00:00Z", "end_of_the_end": "1510-12-31T23:59:59Z" }, "flags": ["Floruit"] } },
    { "id": "life-015", "input": "flourished 1480", "tags": ["floruit", "word"],
      "expect": { "status": "parsed", "kind": "floruit", "canonical": "fl 1480",
        "timespan": { "begin_of_the_begin": "1480-01-01T00:00:00Z", "end_of_the_end": "1480-12-31T23:59:59Z" } } },
    { "id": "life-016", "input": "active 1920s", "tags": ["floruit", "active", "decade"],
      "expect": { "status": "parsed", "kind": "floruit", "canonical": "fl 192X",
        "timespan": { "begin_of_the_begin": "1920-01-01T00:00:00Z", "end_of_the_end": "1929-12-31T23:59:59Z" } } },
    { "id": "life-017", "input": "active c. 1500-1530", "tags": ["floruit", "active", "circa", "range"],
      "expect": { "status": "parsed", "kind": "floruit", "canonical": "fl 1500~/1530", "flags": ["Floruit", "Approximate"] } },
    { "id": "life-018", "input": "fl. C14", "tags": ["floruit", "century", "abbreviated"],
      "expect": { "status": "parsed", "kind": "floruit", "canonical": "fl century 14",
        "timespan": { "begin_of_the_begin": "1300-01-01T00:00:00Z", "end_of_the_end": "1399-12-31T23:59:59Z" } } },
    { "id": "life-019", "input": "1850", "tags": ["single", "partial"],
      "expect": { "status": "partial", "kind": "single", "canonical": "1850",
        "timespan": { "begin_of_the_begin": "1850-01-01T00:00:00Z", "end_of_the_end": "1850-12-31T23:59:59Z" } },
      "notes": "A pair was asked for; one unmarked date comes back as a single span and Partial." },
    { "id": "life-020", "input": "1606-1669", "intent": "single", "tags": ["single-intent", "range"],
      "expect": { "status": "parsed", "kind": "single", "canonical": "1606/1669",
        "timespan": { "begin_of_the_begin": "1606-01-01T00:00:00Z", "end_of_the_end": "1669-12-31T23:59:59Z" } },
      "notes": "The same text under Single intent is one span." },
    { "id": "life-021", "input": "1606-1669", "intent": "auto", "tags": ["auto-intent", "range"],
      "expect": { "status": "parsed", "kind": "single", "canonical": "1606/1669" },
      "notes": "Auto intent gives a pair only when lifecycle markers are present." },
    { "id": "life-022", "input": "b. 1850", "intent": "auto", "tags": ["auto-intent", "born"],
      "expect": { "status": "parsed", "kind": "birthDeath", "canonical": "born 1850" } },
    { "id": "life-023", "input": "1669-1606", "tags": ["pair", "inverted"],
      "expect": { "status": "parsed", "kind": "birthDeath", "canonical": "1669/1606", "flags": ["Inverted"],
        "begin": { "begin_of_the_begin": "1606-01-01T00:00:00Z", "end_of_the_end": "1606-12-31T23:59:59Z" } } },
    { "id": "life-024", "input": "1850-1920", "profile": "default", "tags": ["pair", "range", "formation"],
      "expect": { "status": "parsed", "kind": "birthDeath", "canonical": "1850/1920" },
      "notes": "FormationDissolution is the same shape; the caller chooses the kind for a Group." }
  ]
}
