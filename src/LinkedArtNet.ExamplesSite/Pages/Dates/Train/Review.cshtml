@page "/dates/train/review/{id?}"
@model LinkedArtNet.ExamplesSite.Pages.Dates.Train.ReviewModel
@{
    ViewData["Title"] = "Review";
}
<nav class="crumbs"><a href="/dates/train">Trainer</a> › Review</nav>
@if (Model.Item is null)
{
    <h1>Nothing to review</h1>
    <p>The queue is empty. <a href="/dates/train">Add inputs</a> or import captured ones.</p>
}
else
{
    <h1>Review <q>@Model.Item.Input</q></h1>
    <p class="meta">@Model.Pending waiting · from @Model.Item.Source · queued @Model.Item.AddedAt.ToString("yyyy-MM-dd")</p>

    @if (Model.Error is not null)
    {
        <aside class="notice">@Model.Error</aside>
    }

    <section class="result">
        <h2>What the parser says <span class="status status-@Model.Parsed.Status.ToString().ToLowerInvariant()">@Model.Parsed.Status.ToString().ToLowerInvariant()</span>
            <span class="muted">@ReviewModel.Kind(Model.Parsed) · confidence @Model.Parsed.Confidence.ToString("0.00") · @Model.Parsed.Strategy · profile @Model.Parsed.Profile</span></h2>
        <dl class="kv">
            @if (Model.Parsed.Canonical is not null) { <dt>Canonical</dt><dd><code>@Model.Parsed.Canonical</code></dd> }
            @if (Model.Parsed.Edtf is not null) { <dt>EDTF</dt><dd><code>@Model.Parsed.Edtf</code></dd> }
            @if (Model.Parsed.UnconsumedText is not null) { <dt>Not understood</dt><dd><q>@Model.Parsed.UnconsumedText</q></dd> }
            @if (Model.Parsed.Alternatives.Count > 0) { <dt>Other readings</dt><dd>@foreach (var a in Model.Parsed.Alternatives) { <code>@a.Canonical</code> <small class="muted">(@a.Confidence.ToString("0.00"), @a.Note)</small><br /> }</dd> }
        </dl>
        @if (Model.Parsed.Notes.Count > 0) { <ul class="notes">@foreach (var n in Model.Parsed.Notes) { <li>@n</li> }</ul> }
        <div class="json-pair">
            @foreach (var (label, json) in ReviewModel.Spans(Model.Parsed)) { <div><h3>@label</h3><pre><code class="language-json">@json</code></pre></div> }
        </div>
    </section>

    @if (Model.Item.Proposal is { } proposal)
    {
        <section class="result proposal">
            <h2>What @proposal.Model proposes <span class="muted">asked @proposal.At.ToString("yyyy-MM-dd HH:mm")@(proposal.Canonical is null ? "" : $" · confidence {proposal.Confidence:0.00}")</span></h2>
            @if (proposal.Canonical is null)
            {
                <p>@proposal.Rationale</p>
            }
            else
            {
                <dl class="kv">
                    <dt>Canonical</dt><dd><code>@proposal.Canonical</code>@if (!proposal.Realisable) { <span class="diff"> · not an expression this parser can realise, so it is not pre-filled</span> }</dd>
                    @if (proposal.Intent is not null) { <dt>Intent</dt><dd>@proposal.Intent</dd> }
                    @if (proposal.Rationale is not null) { <dt>Why</dt><dd>@proposal.Rationale</dd> }
                </dl>
                <p class="muted">A proposal, not a verdict: the correction form below is pre-filled with it. Preview, then save it or change it.</p>
            }
        </section>
    }
    else if (Model.CanPropose)
    {
        <form method="post" class="inline-form propose">
            <input type="hidden" name="id" value="@Model.Item.Id" />
            <button type="submit" asp-page-handler="Propose">Ask @Model.InterpreterModel for a reading</button>
            <span class="muted">Sends this text, the profile and the parser's view; the answer is a canonical expression for you to confirm.</span>
        </form>
    }

    <form method="post" class="stack review-form" id="review">
        <input type="hidden" name="id" value="@Model.Item.Id" />
        <div class="row">
            @if (Model.Item.Proposal is { Canonical: not null })
            {
                <button type="submit" asp-page-handler="Accept" title="The parser's answer, not the proposal, is right">Accept the parser's reading@(Model.Parsed.Canonical is null ? "" : $" ({Model.Parsed.Canonical})")</button>
                <span class="muted">To keep the proposed reading, save the correction below.</span>
            }
            else
            {
                <button type="submit" asp-page-handler="Accept" class="primary" title="The parser's answer is right">Accept as is</button>
            }
            <button type="submit" asp-page-handler="Skip" title="Leave it for someone else">Skip</button>
        </div>
        <h2>Or correct it</h2>
        <div class="row">
            <label>Expected status
                <select name="expectedStatus" id="expectedStatus">
                    @foreach (var s in new[] { "parsed", "undated", "unparsed" }) { <option value="@s" selected="@(Model.ExpectedStatus == s)">@s</option> }
                </select>
            </label>
            <label>Intent
                <select name="intent" id="intent">@foreach (var i in new[] { "auto", "single", "pair" }) { <option value="@i" selected="@(Model.Intent == i)">@i</option> }</select>
            </label>
            <label>Profile
                <select name="profile" id="profile">@foreach (var p in Model.Profiles) { <option value="@p" selected="@(Model.Profile == p)">@p</option> }</select>
            </label>
        </div>
        <label>Canonical expression <a class="muted" href="/about#canonical" target="_blank">(reference)</a>
            <input type="text" name="canonical" id="canonical" value="@Model.Canonical" autocomplete="off" spellcheck="false" placeholder="e.g. late 195X, century 19, born 1606/died 1669, period:edo" />
        </label>
        <div id="preview" class="preview" aria-live="polite">
            @if (Model.Preview is { } pv)
            {
                <p><strong>Preview:</strong> <code>@pv.Canonical</code> @if (pv.Edtf is not null) { <text>· EDTF <code>@pv.Edtf</code></text> } · @ReviewModel.Kind(pv)</p>
                <div class="json-pair">@foreach (var (label, json) in ReviewModel.Spans(pv)) { <div><h3>@label</h3><pre><code>@json</code></pre></div> }</div>
            }
            else if (Model.PreviewError is not null)
            {
                <p class="diff">@Model.PreviewError</p>
            }
        </div>
        <div class="row">
            <label>Tags (comma separated) <input type="text" name="tags" value="@Model.Tags" placeholder="century, band" /></label>
            <label class="grow">Notes <input type="text" name="notes" value="@Model.Notes" placeholder="why this reading" /></label>
        </div>
        <div class="row">
            <button type="submit" asp-page-handler="Preview">Preview</button>
            <button type="submit" asp-page-handler="Save" class="primary">Save correction</button>
        </div>
    </form>
}
@section Scripts {
    <script src="~/train.js" asp-append-version="true"></script>
}
