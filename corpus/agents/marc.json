{
  "source": {
    "name": "Authored: MARC / RDA name headings",
    "licence": "CC0-1.0",
    "notes": "Library headings with dates and relator terms after the name: 'Surname, Forenames, 1818-1894', 'active', 'approximately', an honorific as its own segment, open-ended dates, relator abbreviations. Shapes from AACR2/RDA practice as seen in Wellcome and Library of Congress headings; the names are real where the dates are public knowledge and invented otherwise. Expectations checked by hand. Dates read under the 'library' dates profile."
  },
  "defaults": { "profile": "marc", "status": "verified", "tags": ["marc"] },
  "entries": [
    { "id": "mc-001", "input": "Leconte de Lisle, Charles Marie, 1818-1894", "tags": ["lifespan"],
      "expect": { "kind": "person", "name": "Leconte de Lisle, Charles Marie", "familyName": "Leconte de Lisle", "givenNames": "Charles Marie", "dateText": "1818-1894", "roles": [], "noUnconsumed": true,
        "dates": { "status": "parsed", "kind": "birthDeath", "canonical": "1818/1894" } } },
    { "id": "mc-002", "input": "Rembrandt Harmenszoon van Rijn, 1606-1669", "tags": ["direct-order"],
      "expect": { "kind": "person", "name": "Rembrandt Harmenszoon van Rijn", "dateText": "1606-1669", "noUnconsumed": true,
        "dates": { "status": "parsed", "kind": "birthDeath", "canonical": "1606/1669" } },
      "notes": "One comma only, before the dates: the name is in direct order and is not split into family and given names." },
    { "id": "mc-003", "input": "Rembrandt Harmenszoon van Rijn, 1606-1669, artist", "tags": ["relator"],
      "expect": { "kind": "person", "name": "Rembrandt Harmenszoon van Rijn", "dateText": "1606-1669", "roleLabels": ["artist"], "noUnconsumed": true } },
    { "id": "mc-004", "input": "Smith, John, active 1640-1660", "tags": ["active"],
      "expect": { "kind": "person", "name": "Smith, John", "dateText": "active 1640-1660",
        "dates": { "status": "parsed", "kind": "floruit", "canonical": "fl 1640/1660" } } },
    { "id": "mc-005", "input": "Smith, John, approximately 1600-1650", "tags": ["approximately"],
      "expect": { "kind": "person", "name": "Smith, John", "dateText": "approximately 1600-1650",
        "dates": { "status": "parsed", "flags": ["Approximate"] } } },
    { "id": "mc-006", "input": "Smith, John, Sir, 1866-1960", "tags": ["honorific"],
      "expect": { "kind": "person", "name": "Smith, John", "honorifics": ["Sir"], "dateText": "1866-1960", "noUnconsumed": true } },
    { "id": "mc-007", "input": "Smith, John, 1900-", "tags": ["open-end"],
      "expect": { "kind": "person", "name": "Smith, John", "dateText": "1900-",
        "dates": { "status": "parsed", "canonical": "1900/..", "kind": "birthDeath" } } },
    { "id": "mc-008", "input": "Smith, John, -1690", "tags": ["died-only"],
      "expect": { "kind": "person", "name": "Smith, John", "dateText": "-1690",
        "dates": { "status": "parsed", "canonical": "../1690" } } },
    { "id": "mc-009", "input": "Smith, John, 1900-1980, ill.", "tags": ["relator-abbreviation"],
      "expect": { "kind": "person", "name": "Smith, John", "roles": ["ill."], "roleLabels": ["illustrator"], "dateText": "1900-1980" } },
    { "id": "mc-010", "input": "Smith, John, 1900-1980, ed.", "tags": ["relator-abbreviation"],
      "expect": { "kind": "person", "name": "Smith, John", "roleLabels": ["editor"], "dateText": "1900-1980" } },
    { "id": "mc-011", "input": "Smith, John, Jr., 1920-", "tags": ["suffix"],
      "expect": { "kind": "person", "name": "Smith, John, Jr.", "dateText": "1920-" },
      "notes": "A generational suffix stays with the name; it is not an honorific. The name keeps its two commas and so is not split into parts." },
    { "id": "mc-012", "input": "Smith, John, 1900-1980 (Spirit)", "tags": ["qualifier-in-parentheses"],
      "expect": { "kind": "person", "name": "Smith, John", "dateText": "1900-1980", "maxConfidence": 0.9 },
      "notes": "A parenthesised qualifier the tables do not know ('(Spirit)' is an RDA addition) is reported as unplaced." },
    { "id": "mc-013", "input": "Society of Antiquaries of London", "tags": ["group"],
      "expect": { "kind": "group", "name": "Society of Antiquaries of London", "noDates": true, "noUnconsumed": true } },
    { "id": "mc-014", "input": "Great Britain. Parliament. House of Commons", "tags": ["group", "hierarchy"],
      "expect": { "kind": "group", "name": "Great Britain. Parliament. House of Commons", "noDates": true },
      "notes": "A corporate hierarchy with full stops; 'Parliament' is not in the corporate words but 'House' is not either; it is a group by the structure of the heading. Status proposed until the parser reads headings' hierarchy.", "status": "proposed" },
    { "id": "mc-015", "input": "Smith, John, 1900-1980, author of introduction", "tags": ["relator-phrase"],
      "expect": { "kind": "person", "name": "Smith, John", "dateText": "1900-1980", "roleLabels": ["writer of introduction"] },
      "notes": "A MARC relator phrase; the trailing-segment rule takes only known roles off a heading, so unknown relators stay on the name until the table learns them." }
  ]
}
