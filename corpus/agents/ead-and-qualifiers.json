{
  "source": {
    "name": "Authored: EAD authority forms and attribution qualifiers",
    "licence": "CC0-1.0",
    "notes": "Semicolon-separated authority names as EAD and ISAAR practice writes them ('Surname; Forenames (dates); epithet'), and the attribution qualifiers museum cataloguing wraps round a name ('attributed to', 'after', 'circle of', 'and others'). Expectations checked by hand; names invented or public figures."
  },
  "defaults": { "status": "verified" },
  "entries": [
    { "id": "ea-001", "input": "Smith; John (1900-1980); artist", "profile": "ead", "tags": ["ead"],
      "expect": { "kind": "person", "name": "Smith, John", "familyName": "Smith", "givenNames": "John", "dateText": "1900-1980", "roleLabels": ["artist"], "noUnconsumed": true,
        "dates": { "status": "parsed", "kind": "birthDeath", "canonical": "1900/1980" } } },
    { "id": "ea-002", "input": "Reynolds; Sir Joshua (1723-1792); painter", "profile": "ead", "tags": ["ead", "honorific"],
      "expect": { "kind": "person", "name": "Reynolds, Joshua", "honorifics": ["Sir"], "dateText": "1723-1792", "roleLabels": ["painter"] } },
    { "id": "ea-003", "input": "Royal Academy of Arts; 1768-", "profile": "ead", "tags": ["ead", "group"],
      "expect": { "kind": "group", "name": "Royal Academy of Arts", "dateText": "1768-" },
      "notes": "Two parts only: the second is the dates, not forenames.", "status": "proposed" },
    { "id": "ea-004", "input": "Smith; John (fl. 1750-1780); engraver; of London", "profile": "ead", "tags": ["ead", "floruit", "epithets"],
      "expect": { "kind": "person", "name": "Smith, John", "dateText": "fl. 1750-1780", "roles": ["engraver", "of London"], "roleLabels": ["engraver", "of london"], "maxConfidence": 0.95 },
      "notes": "The place epithet is kept as a role the table does not know; a later version may classify epithets of place separately." },
    { "id": "qu-001", "input": "attributed to Rembrandt", "profile": "default", "tags": ["qualifier"],
      "expect": { "kind": "person", "name": "Rembrandt", "qualifiers": ["attributedTo"], "noDates": true, "noUnconsumed": true } },
    { "id": "qu-002", "input": "after Rembrandt", "profile": "default", "tags": ["qualifier"],
      "expect": { "kind": "person", "name": "Rembrandt", "qualifiers": ["after"], "noUnconsumed": true } },
    { "id": "qu-003", "input": "Circle of Rembrandt", "profile": "default", "tags": ["qualifier"],
      "expect": { "kind": "person", "name": "Rembrandt", "qualifiers": ["circleOf"], "noUnconsumed": true } },
    { "id": "qu-004", "input": "Workshop of Rembrandt", "profile": "default", "tags": ["qualifier"],
      "expect": { "kind": "person", "name": "Rembrandt", "qualifiers": ["workshopOf"] } },
    { "id": "qu-005", "input": "Rembrandt and others", "profile": "default", "tags": ["qualifier"],
      "expect": { "kind": "person", "name": "Rembrandt", "qualifiers": ["andOthers"] } },
    { "id": "qu-006", "input": "Rembrandt et al.", "profile": "default", "tags": ["qualifier"],
      "expect": { "kind": "person", "name": "Rembrandt", "qualifiers": ["andOthers"] } },
    { "id": "qu-007", "input": "Rembrandt (attributed)", "profile": "default", "tags": ["qualifier"],
      "expect": { "kind": "person", "name": "Rembrandt", "qualifiers": ["attributedTo"] } },
    { "id": "qu-008", "input": "Rembrandt?", "profile": "default", "tags": ["qualifier"],
      "expect": { "kind": "person", "name": "Rembrandt", "qualifiers": ["possibly"] } },
    { "id": "qu-009", "input": "formerly attributed to Rembrandt", "profile": "default", "tags": ["qualifier"],
      "expect": { "kind": "person", "name": "Rembrandt", "qualifiers": ["formerly"] } },
    { "id": "qu-010", "input": "Unknown artist", "profile": "default", "tags": ["anonymous"],
      "expect": { "kind": "unknown", "qualifiers": ["unknown"], "noDates": true } },
    { "id": "qu-011", "input": "Anon.", "profile": "default", "tags": ["anonymous"],
      "expect": { "kind": "unknown", "qualifiers": ["anonymous"] } },
    { "id": "qu-012", "input": "Smith, John, 1900-1980 (pseud.)", "profile": "default", "tags": ["pseudonym"],
      "expect": { "kind": "person", "name": "Smith, John", "qualifiers": ["pseudonym"], "dateText": "1900-1980" } }
  ]
}
