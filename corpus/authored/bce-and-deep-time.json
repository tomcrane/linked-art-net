{
  "$schema": "../schema/corpus-entry.schema.json",
  "source": {
    "name": "Authored: BCE and deep time",
    "licence": "CC0-1.0",
    "notes": "Era words, astronomical year numbering (1 BCE = 0000, 500 BCE = -0499), BCE centuries (always strict: 5th century BCE = 500-401 BCE), ranges across the era boundary, and geological time counted back from 1950 (BP) or the present (taken as 2026 in tests). Expectations checked by hand under the default profile."
  },
  "defaults": { "intent": "single", "profile": "default", "status": "verified", "tags": ["bce"] },
  "entries": [
    { "id": "bce-001", "input": "500 BC", "tags": ["year", "era"],
      "expect": { "status": "parsed", "canonical": "-0499", "edtf": "-0499",
        "timespan": { "begin_of_the_begin": "-0499-01-01T00:00:00Z", "end_of_the_end": "-0499-12-31T23:59:59Z" }, "flags": ["Bce"] } },
    { "id": "bce-002", "input": "500 BCE", "tags": ["year", "era"],
      "expect": { "status": "parsed", "canonical": "-0499", "edtf": "-0499" } },
    { "id": "bce-003", "input": "500 B.C.", "tags": ["year", "era", "punctuated"],
      "expect": { "status": "parsed", "canonical": "-0499" } },
    { "id": "bce-004", "input": "1 BC", "tags": ["year", "era", "year-zero"],
      "expect": { "status": "parsed", "canonical": "0000",
        "timespan": { "begin_of_the_begin": "0000-01-01T00:00:00Z", "end_of_the_end": "0000-12-31T23:59:59Z" } },
      "notes": "1 BCE is astronomical year 0." },
    { "id": "bce-005", "input": "AD 79", "tags": ["year", "era", "era-first"],
      "expect": { "status": "parsed", "canonical": "0079", "edtf": "0079",
        "timespan": { "begin_of_the_begin": "0079-01-01T00:00:00Z", "end_of_the_end": "0079-12-31T23:59:59Z" }, "notFlags": ["Bce"] } },
    { "id": "bce-006", "input": "79 CE", "tags": ["year", "era"],
      "expect": { "status": "parsed", "canonical": "0079" } },
    { "id": "bce-007", "input": "c. 2500 BCE", "tags": ["year", "era", "circa"],
      "expect": { "status": "parsed", "canonical": "-2499~", "edtf": "-2499~",
        "timespan": { "begin_of_the_begin": "-2499-01-01T00:00:00Z", "end_of_the_end": "-2499-12-31T23:59:59Z" }, "flags": ["Approximate", "Bce"] } },
    { "id": "bce-008", "input": "5th century BC", "tags": ["century", "era"],
      "expect": { "status": "parsed", "canonical": "century -5", "edtf": "-0499/-0400",
        "timespan": { "begin_of_the_begin": "-0499-01-01T00:00:00Z", "end_of_the_end": "-0400-12-31T23:59:59Z" } },
      "notes": "BCE centuries count strictly: 500-401 BCE." },
    { "id": "bce-009", "input": "1st century BCE", "tags": ["century", "era"],
      "expect": { "status": "parsed", "canonical": "century -1", "edtf": "-0099/0000" } },
    { "id": "bce-010", "input": "late 5th century BC", "tags": ["century", "era", "band"],
      "expect": { "status": "parsed", "canonical": "late century -5", "edtf": "-0432/-0400",
        "timespan": { "begin_of_the_begin": "-0432-01-01T00:00:00Z", "end_of_the_end": "-0400-12-31T23:59:59Z" }, "flags": ["Band"] } },
    { "id": "bce-011", "input": "2nd millennium BC", "tags": ["millennium", "era"],
      "expect": { "status": "parsed", "canonical": "millennium -2", "edtf": "-1999/-1000" } },
    { "id": "bce-012", "input": "480-479 BC", "tags": ["range", "era", "shared-era"],
      "expect": { "status": "parsed", "canonical": "-0479/-0478", "edtf": "-0479/-0478",
        "timespan": { "begin_of_the_begin": "-0479-01-01T00:00:00Z", "end_of_the_end": "-0478-12-31T23:59:59Z" } },
      "notes": "The era word applies to both numbers; 480 BCE comes first." },
    { "id": "bce-013", "input": "27 BC - AD 14", "tags": ["range", "era", "era-boundary"],
      "expect": { "status": "parsed", "canonical": "-0026/0014", "edtf": "-0026/0014",
        "timespan": { "begin_of_the_begin": "-0026-01-01T00:00:00Z", "end_of_the_end": "0014-12-31T23:59:59Z" } } },
    { "id": "bce-014", "input": "ca. 450 - 400 BC", "tags": ["range", "era", "circa", "shared-era"], "notes": "The hedge applies to the first bound; the era is shared by both.",
      "expect": { "status": "parsed", "canonical": "-0449~/-0399", "edtf": "-0449~/-0399", "flags": ["Approximate", "Bce"] } },
    { "id": "bce-015", "input": "4.5 billion years ago", "tags": ["deep-time"],
      "expect": { "status": "parsed", "canonical": "4.5 Ga ago", "edtf": "Y-4549997974/Y-4449997974",
        "timespan": { "begin_of_the_begin": "-4549997974-01-01T00:00:00Z", "end_of_the_end": "-4449997974-12-31T23:59:59Z" }, "flags": ["DeepTime"] },
      "notes": "4.5 Ga written to one decimal is 4.45-4.55 Ga; counted back from 2026." },
    { "id": "bce-016", "input": "66 million years ago", "tags": ["deep-time"],
      "expect": { "status": "parsed", "canonical": "66 Ma ago", "flags": ["DeepTime"] } },
    { "id": "bce-017", "input": "10,000 BP", "tags": ["deep-time", "bp"],
      "expect": { "status": "parsed", "canonical": "10000 years BP", "edtf": "-8050",
        "timespan": { "begin_of_the_begin": "-8050-01-01T00:00:00Z", "end_of_the_end": "-8050-12-31T23:59:59Z" }, "flags": ["DeepTime"] },
      "notes": "Written to the year, so no widening: 1950 - 10000 = -8050." },
    { "id": "bce-018", "input": "c. 10 ka BP", "tags": ["deep-time", "bp", "circa"],
      "expect": { "status": "parsed", "canonical": "10 ka BP~", "flags": ["DeepTime", "Approximate"],
        "timespan": { "begin_of_the_begin": "-8550-01-01T00:00:00Z", "end_of_the_end": "-7550-12-31T23:59:59Z" } } },
    { "id": "bce-019", "input": "Late Pleistocene", "tags": ["deep-time", "named-period"],
      "expect": { "status": "unparsed" },
      "notes": "A geological period name; resolved only when a period source for the geologic time scale is configured." },
    { "id": "bce-020", "input": "0 AD", "tags": ["year", "era", "year-zero"],
      "expect": { "status": "parsed", "canonical": "0000", "flags": ["Bce"] },
      "notes": "There is no year 0 in the proleptic Julian era convention; read as 1 BCE with a note." }
  ]
}
