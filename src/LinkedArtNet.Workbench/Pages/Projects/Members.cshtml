@page "/p/{dataset}/members"
@model MembersModel
@{ ViewData["Title"] = "Members"; }
<h1>Members of @Model.Project.Project.Name</h1>
<table>
    <thead><tr><th>Login</th><th>Role</th><th>Since</th><th></th></tr></thead>
    <tbody>
    @foreach (var m in Model.Members)
    {
        <tr>
            <td>@m.Login</td><td>@m.Role</td><td class="small muted">@m.AddedAt.ToString("yyyy-MM-dd")</td>
            <td><form method="post" asp-page-handler="Remove" class="inline"><input type="hidden" name="login" value="@m.Login" /><button type="submit" class="quiet">Remove</button></form></td>
        </tr>
    }
    </tbody>
</table>
<p class="small muted">Owners named in the configuration own every project and are not listed here.</p>
<form method="post" asp-page-handler="Add" class="card">
    <h2 style="margin-top:0">Add a member</h2>
    <div class="row">
        <div style="flex:2"><label for="login">GitHub login (or the name used at sign-in)</label><input type="text" id="login" name="login" required /></div>
        <div style="flex:1"><label for="role">Role</label>
            <select id="role" name="role">
                <option value="reviewer">reviewer: decides items, curates variants</option>
                <option value="operator">operator: also runs jobs and loads indexes</option>
                <option value="owner">owner: also manages members</option>
            </select></div>
    </div>
    <div class="actions"><button type="submit">Add</button></div>
</form>
