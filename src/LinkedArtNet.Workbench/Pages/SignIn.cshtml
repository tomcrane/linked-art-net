@page "/signin"
@model SignInModel
@{ ViewData["Title"] = "Sign in"; }
<h1>Sign in</h1>
@if (Model.Options.GitHubLoginConfigured)
{
    <form method="post" asp-page-handler="GitHub" class="card">
        <p>Sign in with the GitHub account that your project membership names.</p>
        <button type="submit">Sign in with GitHub</button>
    </form>
}
@if (Model.Options.AllowLocalSignIn)
{
    <form method="post" asp-page-handler="Local" class="card">
        <p class="muted small">Development sign-in: type a name. This is on because the configuration allows it; it is never on for a shared instance.</p>
        <label for="name">Name</label>
        <input type="text" id="name" name="name" required autofocus />
        <div class="actions"><button type="submit">Sign in</button></div>
    </form>
}
@if (!Model.Options.GitHubLoginConfigured && !Model.Options.AllowLocalSignIn)
{
    <p class="notice">No sign-in is configured. Set <code>Workbench:GitHub</code> or, for development, <code>Workbench:AllowLocalSignIn</code>.</p>
}
