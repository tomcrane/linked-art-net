@page "/p/{dataset}"
@model HomeModel
@{ ViewData["Title"] = Model.Project.Project.Name; }
<h1>@Model.Project.Project.Name <span class="tag">@Model.Role</span></h1>
@if (!string.IsNullOrWhiteSpace(Model.Project.Project.Description)) { <p class="muted">@Model.Project.Project.Description</p> }

<div class="grid">
    <div class="card">
        <h2 style="margin-top:0">Review queue</h2>
        @if (Model.Queue.Count == 0)
        {
            <p class="muted">Nothing waiting for review.</p>
        }
        else
        {
            <table class="counts">
                <thead><tr><th>Context</th><th>Queued</th><th></th></tr></thead>
                <tbody>
                @foreach (var row in Model.Queue)
                {
                    <tr><td>@row.Context</td><td>@row.Count</td><td><a href="/p/@Model.Dataset/review?context=@Uri.EscapeDataString(row.Context)">Review</a></td></tr>
                }
                <tr><th>All</th><th>@Model.Queue.Sum(r => r.Count)</th><td><a class="button" href="/p/@Model.Dataset/review">Start</a></td></tr>
                </tbody>
            </table>
        }
        <p class="small muted">Queued strings have a provisional entity meanwhile; a reviewer's decision replaces it. Minted strings (nothing found) can be reviewed too: <a href="/p/@Model.Dataset/review?method=minted">review minted</a>. Strings accepted by policy on one source's exact match (no rival, no dates to check) can be checked as a set: <a href="/p/@Model.Dataset/review?method=exact-single">review single-source acceptances</a>.</p>
    </div>
    <div class="card">
        <h2 style="margin-top:0">The store</h2>
        <dl class="facts">
            <dt>Entities</dt><dd>@Model.Counts.Entities.ToString("N0")</dd>
            <dt>Strings</dt><dd>@Model.Counts.SourceStrings.ToString("N0")</dd>
            <dt>Decided</dt><dd>@Model.Counts.Decided.ToString("N0")</dd>
            <dt>Unresolved</dt><dd>@Model.Counts.Unresolved.ToString("N0")</dd>
            <dt>Overrides</dt><dd>@Model.Counts.Overrides.ToString("N0")</dd>
            <dt>Runs</dt><dd>@Model.Counts.Runs.ToString("N0")</dd>
            <dt>Authority records</dt><dd>@Model.Counts.AuthorityRecords.ToString("N0") <span class="muted small">(shared across projects)</span></dd>
            <dt>Identifiers</dt><dd><code>@Model.Project.Project.IdentifierBase</code></dd>
        </dl>
        <p><a href="/p/@Model.Dataset/entities">Browse entities</a> · <a href="/p/@Model.Dataset/variants">Cluster variants</a> · <a href="/p/@Model.Dataset/export/overrides.json">Export overrides (pmc-lux JSON)</a>@if (Model.Can(ProjectRole.Owner)) { <text> · <a href="/p/@Model.Dataset/members">Members</a></text> }</p>
    </div>
</div>

@if (Model.Can(ProjectRole.Operator))
{
    <h2>Manifest</h2>
    <form method="post" asp-page-handler="Manifest" class="card">
        @if (Model.ManifestError is not null) { <p class="notice">@Model.ManifestError</p> }
        <p><strong>In effect now:</strong> @Model.RulesInEffect</p>
        <p class="small muted">The project's reading rules and thresholds, as JSON. <code>contexts</code> maps each field a string can come from to the classes it may name (person, group, place, type, material, language, period, event) and the agent-string profile that reads it (default, dscribe, marc, ulan, ead, wellcome); <code>sources</code> lists the local indexes to consult; the scores decide acceptance and review. A context not listed may name anything.</p>
        <textarea name="manifest" rows="18" style="font-family: ui-monospace, monospace; font-size: .85rem">@Model.ManifestJson</textarea>
        <div class="actions">
            <button type="submit">Save manifest</button>
            <button type="submit" asp-page-handler="PmcRules" class="secondary" title="Replace the saved manifest with the toolkit's current reading of the Paul Mellon Centre library's fields: persauthorfull a person; corpauthor and publisher a group or a person; place a qualified place or a list of them; keywords a compound LCSH heading with lcsh as its home vocabulary">Replace with the PMC library rules</button>
        </div>
        <p class="small muted">The PMC library rules are built into the toolkit and change as it grows; the button copies the current version over this project's saved manifest. The line above says whether the saved manifest still matches them.</p>
    </form>
}

<h2>Recent runs</h2>
@if (Model.Runs.Count == 0) { <p class="muted">No runs recorded for this project.</p> }
else
{
    <table>
        <thead><tr><th>Run</th><th>Started</th><th>Report</th></tr></thead>
        <tbody>
        @foreach (var run in Model.Runs)
        {
            <tr><td><code>@run.Id</code></td><td>@run.StartedAt.ToString("yyyy-MM-dd HH:mm")</td><td class="small">@(run.Report ?? (run.FinishedAt is null ? "running or interrupted" : ""))</td></tr>
        }
        </tbody>
    </table>
}
