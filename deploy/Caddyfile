# Caddy obtains and renews the certificates itself (Let's Encrypt), so the DNS records must point here before
# the first start. The service answers on its own host so its CORS-any-origin policy never applies to the site.

linkedart.net {
    encode zstd gzip
    reverse_proxy site:8080
}

www.linkedart.net {
    redir https://linkedart.net{uri} permanent
}

dates.linkedart.net {
    encode zstd gzip
    reverse_proxy dates:8080
}
