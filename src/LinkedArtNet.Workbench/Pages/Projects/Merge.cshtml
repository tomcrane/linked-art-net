@page "/p/{dataset}/merge"
@model MergeModel
@{
    ViewData["Title"] = "Compare and merge";
    var pair = Model.Rows.Count == 2;
    var suggested = Model.Rows.FirstOrDefault(r => r.Entity.Id == Model.Suggested)?.Entity;
}
@* the page compares before it merges (the owner, 2026-11-20: "this looks a bit clunky", of a table headed "Merge from the tray" reached
   from the duplicates check; and "the 'why' could be provided here"): each entity in its own panel with what tells it apart, and the
   two answers below, one thing or two *@
@if (Model.From == "duplicates") { <p class="small" style="margin:0"><a href="/p/@Model.Dataset/checks?check=duplicates">← Entities that may be one thing</a></p> }
<h1 style="margin-top:0">Compare and merge</h1>
@if (Model.Message is not null) { <p class="notice">@Model.Message</p> }
@if (Model.Rows.Count < 2)
{
    <p class="empty">@(Model.Rows.Count == 0 ? "The tray is empty, or its entities are not this project's: nothing to compare." : "Only one entity here: collect at least two with \"Add to tray\" on an entity's page, in the entities list or on the desk's cards.") <a href="/p/@Model.Dataset/entities">Entities</a></p>
}
else
{
    <p class="small muted">@(pair ? "Are these one thing or two?" : $"Are these {Model.Rows.Count} one thing?") Read what stands on each, open what you need, then answer below. Nothing changes until you press a button.</p>
    <form method="post" id="merge">
        <input type="hidden" name="ids" value="@Model.Ids" />
        <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(19rem, 1fr)); gap:1rem; align-items:start">
        @foreach (var r in Model.Rows)
        {
            var e = r.Entity;
            <div class="card" style="margin:0">
                <h2 style="margin:0 0 .25rem"><a href="/p/@Model.Dataset/entity?id=@Uri.EscapeDataString(e.Id)" target="_blank" rel="noopener" title="The entity's page, in a new tab">@(e.Label ?? e.Id)</a></h2>
                <p style="margin:.1rem 0"><span class="tag">@e.Class.ToString().ToLowerInvariant()</span> <span class="tag">@e.Status.ToString().ToLowerInvariant()</span>@if (r.Placement is not null) { <span class="muted"> @r.Placement</span> }@if (e.Lifespan?.Display is { } life) { <span class="muted"> @life</span> }</p>
                @if (e.Labels.Any(l => l != e.Label)) { <p class="small muted" style="margin:.1rem 0">also: @string.Join(" · ", e.Labels.Where(l => l != e.Label).Take(5))</p> }
                <p class="small" style="margin:.6rem 0 .2rem"><strong>What stands on it:</strong> @r.Strings.ToString("N0") string@(r.Strings == 1 ? "" : "s"), @r.Records.ToString("N0") record@(r.Records == 1 ? "" : "s")@(r.Queued > 0 ? $"; {r.Queued} of the strings still queued" : "")@(r.ByRecord > 0 ? $"; and {r.ByRecord} record{(r.ByRecord == 1 ? "" : "s")} decided onto it one by one" : "")</p>
                @if (r.Sample is { Count: > 0 })
                {
                    <ul class="small" style="margin:.1rem 0 .1rem 1.1rem; padding:0">
                    @foreach (var (str, n) in r.Sample) { <li><a href="/p/@Model.Dataset/review?id=@str.Id" target="_blank" rel="noopener" title="This string's card, with its records">@str.Raw</a> <span class="muted">· @Model.Project.Manifest.FieldName(str.Context) · @n.ToString("N0") record@(n == 1 ? "" : "s")</span></li> }
                    </ul>
                    @if (r.Strings > r.Sample.Count) { <p class="small muted" style="margin:.1rem 0">and @((r.Strings - r.Sample.Count).ToString("N0")) more, on its page</p> }
                }
                <p class="small" style="margin:.6rem 0 .2rem"><strong>Its identifiers:</strong>@(e.Equivalents.Count == 0 ? " none" : "")</p>
                @if (r.Identifiers is { Count: > 0 })
                {
                    <ul class="small" style="margin:.1rem 0 .1rem 1.1rem; padding:0">
                    @* an identifier that describes something else is left out here, before it travels (the owner, 2026-11-24: he had to go to
                       the wrong entity's own page to remove a dead identifier and an American place's, then find the right entity again).
                       A tick is "it goes with the merge", every box ticked as the page opens; unticked, the line is struck through and says it is
                       left out (the owner, the same day, of the first form, where a tick left one out: "The checkboxes feel the wrong way
                       round, they should be checked if the entity is to be included in the merge. On unchecking, the text should be crossed out") *@
                    @foreach (var (q, says) in r.Identifiers) { <li style="list-style:none; margin-left:-1.1rem"><label style="text-transform:none; letter-spacing:normal; font-size:inherit; font-weight:400; color:inherit; margin:0" title="Ticked, this identifier goes with the merge. Untick it to leave it out: it is taken off this entity and does not go to the one kept"><input type="hidden" name="shown" value="@q.Uri" /><input type="checkbox" name="bring" value="@q.Uri" data-leave checked /> <a class="tag src" href="@q.Uri" target="_blank" rel="noopener" title="@q.Uri">@q.Source</a> <span data-leave-what>@(says ?? q.Uri.TrimEnd('/').Split('/').Last() + " · the store has no record of it")</span> <span class="muted" data-leave-says></span></label></li> }
                    </ul>
                    @if (e.Equivalents.Count > r.Identifiers.Count) { <p class="small muted" style="margin:.1rem 0">and @(e.Equivalents.Count - r.Identifiers.Count) more</p> }
                }
                <p style="margin:.75rem 0 0"><label style="text-transform:none; letter-spacing:normal; font-size:1rem; font-weight:400; color:inherit"><input type="radio" name="survivor" value="@e.Id" checked="@(e.Id == Model.Suggested)" /> If they are one thing, <strong>keep this one</strong></label></p>
                @if (Model.Rows.Count > 2) { <p class="small" style="margin:.3rem 0 0"><a href="/p/@Model.Dataset/merge?ids=@Uri.EscapeDataString(string.Join(",", Model.Rows.Where(x => x.Entity.Id != e.Id).Select(x => x.Entity.Id)))@(Model.From is null ? "" : "&from=" + Model.From)">take it out of the comparison</a></p> }
            </div>
        }
        </div>

        <div class="card" style="margin-top:1rem">
            <h3 style="margin-top:0">They are one thing</h3>
            <p class="small muted" style="margin-top:0">The @(pair ? "other merges" : "others merge") into the one kept: strings, labels and identifiers follow, and the old @(pair ? "id keeps" : "ids keep") resolving to it. An identifier that describes something else, or leads nowhere, should not follow: untick it above and it is left out. The one suggested has the most strings, then the firmer status, then the more identifiers.</p>
            <p class="small" id="leave-says" style="margin:.2rem 0 .6rem"></p>
            <div class="row" style="gap:.6rem; align-items:center; flex-wrap:wrap">
                <label class="small" for="label">Label after the merge</label>
                <input type="text" id="label" name="label" value="@suggested?.Label" style="flex:1; min-width:14rem" title="The kept entity's label unless you write another; every other label is kept as a variant" />
                @if (Model.ClassesDiffer)
                {
                    <label class="small" for="cls">as a</label>
                    <select name="cls" id="cls" title="The entities differ in kind: the merged entity's kind">
                        @foreach (var c in Model.Rows.Select(r => r.Entity.Class).Distinct()) { <option value="@c" selected="@(c == suggested?.Class)">@c.ToString().ToLowerInvariant()</option> }
                    </select>
                }
                <button type="submit" style="white-space:nowrap">Merge into the one kept</button>
            </div>
        </div>
    </form>
    @* the right one is not here: found and brought in, without leaving the page (the owner, 2026-11-24) *@
    <form method="get" class="card" style="margin-top:1rem" data-keep-place>
        <input type="hidden" name="ids" value="@Model.Ids" />
        @if (Model.From is not null) { <input type="hidden" name="from" value="@Model.From" /> }
        <h3 style="margin-top:0">The one it should merge with is not here</h3>
        <div class="row" style="gap:.6rem; align-items:center; flex-wrap:wrap">
            <label class="small" for="q">Find another of the project's entities</label>
            <input type="text" id="q" name="q" value="@Model.Q" placeholder="a name" style="flex:1; min-width:14rem" />
            <button type="submit" class="secondary" style="white-space:nowrap">Search</button>
        </div>
        @if (!string.IsNullOrWhiteSpace(Model.Q) && Model.Found.Count == 0) { <p class="small muted">Nothing else of that name in the project.</p> }
        @foreach (var (fe, where, n) in Model.Found)
        {
            <p class="small" style="margin:.4rem 0 0"><a class="button secondary small" href="/p/@Model.Dataset/merge?ids=@Uri.EscapeDataString(Model.Ids + "," + fe.Id)@(Model.From is null ? "" : "&from=" + Model.From)">Add to the comparison</a> <strong>@(fe.Label ?? fe.Id)</strong> <span class="tag">@fe.Class.ToString().ToLowerInvariant()</span> <span class="tag">@fe.Status.ToString().ToLowerInvariant()</span> <span class="muted">@where · @string.Join(" ", fe.Equivalents.Select(q => q.Source).Distinct()) · stands for @n string@(n == 1 ? "" : "s")</span></p>
        }
    </form>
    <script>
    (function () {
        var form = document.getElementById("merge"); if (!form) return;
        function update() {
            var out = 0;
            form.querySelectorAll("input[data-leave]").forEach(function (c) {
                var line = c.closest("label"), what = line.querySelector("[data-leave-what]"), says = line.querySelector("[data-leave-says]");
                if (what) what.style.textDecoration = c.checked ? "" : "line-through";
                if (says) says.textContent = c.checked ? "" : "· left out of the merge";
                if (!c.checked) out++;
            });
            var line = document.getElementById("leave-says");
            if (line) line.textContent = out === 0 ? "Every identifier shown above goes to the one kept." : out + " identifier" + (out === 1 ? " is" : "s are") + " left out; the rest go to the one kept.";
        }
        form.addEventListener("change", function (e) { if (e.target && e.target.hasAttribute && e.target.hasAttribute("data-leave")) update(); });
        update();
    })();
    </script>
    @if (pair)
    {
        <form method="post" asp-page-handler="TwoThings" class="card" style="margin-top:1rem">
            <input type="hidden" name="ids" value="@Model.Ids" />
            <h3 style="margin-top:0">They are two things</h3>
            <p class="small muted" style="margin-top:0">Each is noted as not the other, and the pair leaves the check's list. Say why if it will help the next person: a gallery in two cities, a body and its building, an earlier firm and its successor.</p>
            <div class="row" style="gap:.6rem; align-items:center; flex-wrap:wrap">
                <label class="small" for="why">Why (optional)</label>
                <input type="text" id="why" name="why" style="flex:1; min-width:14rem" />
                <button type="submit" class="secondary" style="white-space:nowrap">Two things</button>
            </div>
        </form>
    }
}
