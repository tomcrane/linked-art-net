<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] is string t ? t + " · " : "")Alignment workbench</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;700;800&display=swap" />
    <link rel="stylesheet" href="~/site.css" asp-append-version="true" />
</head>
<body>
<header class="top">
    <a class="brand" href="/">Alignment workbench</a>
    <nav>
        <a href="/">Projects</a>
        @if (ViewData["Dataset"] is string ds)
        {
            <span class="project-group" title="These pages show this project's own strings, entities and decisions. The authority indexes (ULAN, LoC) are shared by every project and are consulted from inside them.">
                <a class="project-name" href="/p/@ds">@(ViewData["ProjectName"] ?? ds)</a>
                <a href="/p/@ds/review">String review</a>
                <a href="/p/@ds/entities">Entities</a>
                <a href="/p/@ds/variants">Variants</a>
                <a href="/p/@ds/checks">Checks</a>
                <a href="/p/@ds/findings" title="Things a source record could say better, for the cataloguers">For cataloguers</a>
                @* the project's search, where the hand goes for it (the owner, 2026-11-19); "/" reaches it from anywhere on the page *@
                <form method="get" action="/p/@ds/search" class="nav-search" role="search"><input type="search" name="q" id="project-search" placeholder="Search @(ViewData["ProjectName"] ?? ds)" aria-label="Search this project: strings, entities and records" title="Search this project's strings, entities and records. Press / to come here" /></form>
            </span>
        }
        <a href="/help">Help</a>
    </nav>
    <div class="who">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <span>@User.Identity.Name</span>
            <form method="post" action="/signout" class="inline">@Html.AntiForgeryToken()<button type="submit" class="link">Sign out</button></form>
        }
        else
        {
            <a href="/signin">Sign in</a>
        }
    </div>
</header>
<main data-keep-place="@(ViewData["KeepPlace"] is true ? "page" : null)">
    @RenderBody()
</main>
@if (ViewData["Dataset"] is string trayDs)
{
    @* the tray (doc 12 section 13, item 2): entities collected across pages for one merge, held in this browser; wwwroot/tray.js fills it *@
    <div id="tray" class="tray" data-dataset="@trayDs" hidden></div>
    <script src="~/tray.js" asp-append-version="true"></script>
}
<footer>
    <p>Part of <a href="https://github.com/tomcrane/linked-art-net">linked-art-net</a>. Authority data: Getty ULAN, AAT and TGN under ODC-By; Library of Congress Name Authority File.</p>
</footer>
@await RenderSectionAsync("Scripts", required: false)
<script>
// A search or a small action that reloads the page it is on keeps the reader's place (the owner, 2026-11-19: searching under "Something
// else" at the desk "submits the page and the reload loses your position as you are back at the page head and have to scroll down").
// A form or a link marked data-keep-place, or inside something so marked, notes how far down the page was; the next page, if it is the
// same page about the same thing, opens there. An action that moves on to another card or entity is not marked and opens at the top.
(function () {
    var KEY = "keep-place";
    function about(url) { var q = new URL(url, location.href).searchParams; return q.get("id") || q.get("mend") || ""; }
    function note() { try { sessionStorage.setItem(KEY, JSON.stringify({ path: location.pathname, about: about(location.href), y: window.scrollY })); } catch (e) { } }
    document.addEventListener("submit", function (e) { if (e.target.closest && e.target.closest("[data-keep-place]")) note(); }, true);
    document.addEventListener("click", function (e) { var a = e.target.closest && e.target.closest("a[href]"); if (a && a.closest("[data-keep-place]") && a.target !== "_blank") note(); }, true);
    var kept = null;
    try { kept = JSON.parse(sessionStorage.getItem(KEY) || "null"); sessionStorage.removeItem(KEY); } catch (e) { }
    // a page that opens with the word of an action just done opens at its top, where that word is: the browser otherwise brought the
    // next card up as far down as the last one had been left, the message out of sight (seen as a user at every decision, 2026-11-23)
    function top() {
        if (location.hash || !document.querySelector("[data-flash]")) return;
        try { history.scrollRestoration = "manual"; } catch (e) { }
        function up() { window.scrollTo(0, 0); }
        up(); setTimeout(up, 150); window.addEventListener("load", up);
    }
    var here = about(location.href);
    if (!kept || kept.path !== location.pathname || (kept.about && here && kept.about !== here) || (kept.about && !here)) { document.addEventListener("DOMContentLoaded", top); return; }
    function go() { window.scrollTo(0, kept.y); }
    document.addEventListener("DOMContentLoaded", function () { go(); setTimeout(go, 150); });
})();
document.addEventListener("keydown", function (e) {
    if (e.key !== "/" || e.ctrlKey || e.metaKey || e.altKey) return;
    var t = e.target, tag = t && t.tagName;
    if (tag === "INPUT" || tag === "TEXTAREA" || tag === "SELECT" || (t && t.isContentEditable)) return;
    var box = document.getElementById("project-search");
    if (box) { e.preventDefault(); box.focus(); box.select(); }
});
</script>
</body>
</html>
